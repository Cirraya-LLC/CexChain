; SPDX-License-Identifier: Apache-2.0
; Copyright 2026 Cirraya
;
; The CexChain protocol (RFC 8610 CDDL). Specification revision v0.3; the
; wire protocol version (statement key 0) is 1.
;
; Revision history:
;   v0.1  statements, the log, checkpoints, receipts, evidence bundles
;   v0.2  cosign requests for witnesses; proof of presence (statement key 8,
;         actor-set-presence, scope key 6) with passkeys or hardware keys;
;         state commitments in the log (log entry key 4, bundle key 7). v0.1
;         objects remain valid.
;   v0.3  access across organizations: the access-request, access-grant, and
;         access-receipt record types and their metadata, and deliveries.
;         Earlier objects remain valid.
;
; Every structure is encoded as deterministic CBOR (RFC 8949 section 4.2.1) in
; the CexChain profile: no floats, no indefinite lengths, no duplicate keys.
; Signed objects are tagged COSE_Sign1 messages (RFC 9052) in the strict
; CexChain profile. Unknown map keys are rejected.

; ---------------------------------------------------------------------------
; Common types
; ---------------------------------------------------------------------------

; A digest under the ledger's hash algorithm. Ledgers use SHA-256 (-16)
; or SM3 (-65538), so identifiers are 32 bytes.
id = bstr .size 32

; Unix time in milliseconds.
timestamp = uint

; A public key: COSE algorithm identifier and the key in its wire encoding
; (Ed25519: 32 bytes; ESP256 and SM2: uncompressed SEC 1 point; ML-DSA: FIPS 204).
public-key = [alg: int, key: bstr]

; Key identifier, used as the COSE kid (label 4) of anything the key signs:
;   kid = HASH(deterministic-CBOR(public-key)) under the ledger's hash algorithm.
kid = id

; ---------------------------------------------------------------------------
; Statements: what actors submit to a ledger
; ---------------------------------------------------------------------------
;
; A signed statement is a COSE_Sign1 with protected header
;   { 1: alg, 3: "application/cexchain-statement+cbor", 4: kid }
; and an empty unprotected header. Its payload is a statement-payload.
;
; statement_id = HASH(Sig_structure), the hash of exactly the bytes that were
; signed (RFC 9052 section 4.4, with empty external_aad). It never depends on
; signature bytes.

statement-payload = {
  0 => 1,                      ; protocol version
  1 => statement-type,
  ? 2 => id,                   ; ledger_id: absent only in genesis
  ? 3 => id,                   ; actor_id of the signer: absent only in genesis
  ? 4 => id,                   ; delegation_id authorizing this statement
  5 => timestamp,              ; issued_at, as claimed by the signer
  6 => bstr .size 16,          ; nonce; a ledger accepts each (actor, nonce)
                               ; once, so a payload cannot be replayed even
                               ; re-signed with a rotated key
  7 => statement-body,
  ? 8 => presence-proof,       ; a person's proof of presence (see below)
  ? 9 => provenance,           ; for AI agents
}

statement-type = &(
  genesis: 1,
  actor-register: 2,
  actor-rotate-key: 3,
  actor-revoke: 4,
  delegation-grant: 5,
  delegation-revoke: 6,
  actor-set-presence: 7,
  record-register: 16,
  record-endorse: 17,
  record-transition: 18,
  record-revoke: 19,
)

statement-body = genesis-body / actor-register-body / actor-rotate-key-body /
                 actor-revoke-body / delegation-grant-body / delegation-revoke-body /
                 actor-set-presence-body / record-register-body / record-endorse-body /
                 record-transition-body / record-revoke-body

; Genesis creates the ledger. It is signed by the organization root key, and
;   ledger_id = statement_id of the genesis statement.
; The genesis statement also registers the organization actor, whose
; actor_id is the ledger_id.
genesis-body = {
  1 => -16 / -65538,           ; the ledger's hash algorithm: SHA-256 or SM3
  2 => tstr,                   ; organization name
  3 => public-key,             ; organization root key
  4 => public-key,             ; log key: signs checkpoints and receipts
}

actor-register-body = {
  1 => actor-kind,
  2 => tstr,                   ; display name
  3 => public-key,             ; signing key
  ? 4 => id,                   ; responsible person: required for agents
  ? 5 => agent-profile,        ; agents only
}
actor-kind = &(person: 1, agent: 2, device: 3)
agent-profile = {
  ? 1 => tstr,                 ; model
  ? 2 => tstr,                 ; model version
  ? 3 => tstr,                 ; runtime
}

; An actor may rotate its own key without a delegation; a person with
; presence credentials must then prove presence.
actor-rotate-key-body = {
  1 => id,                     ; actor
  2 => public-key,             ; new signing key
}

actor-revoke-body = {
  1 => id,                     ; actor
  ? 2 => tstr,                 ; reason
}

delegation-grant-body = {
  1 => id,                     ; grantee actor
  2 => scope,
}
; A delegation may only narrow the grantor's own scope. A chain from the
; organization to an actor has at most 16 delegations.
scope = {
  1 => [+ statement-type],     ; statement types the grantee may submit
  ? 2 => [+ tstr],             ; record types; absent means any
  ? 3 => timestamp,            ; not before
  ? 4 => timestamp,            ; not after
  ? 5 => bool,                 ; may delegate further; encoded only when true
  ? 6 => bool,                 ; statements under it must carry proof of
                               ; presence; encoded only when true. A
                               ; delegation granted under one that requires
                               ; presence must require it too.
}

; Proof of human presence (machine by default: a statement without it shows
; only that the signer's key was used). A person registers credentials:
; WebAuthn passkeys and security keys, or hardware keys such as USB keys
; (UKey) and smart cards, which sign with a key that never leaves the device
; and only after the person enters its PIN. actor-set-presence replaces them.
; It may be submitted by the organization, by an actor whose delegation
; covers it, or by the person themselves only if the statement carries proof
; of presence with a credential already registered, so that a stolen signing
; key alone cannot enroll a thief's passkey. Only people have credentials.
actor-set-presence-body = {
  1 => id,                     ; actor (a person)
  2 => [* presence-credential], ; at most 16, unique credential ids
}
presence-credential = webauthn-credential / hardware-key-credential
webauthn-credential = {
  1 => tstr,                   ; WebAuthn relying party id, 1-253 chars
  2 => bstr,                   ; credential id, 1-1023 bytes
  3 => public-key,             ; ESP256 (WebAuthn ES256) or Ed25519 (EdDSA)
  ? 4 => tstr,                 ; label
}
hardware-key-credential = {
  2 => bstr,                   ; credential id, 1-1023 bytes; CexChain's CLI
                               ; uses SHA-256 of the encoded public key
  3 => public-key,             ; any algorithm, SM2 among them
  ? 4 => tstr,                 ; label
  5 => 2,                      ; presence method: hardware key (absent, and
                               ; never encoded, for WebAuthn)
}

; A proof of presence approves exactly one statement, signed with exactly one
; key. Its challenge is
;   HASH("CexChain presence v1" || kid || P)
; where HASH is the ledger hash, kid is the statement's COSE kid (32 bytes),
; and P is the statement payload encoded without key 8. (Binding the kid
; stops a proof being reused by re-signing the payload with a rotated key.)
;
; With a WebAuthn credential, the proof is an assertion over the challenge.
; Verifiers check, for the signer's credential with this id:
;   1. authenticatorData begins with SHA-256(rp id) and has the user-present
;      flag (0x01); the user-verified flag (0x04) is reported, not required;
;   2. clientDataJSON begins with
;        {"type":"webauthn.get","challenge":"<base64url challenge>","origin":"
;      followed by an origin without quotes or backslashes that belongs to
;      the rp id (https and the id or a subdomain; http or https for
;      "localhost"), then '"' and either "}" or ',"crossOrigin":false'
;      (WebAuthn Level 3, limited verification algorithm), and ends with "}";
;   3. the signature verifies over authenticatorData || SHA-256(clientDataJSON):
;      DER ECDSA for ES256 (either S), raw for Ed25519.
;
; With a hardware-key credential, the proof has no keys 2 and 3, and the
; signature is the credential key's signature over the challenge itself, in
; CexChain's format for the key's algorithm (as in COSE_Sign1).
presence-proof = {
  1 => bstr,                   ; credential id
  ? (
    2 => bstr,                 ; authenticatorData, 37-4096 bytes
    3 => bstr,                 ; clientDataJSON, 1-4096 bytes
  ),                           ; both for WebAuthn, neither for hardware keys
  4 => bstr,                   ; signature, 1-8192 bytes
}

delegation-revoke-body = {
  1 => id,                     ; delegation (statement_id of its grant)
  ? 2 => tstr,                 ; reason
}

record-register-body = {
  1 => tstr,                   ; record type, e.g. "cexchain.certificate/1"
  2 => bstr,                   ; field commitment root (see record-field)
  3 => uint,                   ; number of fields
  ? 4 => [+ attachment],
  ? 5 => { + tstr => any },    ; public metadata, disclosed in the clear
}
; Fields are committed individually so they can be disclosed selectively:
;   leaf = deterministic-CBOR(record-field), leaves sorted by field name,
;   root = RFC 9162 Merkle tree hash over the leaves (the ledger's hash).
record-field = [name: tstr, salt: bstr .size 16, value: any]
attachment = [
  name: tstr,
  media-type: tstr,
  size: uint,
  commitment: bstr,            ; HASH(salt || content), salt 16 bytes
]

record-endorse-body = {
  1 => id,                     ; record (statement_id of its registration)
  2 => tstr,                   ; role, e.g. "inspector", "receiver"
}

record-transition-body = {
  1 => id,                     ; record
  2 => tstr,                   ; from state
  3 => tstr,                   ; to state
}

record-revoke-body = {
  1 => id,                     ; record
  ? 2 => tstr,                 ; reason
}

provenance = {
  ? 1 => tstr,                 ; model
  ? 2 => tstr,                 ; model version
  ? 3 => bstr,                 ; commitment to the inputs the agent acted on
  ? 4 => [+ tool-pin],         ; tools and skills used, pinned by digest
}
tool-pin = [name: tstr, digest: bstr]

; ---------------------------------------------------------------------------
; Log
; ---------------------------------------------------------------------------
;
; Each registered statement becomes one log entry. The ledger's Merkle tree
; (RFC 9162, ledger hash) commits to the encoded log entries in order.

; A log entry holds a statement, or (key 4 instead of 3) a state commitment
; the ledger appended when checkpointing. Exactly one of 3 and 4 is present.
log-entry = {
  1 => id,                     ; statement_id: HASH(Sig_structure) of the
                               ; statement or of the state commitment
  2 => timestamp,              ; registered_at, by the ledger clock
  ? 3 => bstr,                 ; the signed statement (COSE_Sign1) as submitted
  ? 4 => bstr,                 ; a signed state commitment (COSE_Sign1)
}

; A state commitment is a COSE_Sign1 by the log key with protected header
;   { 1: alg, 3: "application/cexchain-state+cbor", 4: kid }
; over a state-commitment-payload. When it checkpoints, the ledger first
; appends a commitment to the state after every entry so far (unless the last
; entry already is one), then signs a checkpoint that covers it. Being in the
; log, a commitment is witnessed like any entry and can never be withdrawn.
; Replaying the log checks every commitment: signed by the log key, for this
; ledger and tree hash, tree size equal to its own index, and state root equal
; to the root of the replayed state (see state-leaf).
state-commitment-payload = {
  1 => id,                     ; ledger_id
  2 => -16 / -65538,           ; tree hash algorithm
  3 => uint .ge 1,             ; tree size: the entries before it (its index)
  4 => bstr,                   ; state root
  5 => timestamp,
}

; A checkpoint is a COSE_Sign1 by the log key with protected header
;   { 1: alg, 3: "application/cexchain-checkpoint+cbor", 4: kid }
; over a checkpoint-payload. It binds the tree size and root together.
; A witness cosignature is a COSE_Sign1 by the witness key over the same
; payload bytes, with content type "application/cexchain-cosignature+cbor",
; so the two can never be confused.
checkpoint-payload = {
  1 => id,                     ; ledger_id
  2 => -16 / -65538,           ; tree hash algorithm
  3 => uint .ge 1,             ; tree size (genesis is always in the log)
  4 => bstr,                   ; root hash
  5 => timestamp,
}

; What a ledger operator sends a witness. The witness keeps, per ledger, the
; ledger id, the log key (learned out of band), and the size and root it last
; cosigned. It cosigns only if:
;   1. the checkpoint is for that ledger and signed by its log key;
;   2. its tree hash equals the one in earlier checkpoints;
;   3. old size equals the size the witness last cosigned (otherwise it
;      refuses, and the operator retries from that size);
;   4. the tree size is not smaller than old size; and
;   5. the RFC 9162 consistency proof shows that the new tree extends the
;      tree the witness last cosigned (empty from size 0; equal sizes need
;      equal roots).
; Since state commitments are log entries, consistency also covers them: a
; ledger cannot show two states for one history.
cosign-request = {
  1 => bstr,                   ; the signed checkpoint (COSE_Sign1)
  2 => uint,                   ; old size
  3 => [* bstr],               ; consistency proof, at most 65 hashes
}

; A receipt is an RFC 9942 inclusion receipt:
;   protected   { 1: alg, 4: kid, 395: vds }
;   unprotected { 396: { -1: [ bstr .cbor inclusion-proof ] } }
;   payload     nil (detached; it is the Merkle root at tree-size)
; vds is 1 (RFC9162_SHA256) for SHA-256 ledgers and -65537 (CexChain private
; use: RFC 9162 tree with SM3) for SM3 ledgers. The candidate entry is the
; encoded log-entry.
inclusion-proof = [
  tree-size: uint,
  leaf-index: uint,
  inclusion-path: [* bstr],    ; RFC 9942 says [+ bstr]; empty for a one-entry tree
]

; ---------------------------------------------------------------------------
; Evidence bundles
; ---------------------------------------------------------------------------
;
; Everything needed to verify a record offline, without contacting or
; trusting the ledger's database. A verifier:
;   1. takes the ledger's identity, hash, and keys from the genesis entry;
;   2. verifies the checkpoint with the log key;
;   3. verifies each entry's receipt against the checkpoint (same tree size
;      and root), with entries strictly ascending from index 0;
;   4. replays the included statements under the ledger rules;
;   5. checks field disclosures against the record's field root and count,
;      and attachment contents against their commitments;
;   6. verifies cosignatures by witnesses it trusts;
;   7. if the last entry the checkpoint covers is a state commitment (and
;      the bundle includes it, with its receipt): checks it as replay would
;      (log key, ledger, tree hash, its own index), verifies every state
;      proof against its state root (at most one per object), and for the
;      record and each object involved in its events (the signer, an agent
;      signer's accountable person, and every delegation in the chain with
;      its grantor) requires a proof whose leaf equals that object's leaf in
;      the replayed state. Then nothing was omitted: the report is complete.
;      Without that commitment, a bundle cannot rule out omissions (such as
;      a later revocation).

; The state commitment: a compact sparse Merkle tree over every actor,
; delegation, and record, keyed by object id (its 256 bits, most significant
; first), with HASH the ledger hash:
;   empty subtree           HASH("")
;   subtree of one object   HASH(0x00 || state-leaf)
;   any other subtree       HASH(0x01 || left || right)
; A leaf lists every log index that created or changed the object, as of the
; commitment: for actors registration, key rotations, passkey changes, and
; revocation; for delegations grant and revocation; for records every
; statement about them. The organization's leaf is [1, ledger_id, [0]].
state-leaf = [
  kind: 1 / 2 / 3,             ; actor, delegation, record
  id,
  history: [+ uint],           ; strictly ascending
]
; A proof lists the sibling hashes from the root down to the leaf; the
; verifier folds them bottom-up, taking the leaf's position from the id bits.
state-proof = [state-leaf, siblings: [* bstr]]   ; at most 256 siblings

evidence-bundle = {
  0 => 1,                      ; bundle format version
  1 => id,                     ; the record (statement_id of its registration)
  2 => [+ evidence-entry],     ; ascending log index, starting with genesis
  3 => bstr,                   ; the signed checkpoint the receipts lead to
  ? 4 => [+ bstr],             ; witness cosignatures on that checkpoint
  ? 5 => [+ field-disclosure],
  ? 6 => [+ attachment-opening],
  ? 7 => [+ state-proof],      ; required when the bundle includes the state
                               ; commitment its checkpoint ends with
}
evidence-entry = [
  entry: bstr,                 ; encoded log-entry
  receipt: bstr,               ; its RFC 9942 receipt
]
field-disclosure = [
  leaf: bstr,                  ; encoded record-field
  index: uint,                 ; its position among the sorted fields
  path: [* bstr],              ; RFC 9162 inclusion path
]
attachment-opening = [
  name: tstr,
  salt: bstr .size 16,         ; the content travels alongside the bundle
]

; ---------------------------------------------------------------------------
; Access across organizations (v0.3)
; ---------------------------------------------------------------------------

; Each step is a record (record-register-body) on the acting organization's
; own ledger, with these built-in types and public metadata (key 5). The
; other organization checks it with an evidence bundle, verified against the
; peer's ledger id, which it learned out of band. Delegations decide who may
; act, through record types; presence shows when a person approved.
;
;   cexchain.access-request/1  on the requester's ledger; initial state
;                              "requested", which may become "withdrawn"
;   cexchain.access-grant/1    on the granter's ledger; initial state
;                              "granted"; revoking the record ends it
;   cexchain.access-receipt/1  on the requester's ledger; state "received"
;
; Parties refuse metadata with other keys. Requests, grants, and receipts
; must be live (in their initial state, not revoked) and their evidence
; complete (proven against the state commitment).
access-request = {
  "ledger" => bstr .size 32,      ; the ledger asked
  "record" => bstr .size 32,      ; the record wanted there
  "purpose" => tstr,              ; non-empty
  "until" => uint,                ; access wanted until (ms), > 0
  "recipient" => bstr .size 32,   ; X25519 key deliveries are sealed to; one
                                  ; per request
  ? "fields" => [* tstr],         ; wanted fields; absent: all (unique names)
  ? "attachments" => [* tstr],    ; wanted attachments; absent: all
}
access-grant = {
  "ledger" => bstr .size 32,      ; the requester's ledger
  "request" => bstr .size 32,     ; the request record there
  "record" => bstr .size 32,      ; the record granted, on this ledger
  "fields" => [* tstr],           ; granted fields (unique names)
  "attachments" => [* tstr],      ; granted attachments
  "until" => uint,                ; > 0; the requester refuses it afterwards
  "recipient" => bstr .size 32,   ; the request's recipient key
}
access-receipt = {
  "ledger" => bstr .size 32,      ; the granter's ledger
  "grant" => bstr .size 32,       ; the grant record there
  "delivery" => bstr .size 32,    ; SHA-256 of the delivery received
}

; What the granter sends. The contents are sealed with HPKE (RFC 9180, base
; mode: DHKEM(X25519, HKDF-SHA256), HKDF-SHA256, AES-256-GCM) to the
; grant's recipient key, with info "CexChain delivery v1" and the grant
; record's id as additional authenticated data.
delivery = {
  1 => 1,                         ; version
  2 => bstr,                      ; the grant's evidence bundle
  3 => {
    1 => bstr,                    ; HPKE encapsulated key
    2 => bstr,                    ; ciphertext of delivery-contents
  },
}
delivery-contents = {
  1 => bstr,                      ; the granted record's evidence bundle, with
                                  ; the granted field disclosures and
                                  ; attachment openings only
  ? 2 => { + tstr => bstr },      ; granted attachments' contents, by name
}
; The recipient accepts a delivery only if: the grant verifies for the
; granter's ledger and names the recipient's ledger, its request, and its
; key; the contents open with that key; the record bundle verifies for the
; granter's ledger, is the granted record, and discloses nothing beyond the
; grant; and every attachment content matches its commitment.

