; SPDX-License-Identifier: Apache-2.0
; Copyright 2026 Cirraya
;
; The CexChain protocol (RFC 8610 CDDL). Specification revision v0.7 (draft); the
; wire protocol version (statement key 0) is 1.
;
; Revision history:
;   v0.1  statements, the log, checkpoints, receipts, evidence bundles
;   v0.2  cosign requests for witnesses; proof of presence (statement key 8,
;         actor-set-presence, scope key 6) with passkeys or hardware keys;
;         state commitments in the log (log entry key 4, bundle key 7). v0.1
;         objects remain valid.
;   v0.3  access across organizations: the access-request, access-grant, and
;         access-receipt record types and their metadata, and deliveries.
;         Earlier objects remain valid.
;   v0.4  key rotation: ledger-rotate-log-key (statement type 8), the
;         organization's root key rotated with actor-rotate-key, the log key
;         in effect by tree size, and key rotations in cosign requests (key
;         4). Tightened rules: presence keys are second keys, and changing
;         your own key or credentials needs a user-verified proof. Earlier
;         objects remain valid; a log that breaks the tightened rules does
;         not.
;   v0.5  ownership assets: asset-action (statement type 20), the
;         receivable, warehouse-receipt, and asset-consent record types and
;         their metadata, and asset evidence. Earlier objects remain valid.
;   v0.6  contracts (draft): contract-deploy, contract-call, and
;         contract-retire (statement types 21 to 23), scope key 7, state
;         leaves for contracts and instances, the contract input and output,
;         the contract-consent record type, and contract evidence. Earlier
;         objects remain valid.
;   v0.7  instances created by a call (draft): accept key 6 creates up to 16
;         children, identified by child-id-input; instance-view key 6 for a
;         call on a child; at most 8 generations; a child's state leaf and
;         contract evidence with its ancestors' histories. Earlier objects
;         remain valid.
;
; Every structure is encoded as deterministic CBOR (RFC 8949 section 4.2.1) in
; the CexChain profile: no floats, no indefinite lengths, no duplicate keys.
; Signed objects are tagged COSE_Sign1 messages (RFC 9052) in the strict
; CexChain profile. Unknown map keys are rejected.

; ---------------------------------------------------------------------------
; Common types
; ---------------------------------------------------------------------------

; A digest under the ledger's hash algorithm. Ledgers use SHA-256 (-16)
; or SM3 (-65538), so identifiers are 32 bytes.
id = bstr .size 32

; Unix time in milliseconds.
timestamp = uint

; A public key: COSE algorithm identifier and the key in its wire encoding
; (Ed25519: 32 bytes; ESP256 and SM2: uncompressed SEC 1 point; ML-DSA: FIPS 204).
public-key = [alg: int, key: bstr]

; Key identifier, used as the COSE kid (label 4) of anything the key signs:
;   kid = HASH(deterministic-CBOR(public-key)) under the ledger's hash algorithm.
kid = id

; ---------------------------------------------------------------------------
; Statements: what actors submit to a ledger
; ---------------------------------------------------------------------------
;
; A signed statement is a COSE_Sign1 with protected header
;   { 1: alg, 3: "application/cexchain-statement+cbor", 4: kid }
; and an empty unprotected header. Its payload is a statement-payload.
;
; statement_id = HASH(Sig_structure), the hash of exactly the bytes that were
; signed (RFC 9052 section 4.4, with empty external_aad). It never depends on
; signature bytes.

statement-payload = {
  0 => 1,                      ; protocol version
  1 => statement-type,
  ? 2 => id,                   ; ledger_id: absent only in genesis
  ? 3 => id,                   ; actor_id of the signer: absent only in genesis
  ? 4 => id,                   ; delegation_id authorizing this statement
  5 => timestamp,              ; issued_at, as claimed by the signer
  6 => bstr .size 16,          ; nonce; a ledger accepts each (actor, nonce)
                               ; once, so a payload cannot be replayed even
                               ; re-signed with a rotated key
  7 => statement-body,
  ? 8 => presence-proof,       ; a person's proof of presence (see below)
  ? 9 => provenance,           ; for AI agents
}

statement-type = &(
  genesis: 1,
  actor-register: 2,
  actor-rotate-key: 3,
  actor-revoke: 4,
  delegation-grant: 5,
  delegation-revoke: 6,
  actor-set-presence: 7,
  ledger-rotate-log-key: 8,
  record-register: 16,
  record-endorse: 17,
  record-transition: 18,
  record-revoke: 19,
  asset-action: 20,
  contract-deploy: 21,
  contract-call: 22,
  contract-retire: 23,
)

statement-body = genesis-body / actor-register-body / actor-rotate-key-body /
                 actor-revoke-body / delegation-grant-body / delegation-revoke-body /
                 actor-set-presence-body / ledger-rotate-log-key-body /
                 record-register-body / record-endorse-body / record-transition-body /
                 record-revoke-body / asset-action-body / contract-deploy-body /
                 contract-call-body / contract-retire-body

; Genesis creates the ledger. It is signed by the organization root key, and
;   ledger_id = statement_id of the genesis statement.
; The genesis statement also registers the organization actor, whose
; actor_id is the ledger_id.
genesis-body = {
  1 => -16 / -65538,           ; the ledger's hash algorithm: SHA-256 or SM3
  2 => tstr,                   ; organization name
  3 => public-key,             ; organization root key
  4 => public-key,             ; log key: signs checkpoints and receipts
}

actor-register-body = {
  1 => actor-kind,
  2 => tstr,                   ; display name
  3 => public-key,             ; signing key
  ? 4 => id,                   ; responsible person: required for agents
  ? 5 => agent-profile,        ; agents only
}
actor-kind = &(person: 1, agent: 2, device: 3)
agent-profile = {
  ? 1 => tstr,                 ; model
  ? 2 => tstr,                 ; model version
  ? 3 => tstr,                 ; runtime
}

; An actor may rotate its own key without a delegation; a person with
; presence credentials must then prove presence, user-verified. The
; organization rotates its root key this way (actor = ledger_id), signed
; with its current root key; no one else may. A new key must not be weak,
; another actor's key, one of the actor's presence keys, or a log key of
; this ledger (current or past).
actor-rotate-key-body = {
  1 => id,                     ; actor
  2 => public-key,             ; new signing key
}

; Replaces the log key (v0.4). Only the organization signs it, with its root
; key and without a delegation (no scope may name type 8). The new key must
; not be weak, an actor's key, or a log key this ledger ever had.
;
; The log key in effect for a tree of N entries is the one set by the last
; rotation at an index below N (or genesis). Checkpoints of size N, receipts
; against them, and the state commitment at index i (tree size i) are signed
; with the key in effect for that size: a rotation takes over from the first
; commitment or checkpoint after it, and older ones stay valid under theirs.
ledger-rotate-log-key-body = {
  1 => public-key,             ; the new log key
}

actor-revoke-body = {
  1 => id,                     ; actor
  ? 2 => tstr,                 ; reason
}

delegation-grant-body = {
  1 => id,                     ; grantee actor
  2 => scope,
}
; A delegation may only narrow the grantor's own scope. A chain from the
; organization to an actor has at most 16 delegations.
scope = {
  1 => [+ statement-type],     ; statement types the grantee may submit; never
                               ; genesis or ledger-rotate-log-key
  ? 2 => [+ tstr],             ; record types; absent means any
  ? 3 => timestamp,            ; not before
  ? 4 => timestamp,            ; not after
  ? 5 => bool,                 ; may delegate further; encoded only when true
  ? 6 => bool,                 ; statements under it must carry proof of
                               ; presence; encoded only when true. A
                               ; delegation granted under one that requires
                               ; presence must require it too.
  ? 7 => [+ id],               ; contracts (v0.6): calls and retires must act
                               ; on one of them (a call on an instance acts on
                               ; its contract); absent means any. Unique; a
                               ; delegated list is a subset of the grantor's.
}

; Proof of human presence (machine by default: a statement without it shows
; only that the signer's key was used). A person registers credentials:
; WebAuthn passkeys and security keys, or hardware keys such as USB keys
; (UKey) and smart cards, which sign with a key that never leaves the device
; and only after the person enters its PIN. actor-set-presence replaces them.
; It may be submitted by the organization, by an actor whose delegation
; covers it, or by the person themselves only if the statement carries proof
; of presence with a credential already registered, so that a stolen signing
; key alone cannot enroll a thief's passkey. Only people have credentials.
; A credential's key is a second key: never the person's signing key, any
; actor's key, or a log key (v0.4).
actor-set-presence-body = {
  1 => id,                     ; actor (a person)
  2 => [* presence-credential], ; at most 16, unique credential ids
}
presence-credential = webauthn-credential / hardware-key-credential
webauthn-credential = {
  1 => tstr,                   ; WebAuthn relying party id, 1-253 chars
  2 => bstr,                   ; credential id, 1-1023 bytes
  3 => public-key,             ; ESP256 (WebAuthn ES256) or Ed25519 (EdDSA)
  ? 4 => tstr,                 ; label
}
hardware-key-credential = {
  2 => bstr,                   ; credential id, 1-1023 bytes; CexChain's CLI
                               ; uses SHA-256 of the encoded public key
  3 => public-key,             ; any algorithm, SM2 among them
  ? 4 => tstr,                 ; label
  5 => 2,                      ; presence method: hardware key (absent, and
                               ; never encoded, for WebAuthn)
}

; A proof of presence approves exactly one statement, signed with exactly one
; key. Its challenge is
;   HASH("CexChain presence v1" || kid || P)
; where HASH is the ledger hash, kid is the statement's COSE kid (32 bytes),
; and P is the statement payload encoded without key 8. (Binding the kid
; stops a proof being reused by re-signing the payload with a rotated key.)
;
; With a WebAuthn credential, the proof is an assertion over the challenge.
; Verifiers check, for the signer's credential with this id:
;   1. authenticatorData begins with SHA-256(rp id) and has the user-present
;      flag (0x01); the user-verified flag (0x04) is reported, and required
;      when people rotate their own key or replace their own credentials
;      (v0.4; a hardware key, unlocked with its PIN, counts as verified);
;   2. clientDataJSON begins with
;        {"type":"webauthn.get","challenge":"<base64url challenge>","origin":"
;      followed by an origin without quotes or backslashes that belongs to
;      the rp id (https and the id or a subdomain; http or https for
;      "localhost"), then '"' and either "}" or ',"crossOrigin":false'
;      (WebAuthn Level 3, limited verification algorithm), and ends with "}";
;   3. the signature verifies over authenticatorData || SHA-256(clientDataJSON):
;      DER ECDSA for ES256 (either S), raw for Ed25519.
;
; With a hardware-key credential, the proof has no keys 2 and 3, and the
; signature is the credential key's signature over the challenge itself, in
; CexChain's format for the key's algorithm (as in COSE_Sign1).
presence-proof = {
  1 => bstr,                   ; credential id
  ? (
    2 => bstr,                 ; authenticatorData, 37-4096 bytes
    3 => bstr,                 ; clientDataJSON, 1-4096 bytes
  ),                           ; both for WebAuthn, neither for hardware keys
  4 => bstr,                   ; signature, 1-8192 bytes
}

delegation-revoke-body = {
  1 => id,                     ; delegation (statement_id of its grant)
  ? 2 => tstr,                 ; reason
}

record-register-body = {
  1 => tstr,                   ; record type, e.g. "cexchain.certificate/1"
  2 => bstr,                   ; field commitment root (see record-field)
  3 => uint,                   ; number of fields
  ? 4 => [+ attachment],
  ? 5 => { + tstr => any },    ; public metadata, disclosed in the clear
}
; Fields are committed individually so they can be disclosed selectively:
;   leaf = deterministic-CBOR(record-field), leaves sorted by field name,
;   root = RFC 9162 Merkle tree hash over the leaves (the ledger's hash).
record-field = [name: tstr, salt: bstr .size 16, value: any]
attachment = [
  name: tstr,
  media-type: tstr,
  size: uint,
  commitment: bstr,            ; HASH(salt || content), salt 16 bytes
]

record-endorse-body = {
  1 => id,                     ; record (statement_id of its registration)
  2 => tstr,                   ; role, e.g. "inspector", "receiver"
}

record-transition-body = {
  1 => id,                     ; record
  2 => tstr,                   ; from state
  3 => tstr,                   ; to state
}

record-revoke-body = {
  1 => id,                     ; record
  ? 2 => tstr,                 ; reason
}

; Changes an ownership asset (v0.5): a record of an asset type, on its home
; ledger. Only the home records actions, and only as its rules allow (see
; "Ownership assets" below). Assets refuse record-transition and
; record-revoke.
asset-action-body = {
  1 => id,                     ; the asset: the record id of its registration
  2 => asset-action-name,
  3 => uint,                   ; head: the log index of the asset's
                               ; registration or latest asset-action, which
                               ; this action follows
  ? 4 => id,                   ; to: the counterparty's ledger (transfer, pledge)
  ? 5 => uint .ge 1,           ; quantity (redeem)
  ? 6 => [1*4 consent-ref],    ; one per party the action needs, strictly
                               ; ascending by ledger
  ? 7 => tstr,                 ; reference: a payment reference, a court
                               ; order, a reason; 1-1024 bytes
}
asset-action-name = "transfer" / "pledge" / "release" / "enforce" / "redeem" /
                    "pay" / "confirm" / "dispute" / "freeze" / "unfreeze" /
                    "cancel"
; A party's consent, given on its own ledger.
consent-ref = [
  ledger: id,                  ; the party's ledger
  record: id,                  ; its cexchain.asset-consent/1 record there
  bundle: bstr .size 32,       ; HASH (the home ledger's) of the consent's
                               ; evidence bundle that the home verified and
                               ; keeps
]

; Contracts (v0.6; see "Contracts" below). A contract is identified by its
; deploy's statement_id, and its code never changes.
contract-deploy-body = {
  1 => bstr,                   ; code: a WebAssembly module that loads under
                               ; the profile (spec section 14.1), at most
                               ; 524,288 bytes
  2 => contract-interface,
  3 => tstr,                   ; language, 1-32 bytes: "bo", "wasm"
  4 => tstr,                   ; compiler and its version, 1-128 bytes
  ? 5 => bstr,                 ; source, at most 262,144 bytes; for the
                               ; language "bo", it SHOULD be
                               ; bstr .cbor bo-source
  ? 6 => tstr,                 ; name, 1-256 bytes
}
; Function names (UTF-8, 1-64 bytes), at most 256, at least one of kind 1.
contract-interface = { + tstr => function-kind }
function-kind = &(create: 1, call: 2)

; The source of a contract written in Bo (v0.6; spec section 15, "Contracts
; written in Bo"), from which anyone can rebuild its code. Pack references
; strictly ascend by id. Embedded packs strictly ascend by id too, and each
; is a referenced pack that is not official; a reference without an
; embedded pack names an official pack, which a Bo compiler carries in every
; released version.
bo-source = {
  1 => 1,                      ; format
  2 => uint .ge 1,             ; the Bo edition of the source
  3 => tstr,                   ; the source as written, comments included
  4 => [1*64 bo-pack-ref],     ; every language pack it was read with
  ? 5 => [1*64 bo-pack],       ; the packs that are not official, in full
}
bo-pack-ref = [
  id: tstr,                    ; the pack's id: ASCII letters, digits, and
                               ; single hyphens, 1-64 bytes
  version: uint .ge 1,
  digest: bstr .size 32,       ; HASH (the home's) of the pack's canonical
                               ; CBOR
]
; A language pack, as its canonical CBOR: a map with text keys (format, id,
; version, language, name, official, edition, reading, keywords, vocabulary,
; messages, sentences), defined by the Bo reference.
bo-pack = { + tstr => any }

; Either creates an instance (contract, a function of kind 1, no head, no
; consents; the instance id is this statement's id) or acts on one
; (instance, its head, a function of kind 2).
contract-call-body = {
  ? 1 => id,                   ; contract: exactly for a creation
  ? 2 => id,                   ; instance: exactly otherwise
  3 => tstr,                   ; function, in the contract's interface
  4 => any,                    ; arguments, at most 65,536 bytes encoded
  ? 5 => uint,                 ; head: the log index of the instance's
                               ; latest call; exactly with an instance
  ? 6 => [1*16 contract-consent-ref], ; strictly ascending by ledger; none
                               ; from the home
  ? 7 => tstr,                 ; reference, 1-1024 bytes
}
; A party's consent, given on its own ledger.
contract-consent-ref = [
  ledger: id,                  ; the party's ledger
  record: id,                  ; its cexchain.contract-consent/1 record there
  bundle: bstr .size 32,       ; HASH (the home's) of the consent's evidence
                               ; bundle that the home verified and keeps
  signer: signer,              ; who signed the consent's registration, as
                               ; that bundle shows; the contract sees it
]
; Who signed a statement, as a contract sees it.
signer = {
  1 => 0 / actor-kind,         ; 0: the organization
  ? 2 => 1 / 2,                ; proof of presence carried: passkey 1,
                               ; hardware key 2
  ? 3 => tstr,                 ; the model its provenance names, if any
}

contract-retire-body = {
  1 => id,                     ; contract: it creates no more instances
  ? 2 => tstr,                 ; reason
}

provenance = {
  ? 1 => tstr,                 ; model
  ? 2 => tstr,                 ; model version
  ? 3 => bstr,                 ; commitment to the inputs the agent acted on
  ? 4 => [+ tool-pin],         ; tools and skills used, pinned by digest
}
tool-pin = [name: tstr, digest: bstr]

; ---------------------------------------------------------------------------
; Log
; ---------------------------------------------------------------------------
;
; Each registered statement becomes one log entry. The ledger's Merkle tree
; (RFC 9162, ledger hash) commits to the encoded log entries in order.

; A log entry holds a statement, or (key 4 instead of 3) a state commitment
; the ledger appended when checkpointing. Exactly one of 3 and 4 is present.
log-entry = {
  1 => id,                     ; statement_id: HASH(Sig_structure) of the
                               ; statement or of the state commitment
  2 => timestamp,              ; registered_at, by the ledger clock
  ? 3 => bstr,                 ; the signed statement (COSE_Sign1) as submitted
  ? 4 => bstr,                 ; a signed state commitment (COSE_Sign1)
}

; A state commitment is a COSE_Sign1 by the log key in effect at its index
; (see ledger-rotate-log-key-body) with protected header
;   { 1: alg, 3: "application/cexchain-state+cbor", 4: kid }
; over a state-commitment-payload. When it checkpoints, the ledger first
; appends a commitment to the state after every entry so far (unless the last
; entry already is one), then signs a checkpoint that covers it. Being in the
; log, a commitment is witnessed like any entry and can never be withdrawn.
; Replaying the log checks every commitment: signed by that log key, for this
; ledger and tree hash, tree size equal to its own index, and state root equal
; to the root of the replayed state (see state-leaf).
state-commitment-payload = {
  1 => id,                     ; ledger_id
  2 => -16 / -65538,           ; tree hash algorithm
  3 => uint .ge 1,             ; tree size: the entries before it (its index)
  4 => bstr,                   ; state root
  5 => timestamp,
}

; A checkpoint is a COSE_Sign1 by the log key in effect at its tree size with
; protected header
;   { 1: alg, 3: "application/cexchain-checkpoint+cbor", 4: kid }
; over a checkpoint-payload. It binds the tree size and root together.
; A witness cosignature is a COSE_Sign1 by the witness key over the same
; payload bytes, with content type "application/cexchain-cosignature+cbor",
; so the two can never be confused.
checkpoint-payload = {
  1 => id,                     ; ledger_id
  2 => -16 / -65538,           ; tree hash algorithm
  3 => uint .ge 1,             ; tree size (genesis is always in the log)
  4 => bstr,                   ; root hash
  5 => timestamp,
}

; What a ledger operator sends a witness. The witness keeps, per ledger, the
; ledger id, the root key and log key (from the genesis entry, or the log key
; alone, learned out of band), the index of the last key rotation it
; followed, and the size and root it last cosigned. It cosigns only if:
;   0. every key rotation sent (key 4) is in the checkpoint's log (its
;      inclusion proof leads to the checkpoint's root), the rotations ascend
;      below the checkpoint's size, and each one after the last it followed
;      rotates the root or log key, signed by the root key in effect; it then
;      follows them (a witness without the root key refuses any);
;   1. the checkpoint is for that ledger and signed by its log key (after
;      following the rotations);
;   2. its tree hash equals the one in earlier checkpoints;
;   3. old size equals the size the witness last cosigned (otherwise it
;      refuses, and the operator retries from that size);
;   4. the tree size is not smaller than old size; and
;   5. the RFC 9162 consistency proof shows that the new tree extends the
;      tree the witness last cosigned (empty from size 0; equal sizes need
;      equal roots).
; Since state commitments are log entries, consistency also covers them: a
; ledger cannot show two states for one history.
cosign-request = {
  1 => bstr,                   ; the signed checkpoint (COSE_Sign1)
  2 => uint,                   ; old size
  3 => [* bstr],               ; consistency proof, at most 65 hashes
  ? 4 => [+ key-rotation-proof], ; v0.4: every key rotation below the
                               ; checkpoint's size, ascending, at most 4096
}
key-rotation-proof = [
  index: uint,                 ; its log index
  entry: bstr,                 ; the encoded log-entry
  path: [* bstr],              ; RFC 9162 inclusion path to the checkpoint's
                               ; root, at most 65 hashes
]

; A receipt is an RFC 9942 inclusion receipt:
;   protected   { 1: alg, 4: kid, 395: vds }
;   unprotected { 396: { -1: [ bstr .cbor inclusion-proof ] } }
;   payload     nil (detached; it is the Merkle root at tree-size)
; vds is 1 (RFC9162_SHA256) for SHA-256 ledgers and -65537 (CexChain private
; use: RFC 9162 tree with SM3) for SM3 ledgers. The candidate entry is the
; encoded log-entry.
inclusion-proof = [
  tree-size: uint,
  leaf-index: uint,
  inclusion-path: [* bstr],    ; RFC 9942 says [+ bstr]; empty for a one-entry tree
]

; ---------------------------------------------------------------------------
; Evidence bundles
; ---------------------------------------------------------------------------
;
; Everything needed to verify a record offline, without contacting or
; trusting the ledger's database. A verifier:
;   1. takes the ledger's identity, hash, and first keys from the genesis
;      entry;
;   2. checks each entry's receipt proof against the checkpoint (same tree
;      size and root), with entries strictly ascending from index 0;
;   3. replays the included statements under the ledger rules, among them
;      every rotation of the organization's keys below the checkpoint's size
;      (the bundle must carry them all);
;   4. verifies the checkpoint and every receipt's signature with the log key
;      in effect at the checkpoint's size, and each state commitment with the
;      one in effect at its index;
;   5. checks field disclosures against the record's field root and count,
;      and attachment contents against their commitments;
;   6. verifies cosignatures by witnesses it trusts;
;   7. if the last entry the checkpoint covers is a state commitment (and
;      the bundle includes it, with its receipt): checks it as replay would
;      (log key, ledger, tree hash, its own index), verifies every state
;      proof against its state root (at most one per object), and for the
;      record and each object involved in its events (the signer, an agent
;      signer's accountable person, and every delegation in the chain with
;      its grantor; for an instance, its contract; for a child, the events
;      of its ancestors' included calls too, but no ancestor itself)
;      requires a proof whose leaf equals that object's leaf in the replayed
;      state. Then nothing was omitted: the report is complete.
;      Without that commitment, a bundle cannot rule out omissions (such as
;      a later revocation).

; The state commitment: a compact sparse Merkle tree over every actor,
; delegation, and record, keyed by object id (its 256 bits, most significant
; first), with HASH the ledger hash:
;   empty subtree           HASH("")
;   subtree of one object   HASH(0x00 || state-leaf)
;   any other subtree       HASH(0x01 || left || right)
; A leaf lists every log index that created or changed the object, as of the
; commitment: for actors registration, key rotations, passkey changes, and
; revocation; for delegations grant and revocation; for records every
; statement about them. The organization's leaf is [1, ledger_id, [0, ...]],
; with every rotation of its root key and of the log key (v0.4), so a
; complete bundle shows them all.
; Contracts list their deploy and retire (v0.6); instances their creation
; and every call. A child (v0.7) starts with the call that created it, which
; its parent's history lists too.
state-leaf = [
  kind: 1 / 2 / 3 / 4 / 5,     ; actor, delegation, record, contract, instance
  id,
  history: [+ uint],           ; strictly ascending
]
; A proof lists the sibling hashes from the root down to the leaf; the
; verifier folds them bottom-up, taking the leaf's position from the id bits.
state-proof = [state-leaf, siblings: [* bstr]]   ; at most 256 siblings

evidence-bundle = {
  0 => 1,                      ; bundle format version
  1 => id,                     ; the record (statement_id of its registration),
                               ; or an instance (v0.6): a child's id is no
                               ; statement_id (v0.7, child-id-input)
  2 => [+ evidence-entry],     ; ascending log index, starting with genesis
  3 => bstr,                   ; the signed checkpoint the receipts lead to
  ? 4 => [+ bstr],             ; witness cosignatures on that checkpoint
  ? 5 => [+ field-disclosure],
  ? 6 => [+ attachment-opening],
  ? 7 => [+ state-proof],      ; required when the bundle includes the state
                               ; commitment its checkpoint ends with
}
evidence-entry = [
  entry: bstr,                 ; encoded log-entry
  receipt: bstr,               ; its RFC 9942 receipt
]
field-disclosure = [
  leaf: bstr,                  ; encoded record-field
  index: uint,                 ; its position among the sorted fields
  path: [* bstr],              ; RFC 9162 inclusion path
]
attachment-opening = [
  name: tstr,
  salt: bstr .size 16,         ; the content travels alongside the bundle
]

; ---------------------------------------------------------------------------
; Access across organizations (v0.3)
; ---------------------------------------------------------------------------

; Each step is a record (record-register-body) on the acting organization's
; own ledger, with these built-in types and public metadata (key 5). The
; other organization checks it with an evidence bundle, verified against the
; peer's ledger id, which it learned out of band. Delegations decide who may
; act, through record types; presence shows when a person approved.
;
;   cexchain.access-request/1  on the requester's ledger; initial state
;                              "requested", which may become "withdrawn"
;   cexchain.access-grant/1    on the granter's ledger; initial state
;                              "granted"; revoking the record ends it
;   cexchain.access-receipt/1  on the requester's ledger; state "received"
;
; Parties refuse metadata with other keys. Requests, grants, and receipts
; must be live (in their initial state, not revoked) and their evidence
; complete (proven against the state commitment).
access-request = {
  "ledger" => bstr .size 32,      ; the ledger asked
  "record" => bstr .size 32,      ; the record wanted there
  "purpose" => tstr,              ; non-empty
  "until" => uint,                ; access wanted until (ms), > 0
  "recipient" => bstr .size 32,   ; X25519 key deliveries are sealed to; one
                                  ; per request
  ? "fields" => [* tstr],         ; wanted fields; absent: all (unique names)
  ? "attachments" => [* tstr],    ; wanted attachments; absent: all
}
access-grant = {
  "ledger" => bstr .size 32,      ; the requester's ledger
  "request" => bstr .size 32,     ; the request record there
  "record" => bstr .size 32,      ; the record granted, on this ledger
  "fields" => [* tstr],           ; granted fields (unique names)
  "attachments" => [* tstr],      ; granted attachments
  "until" => uint,                ; > 0; the requester refuses it afterwards
  "recipient" => bstr .size 32,   ; the request's recipient key
}
access-receipt = {
  "ledger" => bstr .size 32,      ; the granter's ledger
  "grant" => bstr .size 32,       ; the grant record there
  "delivery" => bstr .size 32,    ; SHA-256 of the delivery received
}

; What the granter sends. The contents are sealed with HPKE (RFC 9180, base
; mode: DHKEM(X25519, HKDF-SHA256), HKDF-SHA256, AES-256-GCM) to the
; grant's recipient key, with info "CexChain delivery v1" and the grant
; record's id as additional authenticated data.
delivery = {
  1 => 1,                         ; version
  2 => bstr,                      ; the grant's evidence bundle
  3 => {
    1 => bstr,                    ; HPKE encapsulated key
    2 => bstr,                    ; ciphertext of delivery-contents
  },
}
delivery-contents = {
  1 => bstr,                      ; the granted record's evidence bundle, with
                                  ; the granted field disclosures and
                                  ; attachment openings only
  ? 2 => { + tstr => bstr },      ; granted attachments' contents, by name
}
; The recipient accepts a delivery only if: the grant verifies for the
; granter's ledger and names the recipient's ledger, its request, and its
; key; the contents open with that key; the record bundle verifies for the
; granter's ledger, is the granted record, and discloses nothing beyond the
; grant; and every attachment content matches its commitment.

; ---------------------------------------------------------------------------
; Ownership assets (v0.5)
; ---------------------------------------------------------------------------

; An asset is a record of an asset type, registered on its home ledger, the
; issuer's. Its parties (holder, pledgee, payee) are other organizations,
; identified by ledger id; no party is the home ledger itself. A party
; consents to an action with a cexchain.asset-consent/1 record on its own
; ledger; the home records the action (asset-action-body) once every party
; it needs has consented to the same terms, citing each consent.
;
; Record metadata (key 5 of record-register-body), checked by the ledger
; rules when an asset is registered. Other text keys are allowed.
receivable = {                 ; cexchain.receivable/1, on the debtor's ledger
  "holder" => bstr .size 32,   ; the first creditor's ledger
  "amount" => uint .ge 1,      ; in the currency's minor unit (fen for CNY)
  "currency" => tstr,          ; ISO 4217: three capital letters
  "due" => uint,               ; ms since the epoch
  * tstr => any,
}
warehouse-receipt = {          ; cexchain.warehouse-receipt/1, on the
                               ; warehouse's ledger
  "holder" => bstr .size 32,   ; the depositor's ledger
  "quantity" => uint .ge 1,
  "unit" => tstr,              ; 1-16 bytes: "kg", "t", "bale"
  * tstr => any,
}

; Metadata of a cexchain.asset-consent/1 record (initial state "given",
; which may become "withdrawn"), on the consenting party's ledger. Like the
; access records, its metadata is checked by the home and by verifiers, not
; by the ledger rules. The terms (ledger, asset, action, head, to, quantity)
; must equal the action's.
asset-consent = {
  "ledger" => bstr .size 32,   ; the asset's home ledger
  "asset" => bstr .size 32,
  "action" => asset-action-name,
  "head" => uint,
  ? "to" => bstr .size 32,
  ? "quantity" => uint .ge 1,
  "until" => uint,             ; > 0: the consent lapses then (ms)
  ? "reference" => tstr,       ; 1-1024 bytes: a financing contract, a
                               ; registry filing
}

; Everything needed to verify an asset offline: its bundle from the home
; ledger, and every consent bundle its actions pin (each once, in any
; order). A verifier:
;   1. verifies the asset bundle for the home ledger; it must be complete;
;   2. replays the asset's actions, so knows its holder, pledgee, payee,
;      state, and quantity as of the bundle's checkpoint;
;   3. for each consent-ref, takes the bundle whose HASH (the home's) it
;      names, and requires that bundle to verify for the referenced ledger,
;      completely; to be about the referenced record, a live (given, not
;      revoked) cexchain.asset-consent/1 record; to carry the action's
;      terms; and to lapse no earlier than the action's registration time.
asset-evidence = {
  0 => 1,                      ; format version
  1 => bstr,                   ; the asset's evidence bundle
  ? 2 => [1*4096 bstr],        ; consent evidence bundles
}

; ---------------------------------------------------------------------------
; Contracts (v0.6, draft)
; ---------------------------------------------------------------------------

; What a call's contract reads with input_read (spec section 14.4). The home
; builds it when it registers the call, and every verifier rebuilds it from
; the log when it replays the call.
contract-input = {
  1 => tstr,                   ; function
  2 => any,                    ; arguments
  3 => id,                     ; the home ledger
  4 => id,                     ; the contract
  ? 5 => instance-view,        ; absent for a creation
  6 => [actor: id, signer],    ; the caller
  7 => timestamp,              ; the call's registration time
  ? 8 => [+ [ledger: id, signer]], ; the consents, in the call's order
}
instance-view = {
  1 => id,                     ; the instance
  2 => uint,                   ; its head
  3 => any,                    ; its state
  ? 4 => tstr,                 ; its status
  ? 5 => parties,
  ? 6 => [parent: id, depth: 1..8], ; v0.7: exactly for a child
}
parties = { + tstr => id }     ; role (1-64 bytes) => ledger, at most 64

; What the contract writes with output_write. The call is registered only on
; an accept; a trap (abort is a rejection), a needs, or an output that is not
; this, in deterministic CBOR, refuses it.
contract-output = [1, contract-accept] / [2, needs: [1*16 id]]
                               ; needs: the ledgers whose consents the call
                               ; lacks, strictly ascending, none the home
contract-accept = {
  1 => any,                    ; the new state, at most 65,536 bytes encoded
  ? 2 => tstr,                 ; status, 1-64 bytes
  ? 3 => parties,              ; replaces the parties; absent keeps them
  ? 4 => [1*64 [name: tstr, data: any]], ; events, names 1-64 bytes
  ? 5 => true,                 ; final: the instance takes no more calls
  ? 6 => [1*16 contract-child], ; v0.7: new instances of the contract
}

; An instance created by a call (v0.7; spec section 15, "Instances created by
; a call"), a child of the instance the call acts on or creates. The home
; applies the accept to the parent first, then creates the children in
; order. A child has its parent's contract; its head is the creating call's
; log index; it is not final. Its depth is its parent's plus 1 (an instance
; a creation makes has depth 0), at most 8. A call that creates children is
; refused if the contract is retired or the parent's depth is 8.
contract-child = {
  1 => any,                    ; its first state, at most 65,536 bytes encoded
  ? 2 => tstr,                 ; its status, 1-64 bytes; absent: none
  ? 3 => parties,              ; its parties; absent: none
}
; A child's id is HASH (the home's) of this, deterministically encoded.
child-id-input = [
  call: id,                    ; the creating contract-call's statement_id
  position: 0..15,             ; the child's index in accept key 6
]

; Metadata of a cexchain.contract-consent/1 record (initial state "given",
; which may become "withdrawn"), on the consenting party's ledger. It is
; checked by the home and by verifiers, not by the ledger rules; the terms
; must equal the call's.
contract-consent = {
  "ledger" => bstr .size 32,   ; the instance's home ledger
  "instance" => bstr .size 32,
  "function" => tstr,
  "arguments" => bstr .size 32, ; HASH (the home's) of the encoded arguments
  "head" => uint,
  "until" => uint,             ; > 0: the consent lapses then (ms)
  ? "reference" => tstr,       ; 1-1024 bytes
}

; Everything needed to verify an instance offline: its bundle from the home
; ledger (with the deploy, any retire, and every call), and every consent
; bundle its calls cite (each once, in any order). For a child (v0.7), the
; bundle also holds each ancestor's creation and its calls up to the one
; that created the next generation, and their consents count as its calls';
; it carries no state proofs for the ancestors (their later calls are left
; out), but the involved objects include their calls' signers and
; delegations. A verifier:
;   1. verifies the instance bundle for the home ledger; it must be complete;
;   2. replays it, running the contract for each call (the ancestors'
;      included), to the instance's state, status, parties, and finality;
;   3. for each contract-consent-ref, takes the bundle whose HASH (the home's)
;      it names, and requires that bundle to verify for the cited ledger,
;      completely; to be about the cited record, a live (given, not revoked)
;      cexchain.contract-consent/1 record; to carry the call's terms; to
;      lapse no earlier than the call's registration time; and to show the
;      record's registration signed as the citation's signer claims;
;   4. refuses bundles no citation pins, and citations without a bundle.
contract-evidence = {
  0 => 1,                      ; format version
  1 => bstr,                   ; the instance's evidence bundle
  ? 2 => [1*4096 bstr],        ; consent evidence bundles
}
