# Requests: an action asks an executor for something outside the
# ledger; rules for the answers react to how it went. `done`, `result`, and
# `reason` stay names elsewhere: this contract has a state named done.
contract Notice
parties shipper, consignee

thing Parcel
  holder shipper
  due date
  notified yes or no = no
  note text = ""
  tries number = 0

can deliver by shipper
  active, late -> delivered
  holder = consignee
  request notify to consignee with message = "delivered", tries = tries within 1 day

can close by consignee
  delivered -> done

when overdue
  requires active
  request remind to shipper within 2 days

when notify done
  notified = yes
  note = result

when notify fails
  note = reason
  tries = tries + 1
  if tries < 3
    request notify to shipper with message = "notice failed" within 2 days

when remind expires
  -> late

test "notified on delivery"
  shipper create with due = 2027-03-10
  shipper deliver at 2027-03-08 -> delivered
  executor notify done with result = "MSG-1" -> notified = yes, note = "MSG-1"
  consignee close -> done

test "a failed notice, and an expired reminder"
  shipper create with due = 2027-03-10
  keeper remind at 2027-03-11
  keeper remind expires at 2027-03-13 -> late
  shipper deliver
  executor notify fails with reason = "no_route" -> note = "no_route", tries = 1
  keeper notify expires at 2027-03-20 -> tries = 2

test "answers the ledger refuses, and one after the end"
  shipper create with due = 2027-03-10
  executor notify done -> refused
  shipper deliver at 2027-03-08
  keeper notify expires at 2027-03-08 -> refused
  consignee close -> done
  executor notify fails with reason = "late" -> done, note = "late", tries = 1
  keeper remind at 2027-03-12 -> refused
