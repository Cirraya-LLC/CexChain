# SPDX-License-Identifier: Apache-2.0
# The console's options (cexchain-console run --help), for systemctl start cexchain-console.
# The ledger lives in /var/lib/cexchain (the service's state directory).
CEXCHAIN_LEDGER=/var/lib/cexchain/ledger
# On the company's host name behind a TLS proxy, unlocked at start:
#   CEXCHAIN_CONSOLE_ARGS=--listen 127.0.0.1:7470 --public-url https://ledger.example.com --unlock-file /etc/cexchain/unlock
CEXCHAIN_CONSOLE_ARGS=--port 7470
