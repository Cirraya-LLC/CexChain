# The console's options (kanhe-console run --help), for systemctl start kanhe-console.
# The ledger lives in /var/lib/kanhe (the service's state directory).
KANHE_LEDGER=/var/lib/kanhe/ledger
# On the company's host name behind a TLS proxy, unlocked at start:
#   KANHE_CONSOLE_ARGS=--listen 127.0.0.1:7470 --public-url https://ledger.example.com --unlock-file /etc/kanhe/unlock
KANHE_CONSOLE_ARGS=--port 7470
