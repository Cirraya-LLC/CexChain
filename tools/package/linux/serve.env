# The ledger server's options (kanhe serve --help), for systemctl start kanhe.
# The ledger lives in /var/lib/kanhe (the service's state directory).
KANHE_LEDGER=/var/lib/kanhe/ledger
# For example, beyond this host with TLS and checkpoints every minute (a company's
# console runs instead, from the kanhe-console package):
#   KANHE_SERVE_ARGS=--listen 0.0.0.0:8443 --tls-cert /etc/kanhe/cert.pem --tls-key /etc/kanhe/key.pem --log-key /etc/kanhe/log.key --checkpoint-interval 60
KANHE_SERVE_ARGS=--listen 127.0.0.1:8080
