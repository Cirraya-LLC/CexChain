# The ledger server's options (cexchain serve --help), for systemctl start cexchain.
# The ledger lives in /var/lib/cexchain (the service's state directory).
CEXCHAIN_LEDGER=/var/lib/cexchain/ledger
# For example, the console on the company's host name behind a TLS proxy:
#   CEXCHAIN_SERVE_ARGS=--listen 127.0.0.1:7470 --console --public-url https://ledger.example.com --unlock-file /etc/cexchain/unlock
CEXCHAIN_SERVE_ARGS=--listen 127.0.0.1:8080
