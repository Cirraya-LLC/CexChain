# The ledger server's options (cexchain serve --help), for systemctl start cexchain.
# The ledger lives in /var/lib/cexchain (the service's state directory).
CEXCHAIN_LEDGER=/var/lib/cexchain/ledger
# For example, beyond this host with TLS and checkpoints every minute (a company's
# console runs instead, from the cexchain-console package):
#   CEXCHAIN_SERVE_ARGS=--listen 0.0.0.0:8443 --tls-cert /etc/cexchain/cert.pem --tls-key /etc/cexchain/key.pem --log-key /etc/cexchain/log.key --checkpoint-interval 60
CEXCHAIN_SERVE_ARGS=--listen 127.0.0.1:8080
