{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 28,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CEXCHAIN_WARNINGS_AS_ERRORS": "ON"
            }
        },
        {
            "name": "gcc-debug",
            "displayName": "GCC 16, Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++-16",
                "CMAKE_BUILD_TYPE": "Debug",
                "CEXCHAIN_BO": "ON"
            }
        },
        {
            "name": "gcc-release",
            "displayName": "GCC 16, RelWithDebInfo",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "g++-16",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CEXCHAIN_BO": "ON"
            }
        },
        {
            "name": "gcc-asan",
            "displayName": "GCC 16, Debug, AddressSanitizer + UndefinedBehaviorSanitizer (the Bo compiler)",
            "inherits": "gcc-debug",
            "cacheVariables": {
                "CEXCHAIN_SANITIZERS": "address;undefined"
            }
        },
        {
            "name": "clang-debug",
            "displayName": "Clang, Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "clang-asan",
            "displayName": "Clang, Debug, AddressSanitizer + UndefinedBehaviorSanitizer",
            "inherits": "clang-debug",
            "cacheVariables": {
                "CEXCHAIN_SANITIZERS": "address;undefined"
            }
        },
        {
            "name": "clang-tsan",
            "displayName": "Clang, Debug, ThreadSanitizer",
            "inherits": "clang-debug",
            "cacheVariables": {
                "CEXCHAIN_SANITIZERS": "thread"
            }
        },
        {
            "name": "clang-fuzz",
            "displayName": "Clang, libFuzzer targets",
            "inherits": "clang-asan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CEXCHAIN_BUILD_FUZZERS": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "gcc-debug", "configurePreset": "gcc-debug" },
        { "name": "gcc-release", "configurePreset": "gcc-release" },
        { "name": "gcc-asan", "configurePreset": "gcc-asan", "targets": ["cexchain_bo_tests", "bo_build_fuzz"] },
        { "name": "clang-debug", "configurePreset": "clang-debug" },
        { "name": "clang-asan", "configurePreset": "clang-asan" },
        { "name": "clang-tsan", "configurePreset": "clang-tsan" },
        { "name": "clang-fuzz", "configurePreset": "clang-fuzz" }
    ],
    "testPresets": [
        {
            "name": "base",
            "hidden": true,
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error" }
        },
        { "name": "gcc-debug", "inherits": "base", "configurePreset": "gcc-debug" },
        { "name": "gcc-release", "inherits": "base", "configurePreset": "gcc-release" },
        {
            "name": "gcc-asan",
            "inherits": "base",
            "configurePreset": "gcc-asan",
            "filter": { "include": { "label": "^bo$" } }
        },
        { "name": "clang-debug", "inherits": "base", "configurePreset": "clang-debug" },
        { "name": "clang-asan", "inherits": "base", "configurePreset": "clang-asan" },
        { "name": "clang-tsan", "inherits": "base", "configurePreset": "clang-tsan" }
    ]
}
