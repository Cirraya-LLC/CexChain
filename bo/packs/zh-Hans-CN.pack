# Bo language pack: Simplified Chinese, mainland usage (official).
#
# Spellings with "…" mark where the argument goes; the digest covers the
# canonical CBOR, not this layout. 每个 (each, in the draft) would also read as
# 每 + 个 (per item), so each is 逐个.

{
  "format": 1,
  "id": "zh-Hans-CN",
  "version": 3,
  "language": "zh-Hans-CN",
  "name": "简体中文（中国大陆）",
  "official": true,
  "edition": 1,

  "reading": {
    "separation": "none",
    # 可质押, 须本人确认, 当逾期, 如果逾期: these keywords may attach to the
    # word after them, when that word is in the vocabulary or declared in
    # the contract (可用率 stays one word).
    "prefixes": ["kw.can", "kw.requires", "kw.when", "kw.if"],
    "attach": [
      # 每GB, 每港元
      {"word": "price.per", "before": ["unit", "currency"]},
      # 按发票, 按客户所在地
      {"word": "charge.by", "before": ["document", "field"]},
      # 30天内
      {"word": "cond.within", "after": ["time", "unit"]}
    ],
    "punctuation": {
      "，": ",", "、": ",", "：": ":", "（": "(", "）": ")", "％": "%",
      "\u3000": " ",
      "０": "0", "１": "1", "２": "2", "３": "3", "４": "4",
      "５": "5", "６": "6", "７": "7", "８": "8", "９": "9"
    },
    "multipliers": {"万": 10000, "亿": 100000000},
    "dates": {"read": ["{Y}年{M}月{D}日"], "write": "{Y}年{M}月{D}日"}
  },

  "keywords": {
    "kw.contract": "合约",
    "kw.parties": "参与方",
    "kw.can": "可",
    "kw.by": "由",
    "kw.to": "给",
    "kw.with": "附带",
    "kw.requires": "须",
    "kw.when": "当",
    "kw.if": "如果",
    "kw.otherwise": "否则",
    "kw.and": "且",
    "kw.or": "或",
    "kw.not": "非",
    "kw.each": "逐个",
    "kw.in": "在",
    "kw.reject": "拒绝",
    "kw.test": "测试",
    "kw.use": "使用"
  },

  "vocabulary": {
    "kind.asset": "资产",
    "kind.service": "服务",
    "kind.resource": "资源",
    "kind.thing": "物件",

    "act.issue": "签发",
    "act.transfer": "转让",
    "act.pledge": "质押",
    "act.release": "解除质押",
    "act.enforce": "实现质权",
    "act.redeem": "赎回",
    "act.split": "拆分",
    "act.cancel": "注销",
    "act.pay": "支付",
    "act.confirm_payment": "确认收款",
    "act.dispute": "提出争议",
    "act.refund": "退款",
    "act.credit": "抵扣",
    "act.subscribe": "订购",
    "act.renew": "续费",
    "act.upgrade": "升级",
    "act.downgrade": "降级",
    "act.suspend": "暂停",
    "act.resume": "恢复",
    "act.terminate": "终止",
    "act.allocate": "分配",
    "act.reclaim": "收回",
    "act.freeze": "冻结",
    "act.unfreeze": "解冻",
    "act.approve": "批准",
    "act.propose": "提议",
    "act.notify": "通知",
    "act.create": "创建",

    "cond.over": "超过 …",
    "cond.in_person": "本人确认",
    "cond.consent_of": "经 … 同意",
    "cond.overdue": "逾期",
    "cond.before_due": "到期前 …",
    "cond.within": "… 内",

    "price.price": "价格",
    "price.usage": "用量",
    "price.traffic": "流量",
    "price.overage": "超出",
    "price.per": "每",
    "price.setup_fee": "开通费",

    "charge.charge": "费用",
    "charge.tax": "税",
    "charge.rate": ["税率", "费率"],
    "charge.applies_to": "适用 …",
    "charge.from": "从 … 起",
    "charge.included": ["含税", "内含"],
    "charge.added": "另计",
    "charge.per_line": "逐行",
    "charge.per_document": "按单据",
    "charge.by": "按",

    "time.day": "天",
    "time.week": "周",
    "time.month": "个月",
    "time.year": "年",
    "time.daily": "每天",
    "time.weekly": "每周",
    "time.monthly": "每月",
    "time.yearly": "每年",
    "time.now": "现在",
    "time.today": "今天",
    "time.at": "时间 …",

    "unit.MB": "MB",
    "unit.GB": "GB",
    "unit.TB": "TB",
    "unit.MiB": "MiB",
    "unit.GiB": "GiB",
    "unit.TiB": "TiB",
    "unit.Mbps": "Mbps",
    "unit.Gbps": "Gbps",
    "unit.item": "个",
    "unit.kg": "公斤",
    "unit.tonne": "吨",

    "cur.HKD": "港元",
    "cur.CNY": "人民币",
    "cur.USD": "美元",
    "cur.SGD": "新加坡元",
    "cur.EUR": "欧元",

    "round.half_up": "四舍五入",
    "round.half_even": "四舍六入五成双",
    "round.down": "舍去",

    "doc.invoice": "发票",
    "doc.credit_note": "红字发票",
    "doc.receipt": "收据",

    "type.date": "日期",
    "type.text": "文本",
    "type.number": "数值",
    "type.yes_no": "是否",
    "type.list": "列表",
    "val.yes": "是",
    "val.no": "否",
    "val.refused": "被拒绝",
    "val.none": "无",
    "val.pending_approval": "待批准",

    "field.holder": "持有人",
    "field.amount": "金额",
    "field.due": "到期日",
    "field.quantity": "数量",
    "field.tier": "层级",
    "field.pledgee": "质权人",
    "field.parts": "各部分",
    "field.recipients": "各接收方",
    "field.customer_location": "客户所在地",
    "field.cooling_period": "冷却期",
    "field.payee": "收款人",
    "field.portion": "部分",
    "field.utc_offset": ["UTC 时差", "UTC时差"],

    "state.active": "正常",
    "state.proposed": "已提议",
    "state.pledged": "已质押",
    "state.paid": "已支付",
    "state.settled": "已结清",
    "state.frozen": "已冻结",
    "state.suspended": "已暂停",
    "state.terminated": "已终止",
    "state.cancelled": "已注销",
    "state.disputed": "争议中",
    "state.redeemed": "已赎回",
    "state.allocated": "已分配",
    "state.cooling": "冷却中",
    "state.divided": "已拆分",

    "actor.person": "真人",
    "actor.ai_agent": ["AI 代理", "AI代理"],
    "actor.device": "设备",
    "actor.keeper": "调度器",

    "role.we": ["我方", "本公司"],
    "role.customer": "客户",
    "role.supplier": "供应商",
    "role.bank": "银行",
    "role.issuer": "发行人",
    "role.counterparty": "相对方",

    "expr.sum_of": "… 总和",
    "expr.count_of": "… 数目",
    "expr.at_most": "最多 …",
    "expr.previous_state": "原先状态"
  },

  "messages": {
    "pack.syntax": "语言包不是有效的 CBOR 诊断记法：{detail}",
    "pack.too-large": "语言包有 {size} 字节，上限为 {limit}",
    "pack.expected-map": "{path} 必须是映射（map）",
    "pack.expected-text": "{path} 必须是文本字符串",
    "pack.expected-list": "{path} 必须是列表",
    "pack.expected-integer": "{path} 必须是非负整数",
    "pack.expected-boolean": "{path} 必须是 true 或 false",
    "pack.unknown-key": "{path} 含有未知的键 {key}",
    "pack.missing-key": "{path} 缺少键 {key}",
    "pack.format": "不支持语言包格式 {value}；本编译器读取格式 1",
    "pack.edition": "不支持 Bo 第 {value} 版；本编译器只认识第 1 版",
    "pack.bad-id": "{value} 不是有效的语言包标识：须以字母开头，只能包含字母、数字和单个连字符，最长 64 个字符",
    "pack.bad-language": "{value} 不是有效的语言标签（BCP 47，例如 zh-Hans-CN）",
    "pack.bad-version": "版本必须为 1 或以上，不能是 {value}",
    "pack.bad-text": "{path} 必须为 1 至 200 字节（月份名称为 64，消息和句子为 1,000），且不能包含控制字符",
    "pack.bad-value": "{path} 不能是 {value}",
    "pack.too-many": "{path} 的条目多于 {limit} 个",
    "pack.unknown-concept": "{path}：{concept} 不是 Bo 第 1 版的概念",
    "pack.wrong-category": "{path}：{concept} 属于 {category} 类别，不应放在这里",
    "pack.missing-keyword": "语言包 {pack} 没有拼写关键字 {concept}；每个语言包都必须拼写全部关键字",
    "pack.partial": "语言包 {pack} 没有拼写 {total} 个词语中的 {missing} 个；这些词语按英文读取和显示",
    "pack.bad-spelling": "{path}：{spelling} 不是有效的拼写：必须是一至四个用单个空格分隔的词，每个词不超过 64 字节，也不能以数字开头",
    "pack.bad-character": "{path}：{spelling} 含有 {character}，任何词语都不能包含该字符",
    "pack.needs-hole": "{path}：{spelling} 必须用 … 标出 {concept} 的参数位置（一次）",
    "pack.unexpected-hole": "{path}：{spelling} 不能包含 …：{concept} 不接受参数",
    "pack.bad-form": "{path}：{form} 不是有效的词形名称（小写英文字母，最多 16 个）",
    "pack.duplicate-spelling": "语言包 {pack} 给 {spelling} 赋予了两个含义：{concept} 和 {other}",
    "pack.conflict": "{spelling} 在语言包 {pack} 中表示 {meaning}，在语言包 {other_pack} 中却表示 {other}；同一拼写不能有两个含义",
    "pack.ambiguous-attachment": "{spelling}（{meaning}）也可以读作 {first} + {second}；请修改拼写或收窄连写规则",
    "pack.bad-attach": "{path}：{concept} 不能连写：本语言包必须把它拼写为一个词，… 只能位于远离相邻词的一侧",
    "pack.unknown-category": "{path}：{category} 不是可以连写的类别",
    "pack.bad-punctuation": "{path}：{character} 不能作为标点别名：必须是任何词语都不包含的一个字符，代表 , : ( ) % \" = < > + - * / . _、数字或空格之一",
    "pack.bad-multiplier": "{path}：{value} 不是 10 到 10^18 之间的 10 的幂",
    "pack.bad-date": "{path}：{pattern} 不是有效的日期格式：字段 Y、M（书写时可用 MONTH 并提供十二个月份名称）和 D 须各用大括号标出一次，字段之间须有文字",
    "pack.unknown-message": "{path}：{code} 不是消息代码",
    "pack.unknown-sentence": "{path}：{id} 不是句子标识",
    "pack.bad-placeholder": "{path}：{placeholder} 不是该文本可用的占位符",
    "pack.false-official": "语言包 {pack} 自称官方，但不是本编译器附带的官方语言包",
    "pack.duplicate-id": "有两个语言包的标识都是 {pack}",
    "lex.too-large": "源代码有 {size} 字节，上限为 {limit}",
    "lex.utf8": "源代码在此处不是有效的 UTF-8",
    "lex.invisible": "不能使用不可见字符 {character}：源代码必须与其显示内容一致",
    "lex.tab": "不能使用制表符（Tab）；缩进和分隔词语请用空格",
    "lex.indent-character": "缩进只能使用空格，不能使用 {character}",
    "lex.dedent": "此行的缩进与任何外层代码块都不匹配",
    "lex.too-deep": "代码块嵌套超过 {limit} 层",
    "lex.bad-character": "{character} 不能出现在此处：它不属于任何词语、数字或运算符",
    "lex.bad-number": "{text} 不是数字：_ 只能用在数字之间，小数点最多一个，且前后都要有数字（5_000、0.10）",
    "lex.digit-comma": "{text}：逗号不能用于数字分组；请写成 {suggestion}",
    "lex.number-too-large": "{text} 的位数超出 Bo 能保存的范围：去掉小数点后不能大于 18446744073709551615，小数最多 18 位",
    "lex.number-suffix": "{text} 中的数字后面不能接 {suffix}：数字后面可直接接倍数（万），然后是单位、时间单位或货币（2TB、30天、500万港元），再接“内”等词",
    "lex.multiplier": "{word} 必须紧跟在它所乘的数字后面：500万 或 500 万",
    "lex.percent": "% 必须紧跟在数字后面：5%",
    "lex.bad-date": "{text} 不是日期：请写成 YYYY-MM-DD，年份为 1 到 9999，月份为 01 到 12，日期须为该月所有（2027-01-06）",
    "lex.unterminated-text": "此行的文本缺少结束引号",
    "lex.text-too-long": "文本长于 {limit} 字节",
    "lex.edition": "不支持 Bo 第 {value} 版；本编译器读取第 1 版",
    "lex.bad-edition": "首行标明版本：bo 后面只能接版本号（bo 1）",
    "lex.ambiguous": "{text} 既可读作 {first}，也可读作 {second}；Bo 从不猜测：请在词与词之间加空格",
    "lex.ambiguous-money": "{text} 中，货币夹在两个数字之间，或数字夹在两个货币之间，无法确定归属：请把每个金额与其货币写在一起，并把各金额分开",
    "lex.needs-space": "{text}：请在 {first} 和 {second} 之间加空格",
    "lex.bad-name": "{name} 不是有效的名称：名称必须以字母开头，之后可以是字母、附加符号、数字或 _",
    "lex.name-too-long": "{name} 长于 {limit} 字节",
    "lex.not-normalized": "{character} 在 Unicode 规范化后会改变：请改用组合后的字符，使看起来相同的名称确实相同",
    "lex.mixed-script": "{name} 混用了外观相似的拉丁、希腊或西里尔字母：名称只能使用其中一种文字",
    "lex.confusable": "{name} 看起来像 {other}，但两者并不相同：请统一写法，或改用外观不同的名称",
    "parse.top-level": "{found} 不能在此处开始一行：在任何代码块之外，每行必须以 使用、合约、参与方、种类（物件；或配合其词汇包的资产、服务、资源）、费用或税、可、当 或 测试 开头",
    "parse.statement": "{found} 不能在动作的代码块内开始一行：可以写 须、如果、否则、逐个、拒绝、设置字段（持有人 = 银行）、状态变化（正常 -> 已暂停）、动作（通知 客户），或谁可以提议（AI 代理 可 提议）",
    "parse.field": "{found} 不能出现在字段中：代码块的每行先写字段，再写其类型或值（金额 港元、IP 1个），各部分用逗号分隔",
    "parse.step": "{found} 不能作为步骤的开头：测试的每行是步骤，先写参与方（供应商 质押 给 银行，可加 时间 日期、本人确认、由 AI 代理），或者是预期结果（-> 已质押、-> 被拒绝）",
    "parse.trailing": "此行在 {found} 之前已经完整：请删除它，或另起一行",
    "parse.unexpected-block": "这些行有缩进，但上一行没有开始任何代码块",
    "parse.empty-block": "{word} 必须有其管辖的内容：在其下加上缩进的代码块；当、如果 和 否则 也可以在同一行接一条语句",
    "parse.otherwise": "{word} 必须紧跟在相同缩进的 如果 代码块之后",
    "parse.duplicate": "{word} 出现了两次；只能写一次",
    "parse.reserved": "{word} 用于声明词汇包，须在任何代码块之外单独成行：使用 finance",
    "parse.too-deep": "此行嵌套超过 {limit} 层（括号、运算符或 否则 如果）",
    "parse.expected-name": "{after} 后面必须是自定义名称：关键字和词汇中的词语不能用作名称",
    "parse.expected-action": "{after} 后面必须是动作：词汇中的动作（质押、转让）或自定义名称",
    "parse.expected-party": "{after} 后面必须是参与方：角色（发行人、银行、客户）或自定义名称",
    "parse.expected-value": "{after} 后面必须有值",
    "parse.expected-text": "{after} 后面必须是用双引号括起的文本",
    "parse.expected-state": "{after} 后面必须是状态：例如 已质押、自定义名称，或测试中的 被拒绝",
    "parse.expected-set": "{after} 后面必须是字段及其值：金额 = HKD 100，用逗号分隔",
    "parse.can": "{found} 不能接在此动作之后：可以写 由 参与方、给 参与方 或 附带 输入项，每项最多一次",
    "parse.when": "当 后面必须先写事件，再写动作：当 逾期 3天 暂停、当 到期前 7天 通知 客户",
    "parse.each": "逐个 的写法是 逐个 名称 在 列表，要重复的各行写在其下的代码块中",
    "parse.bare-condition": "单独的条件不起作用：请在前面加上 须 或 如果；如要设置字段，请写 字段 = 值",
    "parse.unclosed": "此 ( 在同一行内没有对应的 )",
    "parse.missing-head": "{text} 是 {concept} 的结尾，但缺少开头的词",
    "parse.missing-tail": "{text} 是 {concept} 的开头，但值后面缺少结尾的词",
    "parse.missing-argument": "{text}（{concept}）前面必须有值，例如 各部分 总和",
    "parse.chained-comparison": "比较不能串联：请写 a < b 且 b < c，而不是 a < b < c（在 {operator} 处）",
    "parse.phrase-operator": "并列的词语不能直接用 {operator} 运算：请加上括号",
    "parse.ambiguous-name": "{name} 既可以是名称 {name}，也可以是 {prefix} 加上 {rest}，因为两者都已声明；Bo 从不猜测：请写成 {prefix} {rest}（中间加空格），或把其中一个改名",
    "parse.undeclared-split": "{name} 在此是一个名称，因为没有任何地方声明 {rest}；如要以 {prefix} 开始此行，请写成 {prefix} {rest}（中间加空格）",
    "check.fragment": "没有 合约 一行，因此此文件按片段检查；bo build 需要 合约 名称",
    "check.no-parties": "此合约有动作，但没有 参与方 一行：请写 参与方，再列出各角色（参与方 发行人, 供应商, 银行）",
    "check.unknown-pack": "使用 {pack}：Bo 没有这个词汇包；其词汇包为 commerce、finance 和 services",
    "check.pack-not-used": "{word} 属于 {pack} 词汇包，但源代码没有使用该词汇包：请在开头写 使用 {pack}",
    "check.duplicate": "{name} 声明了两次；同一合约中每个名称只有一个含义",
    "check.one-kind": "一份合约只描述一种实例；{name} 会是第二种：请另写一份合约",
    "check.unknown-name": "{name} 未声明：它不是参与方、字段、输入项、状态，也不是 逐个 给出的名称",
    "check.unknown-party": "{party} 不是此合约的参与方：请把它加入 参与方 一行",
    "check.unknown-field": "实例没有字段 {field}：请在种类的代码块中声明（金额 港元、到期日 日期）",
    "check.unknown-input": "{action} 没有输入项 {name}",
    "check.field-head": "{text} 不能用作字段名称：请用自定义名称，或字段、价格的词语（金额、到期日、持有人、价格）",
    "check.field-needs-type": "{field} 必须写明类型或值：金额 港元、到期日 日期、IP 1个",
    "check.field-type": "{field} 存放的是{expected_type}，而不是{type}",
    "check.field-values": "{field} 只能有一个类型或值；逗号之后的部分必须是带标签的价格（超出 每GB HKD 0.10）",
    "check.not-a-value": "{text} 在此不是值：值可以是数值、金额、日期、文本、参与方、字段、输入项，或可以放条件之处的条件",
    "check.phrase": "Bo 无法从 {text} 读出值：并列的词语可以组成周期金额（每月 HKD 120）、单价（每GB HKD 0.10）、带标签的价格（超出 每GB HKD 0.10）、逾期 N，或 按 某字段",
    "check.type": "{text} 是{type}，但此处需要{expected_type}",
    "check.operands": "{operator} 不能对{left_type}和{right_type}进行运算",
    "check.mixed-currencies": "{left_type}和{right_type}是不同的货币；Bo 从不换算货币",
    "check.mixed-units": "{left_type}和{right_type}度量不同的东西，不能混合",
    "check.calendar": "{text} 把月或年与天或周混合：一个月没有固定天数，因此 Bo 不会比较或相加",
    "check.precision": "{text} 比 Bo 保存的精度更细：金额精确到该货币的分，单价精确到小数点后六位，比率精确到 0.0001%，数量精确到整数的字节、每秒比特、个或克",
    "check.whole-number": "{text} 在此必须是整数（表示比例请写比率：150%）",
    "check.overflow": "{text} 太大：Bo 以 64 位整数保存每个值，以其最小单位计",
    "check.zero-division": "{text} 除以零",
    "check.list-items": "{text} 的各项不是同一类型",
    "check.list-bound": "{text}：列表可以有 1 到 {limit} 项",
    "check.each-body": "{text}：逐个 之下的区块每项执行一次，因此不能改变状态或执行动作；请移到 逐个 之外",
    "check.set-constant": "{field} 是常量（代码块已给出其值），任何动作都不能更改；如要让动作更改，请改为声明其类型（层级 数值）",
    "check.set-target": "{text} 不能设置：只有实例的字段可以设置",
    "check.initial-state": "实例可以从 {states} 中任何一个状态开始，因为没有状态变化通往它们；Bo 从不猜测：实例从唯一没有状态变化通往的状态开始，否则从 正常 开始",
    "check.unreachable-state": "从实例的开始状态出发，没有任何状态变化通往 {state}，因此没有实例能到达此状态",
    "check.needs-by": "由谁开始 {action}？自定义动作必须写 由 参与方",
    "check.recursion": "{action} 经由它所做的动作又回到自身；合约从不递归",
    "check.permit": "{text}：第 1 版中，此类语句只有 AI 代理 可 提议",
    "check.subject": "{text}：在动作之内只有合约本身行事；参与方的责任应写在 当 规则中（当 到期日 发行人 支付）",
    "check.threshold-amount": "{text} 比较 {action} 的金额，但它没有唯一的金额：请给它一个金额输入项（附带 金额 港元），或给实例一个 金额 字段，或改为比较字段（须 金额 > HKD 100）",
    "check.standard-by": "{action} 是内置动作，按其标准条款由 {party} 发起；如要由其他参与方发起，请以自定义名称复制此动作（cexchain bo stdlib show {action}）",
    "check.standard-to": "按标准条款，{action} 没有相对方，因此不能写 给；如要加上相对方，请以自定义名称复制此动作（cexchain bo stdlib show {action}）",
    "check.standard-change": "{text}：{action} 的状态转变，以及其标准条款所更改的字段，均属标准条款；如要更改，请以自定义名称复制此动作（cexchain bo stdlib show {action}）",
    "check.standard-field": "{action} 的标准条款使用字段 {field}，每个实例都须存放此字段，并可由动作更改：请在种类的代码块中声明它及其类型",
    "check.standard-unreachable": "{action} 永远无法发起：按其标准条款，它只能从 {states} 开始，但此合约的实例永远不会处于该状态",
    "check.when-event": "{text} 不是时间：当 规则在某个日期（当 到期日、当 到期日 + 3天）、到期前 N、逾期或逾期 N 时触发，或在实例处于某状态满 N 时触发（当 已暂停 30天），其他条件用 且 连接",
    "check.when-person": "{text} 需要真人，但 当 规则由调度器调用：没有人会本人确认或提议",
    "check.needs-due": "{text} 从到期日起算，但实例没有到期日：请在种类的代码块中声明 到期日 日期（有周期价格的服务在每期结束时到期）",
    "check.when-action": "当 规则不能执行 {action}：调度器的调用不带参数，而 {action} 须指明相对方或附带输入项",
    "check.utc-offset": "{text} 不是 UTC 时差：请写成文本，例如 \"+08:00\" 或 \"-05:30\"，在 -14:00 到 +14:00 之间",
    "check.charge-field": "{text} 不是费用可以有的一行：税率、金额、适用、含税或另计、逐行、按单据、按某单据、舍入方式，或 从 日期 起 附带税率",
    "check.charge-rate": "费用 {name} 必须有税率（税率 5%）或金额（金额 人民币 20），但不能两者都有",
    "check.charge-included": "请写明 {name} 是含在价格内还是另计：写 含税 或 另计，只写一次",
    "check.document": "{field} 存放单据的各行：请在种类的区块内声明一个这样的字段，为同一货币的金额列表（发票 列表 人民币）",
    "check.charge-document": "费用 {name} 按单据计算，但没有字段存放单据：请声明一个以单据命名的字段，例如 发票 列表 人民币",
    "check.charge-twice": "{text}：费用 {name} 已经写过这一项；只写一次",
    "check.charge-on": "{name} 不能按 {other} 计算：费用按价格及写在其前面的费用计算（逐行计算的只能按逐行计算的费用），含税的费用和定额只按价格计算",
    "check.charge-rounding": "{name} 是定额，不会舍入：请不要为其写舍入方式",
    "check.charge-bill": "{name} 每张{document}舍入一次，但合约的单据不是{document}",
    "check.needs-executor": "{action} 要求执行器在账本之外执行，此功能在 6b 步骤推出：bo check 接受它，但在此之前 bo build 会拒绝",
    "check.test-start": "测试须以创建实例开始：参与方 {action} 附带 字段 = 数值, …；创建实例的一方即所属账本，由其账本执行合约",
    "check.test-again": "每个测试只在第一步创建一次实例",
    "check.test-creation": "{text}：本合约的实例以 {action} 创建（资产用 签发，其他用 创建）",
    "check.test-home": "实例由其所属账本 {party} 创建：角色 {party} 即执行合约的账本",
    "check.test-action": "{action} 不是本合约的动作：步骤须执行合约声明的动作（可 …），或创建实例",
    "check.test-party": "{text} 不是参与方：步骤须指明合约的参与方，或只在测试中使用的账本（bank1）",
    "check.test-to": "{action} 没有相对方，因此执行它的步骤不能指明相对方：请删去 给",
    "check.test-counterparty": "{action} 的相对方是 {party}，在创建实例时确定账本：请写 给 {party}",
    "check.test-signer": "{text}：步骤可以 由 AI 代理（由代理签署），或 本人确认（由本人证明本人在场），但不能两者兼有，由 也不能指明其他人",
    "check.test-step": "{text}：除 给 和 附带 外，步骤只能有 时间 日期、本人确认 和 由 AI 代理，每项一次",
    "check.test-time": "{text}：时间 后面须写 1970-01-01 之后的日期（时间 2027-01-06）",
    "check.test-time-back": "{text} 早于之前的步骤：测试中的时间不会倒退",
    "check.test-value": "{text}：测试须按原样写出每个数值：数目、金额、数量、日期、时长、比率、文本，或 是、否",
    "check.test-missing": "{action} 需要 {name}：请以 {name} = 数值 给出",
    "check.test-expect": "{text} 不是步骤可以预期的结果：请写合约的状态（-> signed）、被拒绝（-> 被拒绝，或在引号内附上原因），或调用等待的同意（-> 经 银行 同意）",
    "check.test-expect-step": "预期结果（->）须紧跟其所属的步骤，且只能有一个",
    "check.test-reason": "{text}：只有 被拒绝 可以附上原因",
    "check.test-proposal": "-> 待批准：只有由 AI 代理调用、而 AI 代理只能提议的动作（AI 代理 可 提议），才会保留为提议；{action} 并非此类动作",
    "check.test-needs-to": "{action} 的相对方由每次调用指明：请写 给 参与方（供应商 转让 给 factor1）",
    "check.test-rule": "没有 当 规则执行 {action}：调度器步骤须写出 当 规则所执行的动作（调度器 暂停）",
    "check.test-part": "{text}：步骤以持有人指明所处理的实例（发行人 支付 小厂甲）：只能指明一个参与方，而合约的实例须有持有人",
    "check.parts-place": "{text}：动作只能在本身的区块内签发各部分一次（不能在 如果 或 逐个 之下），当 规则不能签发",
    "check.parts-shape": "{text}：签发 各部分 给 各接收方 [附带 字段 = 值, ...]：各部分须为金额列表，单位与实例的金额相同；各接收方须为参与方列表；附带 只能设置实例的字段，金额和持有人除外",
    "check.parts-instance": "{action} 会签发各部分，因此每个实例须有金额（金钱或数量）和持有人，且不能有账单",
    "check.test-keeper": "{text}：调度器调用 当 规则时不带其他内容：不能写 给、附带、本人确认或由 AI 代理",
    "build.fragment": "此文件没有 合约 一行，属于片段：只有合约（合约 名称）可以编译",
    "build.standard-action": "{action} 是内置动作：其模板随标准库在以后版本的编译器中提供；目前请声明自定义动作（可 名称 由 参与方）",
    "build.executor": "{action} 要求执行器在账本之外执行，此功能在 6b 步骤推出：已部署的代码永不改变，因此在此之前无法编译",
    "build.time-rule": "{text}：此 当 规则尚不能编译：服务在每个已付期间结束时到期，须由执行者（第 6b 步）跟踪",
    "build.unsupported": "{text} 用到 {feature}，此版本的编译器尚不能编译",
    "build.name-taken": "编译后的合约中有两部分同名 {name}（函数、字段、参与方或输入项）：请将其中之一改名",
    "build.name-too-long": "{name} 用于编译后的代码太长：最多 {limit} 字节",
    "build.too-many-functions": "合约的动作多于编译后合约允许的数目（{limit} 个函数）",
    "build.too-many-parties": "合约的参与方及参与方字段多于编译后合约允许的数目（{limit} 个）",
    "build.too-many-fields": "合约的字段多于编译后合约允许的数目（{limit} 个）",
    "build.too-many-inputs": "{action} 的输入项多于编译后动作允许的数目（{limit} 个）",
    "build.too-many-events": "{action} 改变状态的次数多于一次调用可报告的数目（{limit} 个事件）",
    "build.too-many-charges": "合约的费用多于编译后合约所容许的数目（{limit} 个）",
    "build.too-large": "编译后的合约会过大：某动作的代码，或其包含的文本、名称及原因，超出合约的上限",
    "build.reject-text": "{text}：拒绝的文本不能以 bo: 开头，此标记属于编译器自身的原因",
    "build.late-party": "{field} 以 {party} 开始，但 {party} 要到之后的动作才确定：请为 {field} 指定在创建时已确定的参与方",
    "build.fuel": "{function} 一次调用最多可用 {bound} 燃料，多于一次调用所拥有的 {limit}：请为其列表设定较小的上限（最多 N 项），或在一个动作内少做一些",
    "build.output": "{function} 一次调用最多可写出 {bound} 字节，多于编译后合约为输出预留的 {limit}：这样的调用会被拒绝（bo:output）。部分会重复其母实例的字段，因此状态庞大的实例不能拆分为多个部分",
    "build.comments": "源代码会连同其注释（{count} 行）一起部署：各参与方以及任何验证此合约的人都能阅读",
    "run.input": "调用的输入不是合约可读取的内容：须为限度以内的确定性 CBOR",
    "run.overflow": "数值超出 Bo 可保存的范围：以最小单位计的整数，64 位",
    "run.division-by-zero": "除以零",
    "run.date": "日期不在公元 1 至 9999 年之内",
    "run.output": "结果过大：实例的状态最多 64 KiB，调用的输出最多 192 KiB",
    "run.consents": "此调用需要超过 16 个账本的同意",
    "run.function": "合约没有此函数",
    "run.arguments": "参数不是由该函数输入项组成的映射",
    "run.argument": "参数 {name} 缺失，或类型不符",
    "run.state": "实例当前的状态不允许 {action}",
    "run.requires": "{action} 的第 {number} 项要求未满足",
    "run.in-person": "{action} 需要本人以通行密钥或硬件密钥证明本人在场",
    "run.party": "{party} 尚未确定账本",
    "run.empty": "目前没有 {party}",
    "run.pending": "实例已保留 16 项待批准的提议",
    "run.proposal": "没有待批准的提议具有该函数及参数",
    "run.approve": "{action} 由 AI 代理提议：须由证明亲身在场的真人批准",
    "run.when": "{rule} 尚不适用：时间未到，或条件不成立",
    "run.fired": "{rule} 已就此时间适用过",
    "run.depth": "{action} 会创建部分，但此实例已是深度 8 的部分，即账本允许的最深层",
    "run.parts": "{action} 为每个接收方签发一个部分：部分的数目须与接收方相同，且至少一个",
    "fmt.unstable": "用 {language} 书写时，此处源代码的读法会改变：合约自定义的名称或某个词语会与周围的词语连读成 {language} 的另一个词语；因此没有格式化任何内容：请给该名称改名或改写此行，或格式化为另一种语言",
    "fmt.internal": "按标准版式排版后，此处源代码的读法会改变，因此没有格式化任何内容；这是格式化工具的错误，请报告",
    "bo.truncated": "还有其他问题；只显示前 {limit} 个"
  },

  "sentences": {
    "contract": "合约 {name}",
    "fragment": "合约片段（没有 合约 一行，因此不能部署）",
    "intro": "本文由 Bo 根据合约的源代码生成（Bo 第 {edition} 版）。标有规则（例如〔R3〕）的条款，所述内容并非源代码直接写明，而是 Bo 按该规则推断得出；最后一节逐条解释各规则。",
    "packs-used": "除 Bo 的核心词汇外，本合约使用{packs}。",
    "vocab-pack": "{pack}词汇包（第 {version} 版）",
    "vocab-core": "核心",
    "vocab-finance": "金融",
    "vocab-commerce": "商务",
    "vocab-services": "服务",
    "mark": "〔{rules}〕",
    "rule-line": "〔{rule}〕{text}",
    "section-parties": "参与方",
    "section-instance": "每个实例",
    "section-charges": "费用",
    "section-states": "状态",
    "section-actions": "动作",
    "section-time": "时间规则",
    "section-rules": "Bo 采用的规则",
    "party-creation": "{party}：在创建实例时确定账本。",
    "party-action": "{party}：由首次{action}确定账本，并须经{party}同意。",
    "party-each": "{party}：由每次{action}确定账本，并须经{party}同意。",
    "instance-kind": "每个实例为一项{kind}，名为{name}。",
    "instance-none": "实例不存放任何字段。",
    "field-given": "{field}：{type}，在创建实例时给出。",
    "field-party": "{field}：{type}；每个实例以{party}开始，动作可以更改。",
    "field-constant": "{field}：{value}，所有实例都相同。",
    "field-empty": "{field}：{type}；每个实例开始时为无，由动作设定。",
    "creation": "创建实例（函数 {function}）时，须指明在创建时确定的参与方的账本，并给出在创建时给出的字段。创建实例无须任何参与方同意：各参与方通过下列动作表示同意。",
    "state-first": "实例的初始状态为{state}。",
    "states-all": "其状态包括{states}。",
    "state-final": "{state}为最终状态：没有动作可以从该状态开始，因此处于该状态的实例不再接受调用。",
    "states-no-final": "没有最终状态：任何状态下都有动作可以开始。",
    "events": "每次状态变化（包括初始状态）都记录为事件。",
    "actions-note": "调用如果不符合动作的任何一项要求，就会被拒绝，实例保持不变。缺少同意并不是拒绝：调用会等待该同意。",
    "action-function": "{action}（函数 {function}）",
    "action-standard": "Bo 的内置动作：其标准条款（由谁发起、须经谁同意、所需及所改变的状态）将随以后版本的标准库提供，因此本文只列出合约所写的条款。",
    "action-terms": "Bo 的内置动作，按 Bo 标准库的标准条款（cexchain bo stdlib show {function}）：标示 R19 的条款列出这些标准条款，列于合约本身的条款之后。",
    "action-terms-pack": "{pack}词汇包的内置动作，按该词汇包订立的标准条款（cexchain bo stdlib show {function}）：标示 R19 的条款列出这些标准条款，列于合约本身的条款之后。",
    "action-home": "由所属账本自行发起：无须任何参与方同意。",
    "action-home-start": "由所属账本自行发起。",
    "action-rule-only": "只有合约的时间规则会执行此动作：没有调用可以直接发起。",
    "action-by": "由{party}发起，须经其同意。",
    "action-to": "相对方为{party}。",
    "action-inputs": "调用须给出：{inputs}。",
    "input": "{input}（{type}）",
    "consent-binds": "须经{party}同意。首次调用须指明{party}的账本，并以此确定{party}的账本；之后的调用可以省略，或指明同一账本。",
    "consent-rebinds": "须经{party}同意。每次调用都须指明{party}的账本，并以此确定{party}的账本。",
    "consent-taken": "须经调用前作为{field}的参与方同意，因为此动作会更改{field}。",
    "consent-call": "须经{party}同意；每次调用均须指明其账本（参数 {input}）。",
    "consent-takes": "每次调用均须经{party}同意，因为此动作使{party}成为{field}。",
    "requirement": "要求 {number}：{need}。",
    "requirement-if": "要求 {number}：如果{guard}，{need}。",
    "need-consent": "须经{party}同意",
    "need-in-person": "{party}须以通行密钥或硬件密钥证明本人在场",
    "starter": "发起此动作的参与方",
    "if": "如果{condition}：",
    "otherwise": "否则：",
    "reject": "拒绝调用，原因为{message}。",
    "set": "将{field}改为{value}。",
    "transition": "实例转为{state}状态。",
    "transition-from": "如果实例处于{from}状态，即转为{state}状态；否则拒绝调用。",
    "transition-previous": "如果实例处于{from}状态，即恢复至转为{from}状态之前的状态；否则拒绝调用。",
    "each": "逐个处理{list}中的每项{item}：",
    "do": "并执行：{action}。",
    "do-executor": "由执行器在账本之外{action}，并回报结果。",
    "do-duty": "责任：{party}须{action}。该责任决定实例何时到期和逾期，不会调用任何动作。",
    "do-rule": "按该动作的条款执行{action}。",
    "do-parts": "{parts}中的每一部分各自成为本合约的一个实例，即本实例的一个部分：其持有人为{recipients}中相同位置的参与方，其金额即该部分。它具有本实例其他字段此刻的值，但 Bo 加入的字段除外（初始为无），并以{state}状态开始。本实例随即终结：不再接受调用。",
    "parts-set": "每个部分的{field}设为{value}，按本实例计算。",
    "parts-depth": "部分可以再拆分，最深至深度 8，即账本允许的最深层：对深度 8 的部分进行此调用会被拒绝（bo:depth {function}）。",
    "parts-privacy": "持有或核验某部分的任何人，都能看到其所源自的每个实例直至拆分调用为止的记录：包括该调用的其他部分、其持有人和金额。",
    "action-args": "{action}{args}",
    "action-to-party": "{action}给{party}",
    "action-by-party": "由{party}{action}",
    "action-with": "{action}，附带{inputs}",
    "agents-delegation": "AI 代理可在其授权范围内发起此动作。",
    "agents-propose": "AI 代理只能提议此动作：其调用会保留为提议，须经证明亲身在场的真人批准后方可生效，届时会核对每项要求。",
    "approve": "批准（函数 {function}）：由证明亲身在场的真人批准 AI 代理所作的提议，并指明其函数及参数。该提议随即按其动作执行，由该动作的发起方发起，并核对每项要求。每个实例最多保留 16 项提议。",
    "action-executor": "由执行器在账本之外执行，并回报结果。",
    "due-field": "实例在{field}到期。",
    "due-period": "实例在每个已付周期结束时到期。",
    "when": "当{event}时：",
    "when-date": "于{date}：",
    "when-keeper": "函数 {function}：时间一到，调度器就会调用。早于此时间的调用会被拒绝；每个时间只适用一次，其事件会记录调用迟了多久。",
    "utc-offset": "日期和天数按 UTC{offset} 计算，全年不变，不设夏令时；某日加一个月而下月没有该日（1 月 31 日加一个月）时，以该月最后一天为准。",
    "charge": "{kind}{name}：",
    "charge-rate": "比率为{rate}。",
    "charge-amount": "金额为{value}。",
    "charge-applies": "适用条件：{condition}。",
    "charge-included": "已包含在价格内。",
    "charge-added": "在价格之外另计。",
    "charge-per-line": "逐行舍入，采用{rounding}。",
    "charge-per-document": "每份单据舍入一次，采用{rounding}。",
    "charge-by-document": "每张{document}舍入一次，采用{rounding}。",
    "charge-from": "自{date}起，比率为{rate}。",
    "charge-other": "{text}。",
    "charge-bill": "以下费用按{document}（单据的各行）计算，每当其被设定时计算：即创建实例时，以及动作设定它时。费用按该次调用的时间计算；实例保存单据开出时的原貌，该次调用并将其记录为事件。此后比率变动，也不会改变已开出的单据。",
    "charge-on": "按{base}计算。",
