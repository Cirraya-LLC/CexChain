# Bo language pack: Traditional Chinese, Hong Kong usage (official).
#
# Hong Kong terms and character forms (zh-Hant-HK), not Taiwan's: 賬 not 帳,
# 紀錄, 合約, 訂約方, 予, 須, 及, 今日, 清單. A native Hong Kong reviewer signs
# off the words before the first release. Spellings with "…" mark where the
# argument goes; the digest covers the canonical CBOR, not this layout.

{
  "format": 1,
  "id": "zh-Hant-HK",
  "version": 1,
  "language": "zh-Hant-HK",
  "name": "繁體中文（香港）",
  "official": true,
  "edition": 1,

  "reading": {
    "separation": "none",
    # 可質押, 須親身確認, 當逾期, 如逾期: these keywords may attach to the
    # word after them, when that word is in the vocabulary or declared in
    # the contract (可用率 stays one word).
    "prefixes": ["kw.can", "kw.requires", "kw.when", "kw.if"],
    "attach": [
      # 每GB, 每港元
      {"word": "price.per", "before": ["unit", "currency"]},
      # 按發票, 按客戶所在地
      {"word": "charge.by", "before": ["document", "field"]},
      # 30日內
      {"word": "cond.within", "after": ["time", "unit"]}
    ],
    "punctuation": {
      "，": ",", "、": ",", "：": ":", "（": "(", "）": ")", "％": "%",
      "\u3000": " ",
      "０": "0", "１": "1", "２": "2", "３": "3", "４": "4",
      "５": "5", "６": "6", "７": "7", "８": "8", "９": "9"
    },
    "multipliers": {"萬": 10000, "億": 100000000},
    "dates": {"read": ["{Y}年{M}月{D}日"], "write": "{Y}年{M}月{D}日"}
  },

  "keywords": {
    "kw.contract": "合約",
    "kw.parties": "訂約方",
    "kw.can": "可",
    "kw.by": "由",
    "kw.to": "予",
    "kw.with": "連同",
    "kw.requires": "須",
    "kw.when": "當",
    "kw.if": "如",
    "kw.otherwise": "否則",
    "kw.and": "及",
    "kw.or": "或",
    "kw.not": "非",
    "kw.each": "逐一",
    "kw.in": "於",
    "kw.reject": "拒絕",
    "kw.test": "測試",
    "kw.use": "使用"
  },

  "vocabulary": {
    "kind.asset": "資產",
    "kind.service": "服務",
    "kind.resource": "資源",
    "kind.record": "紀錄",

    "act.issue": "發出",
    "act.transfer": "轉讓",
    "act.pledge": "質押",
    "act.release": "解除質押",
    "act.enforce": "執行質權",
    "act.redeem": "贖回",
    "act.split": "拆分",
    "act.merge": "合併",
    "act.cancel": "註銷",
    "act.pay": "支付",
    "act.confirm_payment": "確認收款",
    "act.dispute": "提出爭議",
    "act.refund": "退款",
    "act.credit": "抵扣",
    "act.subscribe": "訂購",
    "act.renew": "續期",
    "act.upgrade": "升級",
    "act.downgrade": "降級",
    "act.suspend": "暫停",
    "act.resume": "恢復",
    "act.terminate": "終止",
    "act.allocate": "分配",
    "act.reclaim": "收回",
    "act.freeze": "凍結",
    "act.unfreeze": "解凍",
    "act.approve": "批准",
    "act.propose": "提議",
    "act.notify": "通知",

    "cond.over": "超過 …",
    "cond.in_person": "親身確認",
    "cond.consent_of": "經 … 同意",
    "cond.overdue": "逾期",
    "cond.before_due": "到期前 …",
    "cond.within": "… 內",

    "price.price": "價格",
    "price.usage": "用量",
    "price.traffic": "流量",
    "price.overage": "超出",
    "price.per": "每",
    "price.setup_fee": "開通費",
    "price.proration": "按日折算",

    "charge.charge": "費用",
    "charge.tax": "稅",
    "charge.rate": ["稅率", "費率"],
    "charge.applies_to": "適用 …",
    "charge.from": "從 … 起",
    "charge.included": "內含",
    "charge.added": "另計",
    "charge.per_line": "逐行",
    "charge.per_document": "按單據",
    "charge.by": "按",

    "time.day": "日",
    "time.week": "週",
    "time.month": "個月",
    "time.year": "年",
    "time.daily": "每日",
    "time.weekly": "每週",
    "time.monthly": "每月",
    "time.yearly": "每年",
    "time.now": "現時",
    "time.today": "今日",
    "time.at": "時間 …",

    "unit.MB": "MB",
    "unit.GB": "GB",
    "unit.TB": "TB",
    "unit.MiB": "MiB",
    "unit.GiB": "GiB",
    "unit.TiB": "TiB",
    "unit.Mbps": "Mbps",
    "unit.Gbps": "Gbps",
    "unit.item": "個",
    "unit.kg": "公斤",
    "unit.tonne": "噸",

    "cur.HKD": "港元",
    "cur.CNY": "人民幣",
    "cur.USD": "美元",
    "cur.SGD": "新加坡元",
    "cur.EUR": "歐元",

    "round.half_up": "四捨五入",
    "round.half_even": "四捨六入五成雙",
    "round.down": "捨去",

    "doc.invoice": "發票",
    "doc.credit_note": "貸項通知單",
    "doc.receipt": "收據",

    "type.date": "日期",
    "type.text": "文字",
    "type.number": "數值",
    "type.yes_no": "是否",
    "type.list": "清單",
    "val.yes": "是",
    "val.no": "否",
    "val.refused": "被拒絕",

    "field.holder": "持有人",
    "field.amount": "金額",
    "field.due": "到期日",
    "field.quantity": "數量",
    "field.tier": "層級",
    "field.pledgee": "質權人",
    "field.parts": "各部分",
    "field.customer_location": "客戶所在地",
    "field.cooling_period": "冷卻期",

    "state.active": "正常",
    "state.proposed": "已提議",
    "state.pledged": "已質押",
    "state.paid": "已支付",
    "state.settled": "已結清",
    "state.frozen": "已凍結",
    "state.suspended": "已暫停",
    "state.terminated": "已終止",
    "state.cancelled": "已註銷",

    "actor.person": "真人",
    "actor.ai_agent": ["AI 代理", "AI代理"],
    "actor.device": "裝置",

    "role.we": "本公司",
    "role.customer": "客戶",
    "role.supplier": "供應商",
    "role.bank": "銀行",
    "role.issuer": "發行人",

    "expr.sum_of": "… 總和",
    "expr.count_of": "… 數目",
    "expr.at_most": "最多 …"
  },

  "messages": {
    "pack.syntax": "語言包不是有效的 CBOR 診斷記法：{detail}",
    "pack.too-large": "語言包有 {size} 位元組，上限為 {limit}",
    "pack.expected-map": "{path} 須為映射（map）",
    "pack.expected-text": "{path} 須為文字字串",
    "pack.expected-list": "{path} 須為清單",
    "pack.expected-integer": "{path} 須為非負整數",
    "pack.expected-boolean": "{path} 須為 true 或 false",
    "pack.unknown-key": "{path} 有未知的鍵 {key}",
    "pack.missing-key": "{path} 須有鍵 {key}",
    "pack.format": "不支援語言包格式 {value}；此編譯器讀取格式 1",
    "pack.edition": "不支援 Bo 第 {value} 版；此編譯器只認識第 1 版",
    "pack.bad-id": "{value} 不是有效的語言包代號：須以字母開頭，只可含字母、數字及單個連字號，最長 64 個字元",
    "pack.bad-language": "{value} 不是有效的語言標籤（BCP 47，例如 zh-Hant-HK）",
    "pack.bad-version": "版本須為 1 或以上，不可為 {value}",
    "pack.bad-text": "{path} 須為 1 至 200 位元組（月份名稱為 64，訊息及句子為 1,000），且不可含控制字元",
    "pack.bad-value": "{path} 不可為 {value}",
    "pack.too-many": "{path} 的項目多於 {limit} 個",
    "pack.unknown-concept": "{path}：{concept} 不是 Bo 第 1 版的概念",
    "pack.wrong-category": "{path}：{concept} 屬於 {category} 類別，不應放在此處",
    "pack.missing-keyword": "語言包 {pack} 未拼寫關鍵字 {concept}；每個語言包均須拼寫所有關鍵字",
    "pack.partial": "語言包 {pack} 未拼寫 {total} 個詞語中的 {missing} 個；這些詞語以英文讀取及顯示",
    "pack.bad-spelling": "{path}：{spelling} 不是有效的拼寫：須為一至四個以單個空格分隔的詞，每個詞不可長於 64 位元組，亦不可以數字開頭",
    "pack.bad-character": "{path}：{spelling} 含有 {character}，任何詞語均不可包含此字元",
    "pack.needs-hole": "{path}：{spelling} 須以 … 標示 {concept} 的參數位置（一次）",
    "pack.unexpected-hole": "{path}：{spelling} 不可含 …：{concept} 不接受參數",
    "pack.bad-form": "{path}：{form} 不是有效的詞形名稱（小寫英文字母，最多 16 個）",
    "pack.duplicate-spelling": "語言包 {pack} 給予 {spelling} 兩個意思：{concept} 及 {other}",
    "pack.conflict": "{spelling} 在語言包 {pack} 中解作 {meaning}，在語言包 {other_pack} 中卻解作 {other}；同一拼寫不可有兩個意思",
    "pack.ambiguous-attachment": "{spelling}（{meaning}）亦可讀作 {first} + {second}；請更改拼寫或收窄連寫規則",
    "pack.bad-attach": "{path}：{concept} 不可連寫：此語言包須把它拼寫為一個詞，… 只可在遠離相鄰詞的一側",
    "pack.unknown-category": "{path}：{category} 不是可連寫的類別",
    "pack.bad-punctuation": "{path}：{character} 不可作標點別名：須為任何詞語均不含的一個字元，代表 , : ( ) % \" = < > + - * / . _、數字或空格之一",
    "pack.bad-multiplier": "{path}：{value} 不是 10 至 10^18 之間的十的冪",
    "pack.bad-date": "{path}：{pattern} 不是有效的日期格式：欄位 Y、M（書寫時可用 MONTH 並提供十二個月份名稱）及 D 須各以大括號標示一次，欄位之間須有文字",
    "pack.unknown-message": "{path}：{code} 不是訊息代碼",
    "pack.unknown-sentence": "{path}：{id} 不是句子代號",
    "pack.bad-placeholder": "{path}：{placeholder} 不是此文字可用的佔位符",
    "pack.false-official": "語言包 {pack} 自稱官方，但並非此編譯器所附帶的官方語言包",
    "pack.duplicate-id": "有兩個語言包的代號同為 {pack}",
    "lex.too-large": "原始碼有 {size} 位元組，上限為 {limit}",
    "lex.utf8": "原始碼在此處不是有效的 UTF-8",
    "lex.invisible": "不可使用隱形字元 {character}：原始碼須與其顯示的內容一致",
    "lex.tab": "不可使用定位字元（Tab）；縮排及分隔詞語請用空格",
    "lex.indent-character": "縮排只可用空格，不可用 {character}",
    "lex.dedent": "此行的縮排與任何外層區塊均不相符",
    "lex.too-deep": "區塊的巢狀層數超過 {limit} 層",
    "lex.bad-character": "{character} 不可出現在此處：它不屬於任何詞語、數字或運算符",
    "lex.bad-number": "{text} 不是數字：_ 只可用於數字之間，小數點最多一個，且前後須有數字（5_000、0.10）",
    "lex.digit-comma": "{text}：逗號不可用作數字分組；請寫 {suggestion}",
    "lex.number-too-large": "{text} 的位數超出 Bo 可保存的範圍：去掉小數點後不可大於 18446744073709551615，小數最多 18 位",
    "lex.number-suffix": "{text} 中的數字後不可接 {suffix}：數字後可直接接倍數（萬），然後是單位、時間單位或貨幣（2TB、30日、500萬港元），再接「內」等詞",
    "lex.multiplier": "{word} 須緊隨其所乘的數字：500萬 或 500 萬",
    "lex.percent": "% 須緊隨其數字：5%",
    "lex.bad-date": "{text} 不是日期：請寫成 YYYY-MM-DD，年份為 1 至 9999，月份為 01 至 12，日子須為該月所有（2027-01-06）",
    "lex.unterminated-text": "此行的文字欠缺結束引號",
    "lex.text-too-long": "文字長於 {limit} 位元組",
    "lex.edition": "不支援 Bo 第 {value} 版；此編譯器讀取第 1 版",
    "lex.bad-edition": "首行標示版本：bo 之後只可接版本號碼（bo 1）",
    "lex.ambiguous": "{text} 可讀作 {first}，亦可讀作 {second}；Bo 從不猜測：請在詞與詞之間加空格",
    "lex.ambiguous-money": "{text} 中，貨幣夾在兩個數字之間，或數字夾在兩個貨幣之間，未能確定何者屬於何者：請把每個金額與其貨幣寫在一起，並把各金額分開",
    "lex.needs-space": "{text}：請在 {first} 與 {second} 之間加空格",
    "lex.bad-name": "{name} 不是有效的名稱：名稱須以字母開頭，其後可為字母、附加符號、數字或 _",
    "lex.name-too-long": "{name} 長於 {limit} 位元組",
    "lex.not-normalized": "{character} 在 Unicode 正規化下會改變：請改用合成後的字元，令看似相同的名稱確實相同",
    "lex.mixed-script": "{name} 混合了外觀相似的拉丁、希臘或西里爾字母：名稱只可使用其中一種文字",
    "lex.confusable": "{name} 看似 {other}，但兩者並不相同：請統一寫法，或改用外觀不同的名稱",
    "parse.top-level": "{found} 不可在此處開始一行：在任何區塊以外，每行須以 合約、訂約方、種類（資產、服務、資源、紀錄）、費用或稅、可、當 或 測試 開始",
    "parse.statement": "{found} 不可在動作的區塊內開始一行：可寫 須、如、否則、逐一、拒絕、設定欄位（持有人 = 銀行）、狀態轉變（正常 -> 已暫停）、動作（通知 客戶），或誰可提議（AI 代理 可 提議）",
    "parse.field": "{found} 不可出現在欄位中：區塊內每行先寫欄位，再寫其類型或數值（金額 港元、IP 1個），各部分以逗號分隔",
    "parse.step": "{found} 不可作為步驟的開頭：測試的每行是步驟，先寫訂約方（供應商 質押 予 銀行，可加 時間 日期、親身確認、由 AI 代理），或是預期結果（-> 已質押、-> 被拒絕）",
    "parse.trailing": "此行在 {found} 之前已經完整：請刪去它，或另起一行",
    "parse.unexpected-block": "這些行有縮排，但上一行並沒有開始任何區塊",
    "parse.empty-block": "{word} 須有其管轄的內容：在其下加上縮排的區塊；當、如 及 否則 亦可在同一行接一個語句",
    "parse.otherwise": "{word} 須緊接在相同縮排的 如 區塊之後",
    "parse.duplicate": "{word} 出現了兩次；只可寫一次",
    "parse.reserved": "{word} 已預留給日後版本的模組使用",
    "parse.too-deep": "此行的巢狀層數超過 {limit} 層（括號、運算符或 否則 如）",
    "parse.expected-name": "{after} 之後須有自訂名稱：關鍵字及詞彙中的詞語不可用作名稱",
    "parse.expected-action": "{after} 之後須有動作：詞彙中的動作（質押、轉讓）或自訂名稱",
    "parse.expected-party": "{after} 之後須有訂約方：角色（發行人、銀行、客戶）或自訂名稱",
    "parse.expected-value": "{after} 之後須有數值",
    "parse.expected-text": "{after} 之後須有以雙引號括住的文字",
    "parse.expected-state": "{after} 之後須有狀態：例如 已質押、自訂名稱，或測試中的 被拒絕",
    "parse.expected-set": "{after} 之後須有欄位及其數值：金額 = HKD 100，以逗號分隔",
    "parse.can": "{found} 不可接在此動作之後：可寫 由 訂約方、予 訂約方 或 連同 輸入項，每項最多一次",
    "parse.when": "當 之後須先寫事件，再寫動作：當 逾期 3日 暫停、當 到期前 7日 通知 客戶",
    "parse.each": "逐一 的寫法是 逐一 名稱 於 清單，要重複的各行寫在其下的區塊內",
    "parse.bare-condition": "單獨的條件不會產生作用：請在前面加上 須 或 如；如要設定欄位，請寫 欄位 = 數值",
    "parse.unclosed": "此 ( 在同一行內沒有對應的 )",
    "parse.missing-head": "{text} 是 {concept} 的結尾，但缺少其開頭的詞",
    "parse.missing-tail": "{text} 是 {concept} 的開頭，但數值之後缺少其結尾的詞",
    "parse.missing-argument": "{text}（{concept}）之前須有數值，例如 各部分 總和",
    "parse.chained-comparison": "比較不可串連：請寫 a < b 及 b < c，而非 a < b < c（在 {operator} 處）",
    "parse.phrase-operator": "並列的詞語不可直接以 {operator} 運算：請加上括號",
    "parse.ambiguous-name": "{name} 可以是名稱 {name}，亦可以是 {prefix} 加上 {rest}，因兩者均已宣告；Bo 從不猜測：請寫成 {prefix} {rest}（中間加空格），或把其中一個改名",
    "parse.undeclared-split": "{name} 在此是一個名稱，因為沒有任何地方宣告 {rest}；如要以 {prefix} 開始此行，請寫成 {prefix} {rest}（中間加空格）",
    "check.fragment": "沒有 合約 一行，因此此檔案按片段檢查；bo build 須有 合約 名稱",
    "check.no-parties": "此合約有動作，但沒有 訂約方 一行：請寫 訂約方，再列出各角色（訂約方 發行人, 供應商, 銀行）",
    "check.duplicate": "{name} 宣告了兩次；同一合約內每個名稱只有一個意思",
    "check.one-kind": "一份合約只描述一種實例；{name} 會是第二種：請另寫一份合約",
    "check.unknown-name": "{name} 未經宣告：它不是訂約方、欄位、輸入項、狀態，亦不是 逐一 給出的名稱",
    "check.unknown-party": "{party} 不是此合約的訂約方：請把它加入 訂約方 一行",
    "check.unknown-field": "實例沒有欄位 {field}：請在種類的區塊內宣告（金額 港元、到期日 日期）",
    "check.unknown-input": "{action} 沒有輸入項 {name}",
    "check.field-head": "{text} 不可用作欄位名稱：請用自訂名稱，或欄位、價格的詞語（金額、到期日、持有人、價格）",
    "check.field-needs-type": "{field} 須寫明類型或數值：金額 港元、到期日 日期、IP 1個",
    "check.field-type": "{field} 存放的是{expected_type}，而非{type}",
    "check.field-values": "{field} 只可有一個類型或數值；逗號之後的部分須是有標示的價格（超出 每GB HKD 0.10）",
    "check.not-a-value": "{text} 在此不是數值：數值可以是數目、金額、日期、文字、訂約方、欄位、輸入項，或可放條件之處的條件",
    "check.phrase": "Bo 無法從 {text} 讀出數值：並列的詞語可組成定期金額（每月 HKD 120）、單價（每GB HKD 0.10）、有標示的價格（超出 每GB HKD 0.10）、逾期 N，或 按 某欄位",
    "check.type": "{text} 是{type}，但此處須是{expected_type}",
    "check.operands": "{operator} 不可把{left_type}與{right_type}運算",
    "check.mixed-currencies": "{left_type}與{right_type}是不同貨幣；Bo 從不換算貨幣",
    "check.mixed-units": "{left_type}與{right_type}量度不同的東西，不可混合",
    "check.calendar": "{text} 把月或年與日或週混合：一個月沒有固定日數，因此 Bo 不會比較或相加",
    "check.precision": "{text} 比 Bo 保存的精度更細：金額至該貨幣的仙，單價至小數點後六位，比率至 0.0001%，數量至整數的位元組、每秒位元、個或克",
    "check.whole-number": "{text} 在此須是整數（表示比例請寫比率：150%）",
    "check.overflow": "{text} 太大：Bo 以 64 位元的整數保存每個數值，以其最小單位計",
    "check.zero-division": "{text} 除以零",
    "check.list-items": "{text} 的各項並非同一類型",
    "check.list-bound": "{text}：清單可有 1 至 {limit} 項",
    "check.set-constant": "{field} 是常數（區塊已給出其數值），任何動作都不可更改；如要讓動作更改，請改為宣告其類型（層級 數值）",
    "check.set-target": "{text} 不可設定：只有實例的欄位可以設定",
    "check.initial-state": "實例可以從 {states} 任何一個狀態開始，因為沒有狀態轉變通往它們；Bo 從不猜測：實例從唯一沒有狀態轉變通往的狀態開始，否則從 正常 開始",
    "check.unreachable-state": "從實例的開始狀態出發，沒有任何狀態轉變通往 {state}，因此沒有實例能到達此狀態",
    "check.needs-by": "由誰開始 {action}？自訂動作須寫 由 訂約方",
    "check.recursion": "{action} 經由它所做的動作又回到自身；合約從不遞迴",
    "check.permit": "{text}：第 1 版中，此類語句只有 AI 代理 可 提議",
    "check.subject": "{text}：在動作之內只有合約本身行事；訂約方的責任應寫在 當 規則中（當 到期日 發行人 支付）",
    "check.threshold-amount": "{text} 比較 {action} 的金額，但它沒有唯一的金額：請給它一個金額輸入項（連同 金額 港元），或給實例一個 金額 欄位，或改為比較欄位（須 金額 > HKD 100）",
    "check.when-event": "{text} 不是時間：當 規則於某日期（當 到期日）、到期前 N 或 逾期 N 觸發",
    "check.when-person": "{text} 須由真人作出，但 當 規則由排程裝置觸發：沒有人會親身確認或提議",
    "check.needs-due": "{text} 由到期日起計，但實例沒有到期日：請在種類的區塊內宣告 到期日 日期（有定期價格的服務於每期完結時到期）",
    "check.charge-field": "{text} 不是費用可有的一行：稅率、金額、適用、內含或另計、逐行、按單據、按某單據、捨入方式，或 從 日期 起 連同稅率",
    "check.charge-rate": "費用 {name} 須有稅率（稅率 5%）或金額",
    "check.charge-included": "請寫明 {name} 是內含於價格，還是另計：寫 內含 或 另計，只寫一次",
    "check.needs-executor": "{action} 要求執行器在賬本以外行事，此功能於 6b 步驟推出：bo check 接受它，但在此之前 bo build 會拒絕",
    "build.fragment": "此檔案沒有 合約 一行，屬片段：只有合約（合約 名稱）可以編譯",
    "build.standard-action": "{action} 是內置動作：其範本隨標準庫於日後版本的編譯器提供；現階段請宣告自訂動作（可 名稱 由 訂約方）",
    "build.executor": "{action} 要求執行器在賬本以外行事，此功能於 6b 步驟推出：已部署的程式碼永不改變，因此在此之前無法編譯",
    "build.time-rule": "{text}：當 規則尚未能編譯，將於日後版本的編譯器提供",
    "build.unsupported": "{text} 用到 {feature}，此版本的編譯器尚未能編譯",
    "build.name-taken": "編譯後的合約中有兩部分同名 {name}（函數、欄位、訂約方或輸入項）：請將其中之一改名",
    "build.name-too-long": "{name} 用於編譯後的程式碼太長：最多 {limit} 位元組",
    "build.too-many-functions": "合約的動作多於編譯後合約所容許的數目（{limit} 個函數）",
    "build.too-many-parties": "合約的訂約方及訂約方欄位多於編譯後合約所容許的數目（{limit} 個）",
    "build.too-many-fields": "合約的欄位多於編譯後合約所容許的數目（{limit} 個）",
    "build.too-many-inputs": "{action} 的輸入項多於編譯後動作所容許的數目（{limit} 個）",
    "build.too-many-events": "{action} 轉變狀態的次數多於一次調用可報告的數目（{limit} 個事件）",
    "build.too-large": "編譯後的合約會過大：某動作的程式碼，或其包含的文字、名稱及原因，超出合約的上限",
    "build.reject-text": "{text}：拒絕的文字不可以 bo: 開首，此標記屬編譯器本身的原因",
    "build.late-party": "{field} 以 {party} 開始，但 {party} 要待之後的動作才確定：請為 {field} 指定於建立時已確定的訂約方",
    "build.comments": "原始碼會連同其註釋（{count} 行）一併部署：各訂約方及任何驗證此合約的人均可閱讀",
    "run.input": "調用的輸入並非合約可讀取的內容：須為上限以內的確定性 CBOR",
    "run.overflow": "數值超出 Bo 可保存的範圍：以最小單位計的整數，64 位元",
    "run.division-by-zero": "除以零",
    "run.date": "日期不在公元 1 至 9999 年之內",
    "run.output": "結果過大：實例的狀態最多 64 KiB，調用的輸出最多 192 KiB",
    "run.consents": "此調用須取得超過 16 個賬本的同意",
    "run.function": "合約沒有此函數",
    "run.arguments": "參數並非由該函數輸入項組成的對照表",
    "run.argument": "參數 {name} 缺少，或類型不符",
    "run.state": "實例目前的狀態不容許 {action}",
    "run.requires": "{action} 的第 {number} 項要求未獲滿足",
    "run.in-person": "{action} 須由本人以通行密鑰或硬件密鑰證明親身在場",
    "run.party": "{party} 尚未確定賬本",
    "bo.truncated": "尚有其他問題；只顯示首 {limit} 個"
  },

  "sentences": {
    "contract": "合約：{name}",
    "parties": "訂約方：{parties}。",
    "can": "{party}可{action}。",
    "can-to": "{party}可{action}予{counterparty}。",
    "consent": "須經{party}同意。",
    "in-person": "{party}須以通行密鑰或硬件密鑰親身確認。",
    "agents-propose": "AI 代理可提議此項；須經真人批准方會生效。",
    "when": "當{event}時：{action}。",
    "reject": "否則拒絕：{message}",
    "recognized": "（按規則 {rule} 自動識別）",
    "type-number": "數值",
    "type-money": "{currency}金額",
    "type-any-money": "金額",
    "type-data": "數據量（MB、GB、TB、MiB、GiB、TiB）",
    "type-bandwidth": "頻寬（Mbps、Gbps）",
    "type-count": "個數",
    "type-mass": "重量（公斤、噸）",
    "type-any-quantity": "數量",
    "type-rate": "比率（%）",
    "type-date": "日期",
    "type-duration": "時間長度",
    "type-text": "文字",
    "type-yes-no": "是否",
    "type-party": "訂約方",
    "type-state": "狀態",
    "type-list": "最多 {limit} 項的清單，每項為{element}",
    "type-any-list": "清單",
    "type-unit-price": "每{unit}的{currency}價格",
    "type-recurring": "{period}{value}",
    "type-basis": "費用的計算依據",
    "type-unknown": "未知類型",
    "rule-R1": "詞彙所定義的欄位具有詞彙所定的類型：持有人及質權人為訂約方，到期日為日期，層級為數值，客戶所在地為文字，冷卻期為時間長度。",
    "rule-R2": "給出訂約方的欄位存放訂約方：每個實例以該訂約方開始，動作可以更改。",
    "rule-R3": "首次出現在 予 之後的角色由該動作確定，並須經其同意；其他角色於建立實例時確定。",
    "rule-R4": "實例從唯一沒有狀態轉變通往的狀態開始；如沒有，則從 正常 開始。",
    "rule-R5": "實例的狀態就是其狀態轉變所提及的狀態。",
    "rule-R6": "超過 N 比較動作唯一的金額；未寫單位的 N 採用該金額的單位。",
    "rule-R7": "用作條件的狀態，表示實例正處於該狀態。",
    "rule-R8": "更改存放訂約方的欄位，即從該訂約方取去，因此須經該訂約方同意；如由該訂約方開始動作，其提交即為同意。",
    "rule-R9": "動作提及訂約方的 當 規則，表示該訂約方的責任：它決定實例何時到期及逾期，不會自動執行任何動作。",
    "rule-R10": "通知，以及服務的訂購、升級、降級、暫停、恢復、終止、分配及收回，須由執行器在賬本以外執行。",
    "rule-R11": "有定期價格的服務，於每個已付期間完結時到期。",
    "rule-R12": "客戶所在地是每個實例存放的文字，於建立實例時給出。",
    "rule-R13": "親身確認 要求開始動作的訂約方以通行密鑰或硬件密鑰證明本人在場。",
    "rule-R14": "AI 代理可在其授權範圍內開始動作，除非該動作寫明 AI 代理 可 提議；屆時代理只可提議，須經真人批准。",
    "rule-R15": "各部分是一份金額清單，單位與實例的金額相同。",
    "rule-R16": "清單最多有 16 項，除非以 最多 N 另行規定。",
    "rule-R17": "金額、數量或比率的乘積或商數捨入至最小單位，採用四捨五入（遠離零）。",
    "rule-R18": "未經宣告的名稱，如與文字比較，即視為該文字。"
  }
}
