# Bo language pack: Traditional Chinese, Hong Kong usage (official).
#
# Hong Kong terms and character forms (zh-Hant-HK), not Taiwan's: 賬 not 帳,
# 紀錄, 合約, 訂約方, 予, 須, 及, 今日, 清單. A native Hong Kong reviewer signs
# off the words before the first release. Spellings with "…" mark where the
# argument goes; the digest covers the canonical CBOR, not this layout.

{
  "format": 1,
  "id": "zh-Hant-HK",
  "version": 4,
  "language": "zh-Hant-HK",
  "name": "繁體中文（香港）",
  "official": true,
  "edition": 1,

  "reading": {
    "separation": "none",
    # 可轉讓, 須親身確認, 當逾期, 如逾期: these keywords may attach to the
    # word after them, when that word is in the vocabulary or declared in
    # the contract (可用率 stays one word).
    "prefixes": ["kw.can", "kw.requires", "kw.when", "kw.if"],
    "attach": [
      # 30日內
      {"word": "cond.within", "after": ["time", "unit"]}
    ],
    "punctuation": {
      "，": ",", "、": ",", "：": ":", "（": "(", "）": ")", "％": "%",
      "\u3000": " ",
      "０": "0", "１": "1", "２": "2", "３": "3", "４": "4",
      "５": "5", "６": "6", "７": "7", "８": "8", "９": "9"
    },
    "multipliers": {"萬": 10000, "億": 100000000},
    "dates": {"read": ["{Y}年{M}月{D}日"], "write": "{Y}年{M}月{D}日"}
  },

  "keywords": {
    "kw.contract": "合約",
    "kw.parties": "訂約方",
    "kw.can": "可",
    "kw.by": "由",
    "kw.to": "予",
    "kw.with": "連同",
    "kw.requires": "須",
    "kw.when": "當",
    "kw.if": "如",
    "kw.otherwise": "否則",
    "kw.and": "及",
    "kw.or": "或",
    "kw.not": "非",
    "kw.each": "逐一",
    "kw.in": "於",
    "kw.reject": "拒絕",
    "kw.test": "測試",
    "kw.use": "使用"
  },

  "vocabulary": {
    "kind.thing": "物件",

    "act.issue": "發出",
    "act.transfer": "轉讓",
    "act.cancel": "註銷",
    "act.suspend": "暫停",
    "act.resume": "恢復",
    "act.terminate": "終止",
    "act.approve": "批准",
    "act.propose": "提議",
    "act.notify": "通知",
    "act.create": "建立",

    "cond.over": "超過 …",
    "cond.in_person": "親身確認",
    "cond.consent_of": "經 … 同意",
    "cond.overdue": "逾期",
    "cond.before_due": "到期前 …",
    "cond.within": "… 內",

    "time.day": "日",
    "time.week": "週",
    "time.month": "個月",
    "time.year": "年",
    "time.daily": "每日",
    "time.weekly": "每週",
    "time.monthly": "每月",
    "time.yearly": "每年",
    "time.now": "現時",
    "time.today": "今日",
    "time.at": "時間 …",

    "unit.MB": "MB",
    "unit.GB": "GB",
    "unit.TB": "TB",
    "unit.MiB": "MiB",
    "unit.GiB": "GiB",
    "unit.TiB": "TiB",
    "unit.Mbps": "Mbps",
    "unit.Gbps": "Gbps",
    "unit.item": "個",
    "unit.kg": "公斤",
    "unit.tonne": "噸",
    "unit.celsius": "攝氏度",

    "cur.HKD": "港元",
    "cur.CNY": "人民幣",
    "cur.USD": "美元",
    "cur.SGD": "新加坡元",
    "cur.EUR": "歐元",

    "round.half_up": "四捨五入",
    "round.half_even": "四捨六入五成雙",
    "round.down": "捨去",

    "type.date": "日期",
    "type.text": "文字",
    "type.number": "數值",
    "type.yes_no": "是否",
    "type.list": "清單",
    "val.yes": "是",
    "val.no": "否",
    "val.refused": "被拒絕",
    "val.none": "無",
    "val.pending_approval": "待批准",

    "field.holder": "持有人",
    "field.amount": "金額",
    "field.due": "到期日",
    "field.quantity": "數量",
    "field.parts": "各部分",
    "field.recipients": "各接收方",
    "field.utc_offset": ["UTC 時差", "UTC時差"],

    "state.active": "正常",
    "state.proposed": "已提議",
    "state.suspended": "已暫停",
    "state.terminated": "已終止",
    "state.cancelled": "已註銷",
    "state.divided": "已拆分",

    "actor.person": "真人",
    "actor.ai_agent": ["AI 代理", "AI代理"],
    "actor.device": "裝置",
    "actor.keeper": "排程器",

    "role.we": ["我方", "本公司"],
    "role.counterparty": "相對方",

    "expr.sum_of": "… 總和",
    "expr.count_of": "… 數目",
    "expr.at_most": "最多 …",
    "expr.previous_state": "原先狀態"
  },

  "messages": {
    "pack.syntax": "語言包不是有效的 CBOR 診斷記法：{detail}",
    "pack.too-large": "語言包有 {size} 位元組，上限為 {limit}",
    "pack.expected-map": "{path} 須為映射（map）",
    "pack.expected-text": "{path} 須為文字字串",
    "pack.expected-list": "{path} 須為清單",
    "pack.expected-integer": "{path} 須為非負整數",
    "pack.expected-boolean": "{path} 須為 true 或 false",
    "pack.unknown-key": "{path} 有未知的鍵 {key}",
    "pack.missing-key": "{path} 須有鍵 {key}",
    "pack.format": "不支援語言包格式 {value}；此編譯器讀取格式 1",
    "pack.edition": "不支援 Bo 第 {value} 版；此編譯器只認識第 1 版",
    "pack.bad-id": "{value} 不是有效的語言包代號：須以字母開頭，只可含字母、數字及單個連字號，最長 64 個字元",
    "pack.bad-language": "{value} 不是有效的語言標籤（BCP 47，例如 zh-Hant-HK）",
    "pack.bad-version": "版本須為 1 或以上，不可為 {value}",
    "pack.bad-text": "{path} 須為 1 至 200 位元組（月份名稱為 64，訊息及句子為 1,000），且不可含控制字元",
    "pack.bad-value": "{path} 不可為 {value}",
    "pack.too-many": "{path} 的項目多於 {limit} 個",
    "pack.unknown-concept": "{path}：{concept} 不是 Bo 第 1 版的概念",
    "pack.wrong-category": "{path}：{concept} 屬於 {category} 類別，不應放在此處",
    "pack.missing-keyword": "語言包 {pack} 未拼寫關鍵字 {concept}；每個語言包均須拼寫所有關鍵字",
    "pack.partial": "語言包 {pack} 未拼寫 {total} 個詞語中的 {missing} 個；這些詞語以英文讀取及顯示",
    "pack.bad-spelling": "{path}：{spelling} 不是有效的拼寫：須為一至四個以單個空格分隔的詞，每個詞不可長於 64 位元組，亦不可以數字開頭",
    "pack.bad-character": "{path}：{spelling} 含有 {character}，任何詞語均不可包含此字元",
    "pack.needs-hole": "{path}：{spelling} 須以 … 標示 {concept} 的參數位置（一次）",
    "pack.unexpected-hole": "{path}：{spelling} 不可含 …：{concept} 不接受參數",
    "pack.bad-form": "{path}：{form} 不是有效的詞形名稱（小寫英文字母，最多 16 個）",
    "pack.duplicate-spelling": "語言包 {pack} 給予 {spelling} 兩個意思：{concept} 及 {other}",
    "pack.conflict": "{spelling} 在語言包 {pack} 中解作 {meaning}，在語言包 {other_pack} 中卻解作 {other}；同一拼寫不可有兩個意思",
    "pack.ambiguous-attachment": "{spelling}（{meaning}）亦可讀作 {first} + {second}；請更改拼寫或收窄連寫規則",
    "pack.bad-attach": "{path}：{concept} 不可連寫：此語言包須把它拼寫為一個詞，… 只可在遠離相鄰詞的一側",
    "pack.unknown-category": "{path}：{category} 不是可連寫的類別",
    "pack.bad-punctuation": "{path}：{character} 不可作標點別名：須為任何詞語均不含的一個字元，代表 , : ( ) % \" = < > + - * / . _、數字或空格之一",
    "pack.bad-multiplier": "{path}：{value} 不是 10 至 10^18 之間的十的冪",
    "pack.bad-date": "{path}：{pattern} 不是有效的日期格式：欄位 Y、M（書寫時可用 MONTH 並提供十二個月份名稱）及 D 須各以大括號標示一次，欄位之間須有文字",
    "pack.unknown-message": "{path}：{code} 不是訊息代碼",
    "pack.unknown-sentence": "{path}：{id} 不是句子代號",
    "pack.bad-placeholder": "{path}：{placeholder} 不是此文字可用的佔位符",
    "pack.false-official": "語言包 {pack} 自稱官方，但並非此編譯器所附帶的官方語言包",
    "pack.duplicate-id": "有兩個語言包的代號同為 {pack}",
    "vocab.syntax": "詞彙包不是有效的 CBOR 診斷記法：{detail}",
    "vocab.too-large": "詞彙包有 {size} 位元組，上限為 {limit}",
    "vocab.format": "不支援詞彙包格式 {value}；此編譯器讀取格式 1",
    "vocab.bad-id": "{value} 不是有效的詞彙包代號：只可含小寫 ASCII 字母、數字及 _，須以字母開頭，最長 32 個字元",
    "vocab.official-id": "{value} 是 Bo 核心或官方詞彙包（commerce、finance、services）的代號：請為此詞彙包另取代號",
    "vocab.bad-language": "{value} 不是語言包的代號（en、zh-Hant-HK、zh-Hans-CN 或自訂的語言包）",
    "vocab.bad-requires": "{path}：不可要求 {value}：請寫另一個詞彙包的代號，每個只寫一次",
    "vocab.bad-concept": "{path}：{concept} 不是概念代號：須為類別前綴（act、field、state、role、unit）、一個點，再加由 ASCII 字母、數字及 _ 組成的名稱",
    "vocab.category": "{path}：自訂詞彙包不可定義 {category} 類別的詞語，此類別只屬編譯器的機制：自訂詞彙包可定義動作、欄位、狀態、角色及單位",
    "vocab.shadows": "{path}：{concept} 的名稱會與 Bo 核心或官方詞彙包的詞語 {other} 相同：請另取名稱",
    "vocab.argument": "{path}：自訂詞彙包不可定義帶參數的詞語",
    "vocab.type": "{path}：{value} 不是欄位可用的類型：party、date、number、text、duration、parties、quantity、list 或 amount",
    "vocab.flag": "{path}：只有類型為 party 的欄位可標示 added 或 taking",
    "vocab.unit": "{path}：單位須有量綱（data、bandwidth、count、mass 或 temperature）及比例，即該量綱最小單位的 1 至 10^15 倍",
    "vocab.bad-terms": "{path}：標準條款須為 Bo 原始碼：一段文字，或其逐行文字（每行不可含換行），最多 64 KiB",
    "vocab.unspelled": "語言 {language} 未拼寫 {concept}：每種語言都須拼寫詞彙包的全部詞語",
    "vocab.not-own": "{path}：{concept} 不是此詞彙包的概念",
    "vocab.duplicate-spelling": "詞彙包 {pack} 給予 {spelling} 兩個意思：{concept} 及 {other}",
    "vocab.bad-attach": "{path}：{concept} 不可連寫：須把它拼寫為一個詞，… 只可在遠離相鄰詞的一側",
    "vocab.conflict": "{spelling} 是詞彙包 {pack} 的詞語，但已解作 {meaning}：請改用其他拼寫",
    "vocab.duplicate-id": "有兩個詞彙包的代號同為 {pack}",
    "vocab.unknown-requires": "詞彙包 {pack} 要求 {other}，但它既非官方詞彙包，亦未提供（請以 --vocab 提供）",
    "vocab.cycle": "詞彙包 {pack} 經由其要求的詞彙包，最終要求其自身",
    "vocab.no-language": "詞彙包 {pack} 以 {language} 拼寫其詞語，但此處讀取的語言包沒有此代號：這些拼寫不會讀取",
    "vocab.terms": "詞彙包 {pack} 的標準條款無法讀取：第 {line} 行，{code}（bo vocab check 可顯示原因）",
    "vocab.terms-clause": "詞彙包 {pack} 標準條款的第 {line} 行不是其動作的條款：此處每一條須為 can ACTION，ACTION 為此詞彙包定義的動作",
    "lex.too-large": "原始碼有 {size} 位元組，上限為 {limit}",
    "lex.utf8": "原始碼在此處不是有效的 UTF-8",
    "lex.invisible": "不可使用隱形字元 {character}：原始碼須與其顯示的內容一致",
    "lex.tab": "不可使用定位字元（Tab）；縮排及分隔詞語請用空格",
    "lex.indent-character": "縮排只可用空格，不可用 {character}",
    "lex.dedent": "此行的縮排與任何外層區塊均不相符",
    "lex.too-deep": "區塊的巢狀層數超過 {limit} 層",
    "lex.bad-character": "{character} 不可出現在此處：它不屬於任何詞語、數字或運算符",
    "lex.bad-number": "{text} 不是數字：_ 只可用於數字之間，小數點最多一個，且前後須有數字（5_000、0.10）",
    "lex.digit-comma": "{text}：逗號不可用作數字分組；請寫 {suggestion}",
    "lex.number-too-large": "{text} 的位數超出 Bo 可保存的範圍：去掉小數點後不可大於 18446744073709551615，小數最多 18 位",
    "lex.number-suffix": "{text} 中的數字後不可接 {suffix}：數字後可直接接倍數（萬），然後是單位、時間單位或貨幣（2TB、30日、500萬港元），再接「內」等詞",
    "lex.multiplier": "{word} 須緊隨其所乘的數字：500萬 或 500 萬",
    "lex.percent": "% 須緊隨其數字：5%",
    "lex.bad-date": "{text} 不是日期：請寫成 YYYY-MM-DD，年份為 1 至 9999，月份為 01 至 12，日子須為該月所有（2027-01-06）",
    "lex.unterminated-text": "此行的文字欠缺結束引號",
    "lex.text-too-long": "文字長於 {limit} 位元組",
    "lex.edition": "不支援 Bo 第 {value} 版；此編譯器讀取第 1 版",
    "lex.bad-edition": "首行標示版本：bo 之後只可接版本號碼（bo 1）",
    "lex.ambiguous": "{text} 可讀作 {first}，亦可讀作 {second}；Bo 從不猜測：請在詞與詞之間加空格",
    "lex.ambiguous-money": "{text} 中，貨幣夾在兩個數字之間，或數字夾在兩個貨幣之間，未能確定何者屬於何者：請把每個金額與其貨幣寫在一起，並把各金額分開",
    "lex.needs-space": "{text}：請在 {first} 與 {second} 之間加空格",
    "lex.bad-name": "{name} 不是有效的名稱：名稱須以字母開頭，其後可為字母、附加符號、數字或 _",
    "lex.name-too-long": "{name} 長於 {limit} 位元組",
    "lex.not-normalized": "{character} 在 Unicode 正規化下會改變：請改用合成後的字元，令看似相同的名稱確實相同",
    "lex.mixed-script": "{name} 混合了外觀相似的拉丁、希臘或西里爾字母：名稱只可使用其中一種文字",
    "lex.confusable": "{name} 看似 {other}，但兩者並不相同：請統一寫法，或改用外觀不同的名稱",
    "parse.top-level": "{found} 不可在此處開始一行：在任何區塊以外，每行須以 使用、合約、訂約方、種類（物件；或配合其詞彙包的資產、服務、資源）、費用或稅、可、當 或 測試 開始",
    "parse.statement": "{found} 不可在動作的區塊內開始一行：可寫 須、如、否則、逐一、拒絕、設定欄位（持有人 = 銀行）、狀態轉變（正常 -> 已暫停）、動作（通知 客戶），或誰可提議（AI 代理 可 提議）",
    "parse.field": "{found} 不可出現在欄位中：區塊內每行先寫欄位，再寫其類型或數值（金額 港元、IP 1個），各部分以逗號分隔",
    "parse.step": "{found} 不可作為步驟的開頭：測試的每行是步驟，先寫訂約方（供應商 質押 予 銀行，可加 時間 日期、親身確認、由 AI 代理），或是預期結果（-> 已質押、-> 被拒絕）",
    "parse.trailing": "此行在 {found} 之前已經完整：請刪去它，或另起一行",
    "parse.unexpected-block": "這些行有縮排，但上一行並沒有開始任何區塊",
    "parse.empty-block": "{word} 須有其管轄的內容：在其下加上縮排的區塊；當、如 及 否則 亦可在同一行接一個語句",
    "parse.otherwise": "{word} 須緊接在相同縮排的 如 區塊之後",
    "parse.duplicate": "{word} 出現了兩次；只可寫一次",
    "parse.reserved": "{word} 用於宣告詞彙包，須在任何區塊以外自成一行：使用 finance",
    "parse.too-deep": "此行的巢狀層數超過 {limit} 層（括號、運算符或 否則 如）",
    "parse.expected-name": "{after} 之後須有自訂名稱：關鍵字及詞彙中的詞語不可用作名稱",
    "parse.expected-action": "{after} 之後須有動作：詞彙中的動作（質押、轉讓）或自訂名稱",
    "parse.expected-party": "{after} 之後須有訂約方：角色（發行人、銀行、客戶）或自訂名稱",
    "parse.expected-value": "{after} 之後須有數值",
    "parse.expected-text": "{after} 之後須有以雙引號括住的文字",
    "parse.expected-state": "{after} 之後須有狀態：例如 已質押、自訂名稱，或測試中的 被拒絕",
    "parse.expected-set": "{after} 之後須有欄位及其數值：金額 = HKD 100，以逗號分隔",
    "parse.can": "{found} 不可接在此動作之後：可寫 由 訂約方、予 訂約方 或 連同 輸入項，每項最多一次",
    "parse.when": "當 之後須先寫事件，再寫動作：當 逾期 3日 暫停、當 到期前 7日 通知 客戶",
    "parse.each": "逐一 的寫法是 逐一 名稱 於 清單，要重複的各行寫在其下的區塊內",
    "parse.bare-condition": "單獨的條件不會產生作用：請在前面加上 須 或 如；如要設定欄位，請寫 欄位 = 數值",
    "parse.unclosed": "此 ( 在同一行內沒有對應的 )",
    "parse.missing-head": "{text} 是 {concept} 的結尾，但缺少其開頭的詞",
    "parse.missing-tail": "{text} 是 {concept} 的開頭，但數值之後缺少其結尾的詞",
    "parse.missing-argument": "{text}（{concept}）之前須有數值，例如 各部分 總和",
    "parse.chained-comparison": "比較不可串連：請寫 a < b 及 b < c，而非 a < b < c（在 {operator} 處）",
    "parse.phrase-operator": "並列的詞語不可直接以 {operator} 運算：請加上括號",
    "parse.ambiguous-name": "{name} 可以是名稱 {name}，亦可以是 {prefix} 加上 {rest}，因兩者均已宣告；Bo 從不猜測：請寫成 {prefix} {rest}（中間加空格），或把其中一個改名",
    "parse.undeclared-split": "{name} 在此是一個名稱，因為沒有任何地方宣告 {rest}；如要以 {prefix} 開始此行，請寫成 {prefix} {rest}（中間加空格）",
    "check.fragment": "沒有 合約 一行，因此此檔案按片段檢查；bo build 須有 合約 名稱",
    "check.no-parties": "此合約有動作，但沒有 訂約方 一行：請寫 訂約方，再列出各角色（訂約方 發行人, 供應商, 銀行）",
    "check.unknown-pack": "使用 {pack}：沒有此代號的詞彙包；官方詞彙包為 commerce、finance 及 services，自訂詞彙包以 --vocab FILE 提供",
    "check.pack-not-used": "{word} 屬於 {pack} 詞彙包，但原始碼沒有使用該詞彙包：請在開首寫 使用 {pack}",
    "check.pack-requires": "使用 {pack} 亦須 使用 {other}：該詞彙包要求它",
    "check.duplicate": "{name} 宣告了兩次；同一合約內每個名稱只有一個意思",
    "check.one-kind": "一份合約只描述一種實例；{name} 會是第二種：請另寫一份合約",
    "check.unknown-name": "{name} 未經宣告：它不是訂約方、欄位、輸入項、狀態，亦不是 逐一 給出的名稱",
    "check.unknown-party": "{party} 不是此合約的訂約方：請把它加入 訂約方 一行",
    "check.unknown-field": "實例沒有欄位 {field}：請在種類的區塊內宣告（金額 港元、到期日 日期）",
    "check.unknown-input": "{action} 沒有輸入項 {name}",
    "check.field-head": "{text} 不可用作欄位名稱：請用自訂名稱，或欄位、價格的詞語（金額、到期日、持有人、價格）",
    "check.default-field": "{field} 不可設預設值：只有建立實例時給出的實例欄位可設預設值；常數有其數值，訂約方欄位以其訂約方開始，單據由其各行組成",
    "check.default-value": "{text} 不可作預設值：預設值須為直接寫出、屬於該欄位類型的數值：0、港元 0、否、「未定」、2027-01-01，或由這些組成的列表",
    "check.field-needs-type": "{field} 須寫明類型或數值：金額 港元、到期日 日期、IP 1個",
    "check.field-type": "{field} 存放的是{expected_type}，而非{type}",
    "check.field-values": "{field} 只可有一個類型或數值；逗號之後的部分須是有標示的價格（超出 每GB HKD 0.10）",
    "check.not-a-value": "{text} 在此不是數值：數值可以是數目、金額、日期、文字、訂約方、欄位、輸入項，或可放條件之處的條件",
    "check.phrase": "Bo 無法從 {text} 讀出數值：並列的詞語可組成定期金額（每月 HKD 120）、單價（每GB HKD 0.10）、有標示的價格（超出 每GB HKD 0.10）、逾期 N，或 按 某欄位",
    "check.type": "{text} 是{type}，但此處須是{expected_type}",
    "check.operands": "{operator} 不可把{left_type}與{right_type}運算",
    "check.mixed-currencies": "{left_type}與{right_type}是不同貨幣；Bo 從不換算貨幣",
    "check.mixed-units": "{left_type}與{right_type}量度不同的東西，不可混合",
    "check.calendar": "{text} 把月或年與日或週混合：一個月沒有固定日數，因此 Bo 不會比較或相加",
    "check.precision": "{text} 比 Bo 保存的精度更細：金額至該貨幣的仙，單價至小數點後六位，比率至 0.0001%，數量至整數的位元組、每秒位元、個或克，溫度至百分之一度",
    "check.whole-number": "{text} 在此須是整數（表示比例請寫比率：150%）",
    "check.overflow": "{text} 太大：Bo 以 64 位元的整數保存每個數值，以其最小單位計",
    "check.zero-division": "{text} 除以零",
    "check.list-items": "{text} 的各項並非同一類型",
    "check.list-bound": "{text}：清單可有 1 至 {limit} 項",
    "check.each-body": "{text}：逐一 之下的區塊每項執行一次，故不可轉變狀態或執行動作；請移至 逐一 之外",
    "check.set-constant": "{field} 是常數（區塊已給出其數值），任何動作都不可更改；如要讓動作更改，請改為宣告其類型（層級 數值）",
    "check.set-target": "{text} 不可設定：只有實例的欄位可以設定",
    "check.initial-state": "實例可以從 {states} 任何一個狀態開始，因為沒有狀態轉變通往它們；Bo 從不猜測：實例從唯一沒有狀態轉變通往的狀態開始，否則從 正常 開始",
    "check.unreachable-state": "從實例的開始狀態出發，沒有任何狀態轉變通往 {state}，因此沒有實例能到達此狀態",
    "check.needs-by": "由誰開始 {action}？自訂動作須寫 由 訂約方",
    "check.recursion": "{action} 經由它所做的動作又回到自身；合約從不遞迴",
    "check.permit": "{text}：第 1 版中，此類語句只有 AI 代理 可 提議",
    "check.subject": "{text}：在動作之內只有合約本身行事；訂約方的責任應寫在 當 規則中（當 到期日 發行人 支付）",
    "check.threshold-amount": "{text} 比較 {action} 的金額，但它沒有唯一的金額：請給它一個金額輸入項（連同 金額 港元），或給實例一個 金額 欄位，或改為比較欄位（須 金額 > HKD 100）",
    "check.standard-by": "{action} 是內置動作，按其標準條款由 {party} 發起；如要由其他訂約方發起，請以自訂名稱複製此動作（cexchain bo stdlib show {action}）",
    "check.standard-to": "按標準條款，{action} 沒有相對方，因此不可寫 予；如要加上相對方，請以自訂名稱複製此動作（cexchain bo stdlib show {action}）",
    "check.standard-change": "{text}：{action} 的狀態轉變，以及其標準條款所更改的欄位，均屬標準條款；如要更改，請以自訂名稱複製此動作（cexchain bo stdlib show {action}）",
    "check.standard-field": "{action} 的標準條款使用欄位 {field}，每個實例都須存放此欄位，並可由動作更改：請在種類的區塊內宣告它及其類型",
    "check.standard-unreachable": "{action} 永遠無法發起：按其標準條款，它只可從 {states} 開始，但此合約的實例永不會處於該狀態",
    "check.when-event": "{text} 不是時間：當 規則於某日期（當 到期日、當 到期日 + 3日）、到期前 N、逾期或逾期 N 觸發，或於實例處於某狀態滿 N 時觸發（當 已暫停 30日），其他條件以 及 連接",
    "check.when-person": "{text} 須由真人作出，但 當 規則由排程器調用：沒有人會親身確認或提議",
    "check.needs-due": "{text} 由到期日起計，但實例沒有到期日：請在種類的區塊內宣告 到期日 日期（有定期價格的服務於每期完結時到期）",
    "check.when-action": "當 規則不能執行 {action}：排程器的調用不帶參數，而 {action} 須指明相對方或附帶輸入項",
    "check.utc-offset": "{text} 不是 UTC 時差：請寫成文字，例如 \"+08:00\" 或 \"-05:30\"，介乎 -14:00 至 +14:00",
    "check.charge-field": "{text} 不是費用可有的一行：稅率、金額、適用、內含或另計、逐行、按單據、按某單據、捨入方式，或 從 日期 起 連同稅率",
    "check.charge-rate": "費用 {name} 須有稅率（稅率 5%）或金額（金額 港元 20），但不可兩者皆有",
    "check.charge-included": "請寫明 {name} 是內含於價格，還是另計：寫 內含 或 另計，只寫一次",
    "check.document": "{field} 存放單據的各行：請在種類的區塊內宣告一個這樣的欄位，為同一貨幣的金額清單（發票 清單 港元）",
    "check.charge-document": "費用 {name} 按單據計算，但沒有欄位存放單據：請宣告一個以單據命名的欄位，例如 發票 清單 港元",
    "check.charge-twice": "{text}：費用 {name} 已寫過這一項；只寫一次",
    "check.charge-on": "{name} 不可按 {other} 計算：費用按價格及寫於其前的費用計算（逐行計算者只可按逐行計算的費用），內含的費用及定額只按價格計算",
    "check.charge-rounding": "{name} 是定額，不會捨入：請勿為其寫捨入方式",
    "check.charge-bill": "{name} 每份{document}捨入一次，但合約的單據並非{document}",
    "check.needs-executor": "{action} 要求執行器在賬本以外行事，此功能於 6b 步驟推出：bo check 接受它，但在此之前 bo build 會拒絕",
    "check.test-start": "測試須以建立實例開始：訂約方 {action} 連同 欄位 = 數值, …；建立實例的一方即所屬賬本，由其賬本執行合約",
    "check.test-again": "每個測試只在第一步建立一次實例",
    "check.test-creation": "{text}：此合約的實例以 {action} 建立（資產用 發出，其他用 建立）",
    "check.test-home": "實例由其所屬賬本 {party} 建立：角色 {party} 即執行合約的賬本",
    "check.test-action": "{action} 不是此合約的動作：步驟須執行合約宣告的動作（可 …），或建立實例",
    "check.test-party": "{text} 不是訂約方：步驟須指明合約的訂約方，或只在測試中使用的賬本（bank1）",
    "check.test-to": "{action} 沒有相對方，因此執行它的步驟不可指明相對方：請刪去 予",
    "check.test-counterparty": "{action} 的相對方是 {party}，於建立實例時確定賬本：請寫 予 {party}",
    "check.test-signer": "{text}：步驟可 由 AI 代理（由代理簽署），或 親身確認（由本人證明親身在場），但不可兩者兼有，由 亦不可指明其他人",
    "check.test-step": "{text}：除 予 及 連同 外，步驟只可有 時間 日期、親身確認 及 由 AI 代理，每項一次",
    "check.test-time": "{text}：時間 之後須寫 1970-01-01 以後的日期（時間 2027-01-06）",
    "check.test-time-back": "{text} 早於之前的步驟：測試中的時間不會倒退",
    "check.test-value": "{text}：測試須照寫每個數值：數目、金額、數量、日期、時間長度、比率、文字，或 是、否",
    "check.test-missing": "{action} 須有 {name}：請以 {name} = 數值 給出",
    "check.test-expect": "{text} 不是步驟可預期的結果：請寫合約的狀態（-> signed）、被拒絕（-> 被拒絕，或於引號內附上原因），或調用等待的同意（-> 經 銀行 同意）；欄位的數值寫於逗號之後（-> signed, fee = 港元 5）",
    "check.test-field": "{name} 不是實例持有的欄位：步驟只可預期調用後實例欄位的數值（-> delivered, fee = 港元 4_000），而常數永不改變",
    "check.test-fields": "{text}：只有獲接納的調用可預期欄位的數值（-> delivered, fee = 港元 4_000，或 -> fee = 港元 0），被拒絕、正等待同意或保留為提議的調用則不可",
    "check.test-expect-step": "預期結果（->）須緊隨其所屬的步驟，且只可有一個",
    "check.test-reason": "{text}：只有 被拒絕 可附上原因",
    "check.test-proposal": "-> 待批准：只有由 AI 代理調用、而 AI 代理只可提議的動作（AI 代理 可 提議），才會保留為提議；{action} 並非此類動作",
    "check.test-needs-to": "{action} 的相對方由每次調用指明：請寫 予 訂約方（供應商 轉讓 予 factor1）",
    "check.test-rule": "沒有 當 規則執行 {action}：排程器步驟須寫出 當 規則所執行的動作（排程器 暫停）",
    "check.test-part": "{text}：步驟以持有人指明所處理的實例（發行人 支付 小廠甲）：只可指明一個訂約方，而合約的實例須有持有人",
    "check.parts-place": "{text}：動作只可在本身的區塊內發出各部分一次（不可在 如 或 逐一 之下），當 規則則不可發出",
    "check.parts-shape": "{text}：發出 各部分 予 各接收方 [連同 欄位 = 值, ...]：各部分須為金額清單，單位與實例的金額相同；各接收方須為訂約方清單；連同 只可設定實例的欄位，金額及持有人除外",
    "check.parts-instance": "{action} 會發出各部分，因此每個實例須有金額（金錢或數量）及持有人，且不可有賬單",
    "check.test-keeper": "{text}：排程器調用 當 規則時不帶其他內容：不可寫 予、連同、親身確認或由 AI 代理",
    "build.fragment": "此檔案沒有 合約 一行，屬片段：只有合約（合約 名稱）可以編譯",
    "build.standard-action": "{action} 是內置動作：其範本隨標準庫於日後版本的編譯器提供；現階段請宣告自訂動作（可 名稱 由 訂約方）",
    "build.executor": "{action} 要求執行器在賬本以外行事，此功能於 6b 步驟推出：已部署的程式碼永不改變，因此在此之前無法編譯",
    "build.time-rule": "{text}：此 當 規則尚未能編譯：服務於每個已付期間完結時到期，須由執行者（第 6b 步）追蹤",
    "build.unsupported": "{text} 用到 {feature}，此版本的編譯器尚未能編譯",
    "build.name-taken": "編譯後的合約中有兩部分同名 {name}（函數、欄位、訂約方或輸入項）：請將其中之一改名",
    "build.name-too-long": "{name} 用於編譯後的程式碼太長：最多 {limit} 位元組",
    "build.too-many-functions": "合約的動作多於編譯後合約所容許的數目（{limit} 個函數）",
    "build.too-many-parties": "合約的訂約方及訂約方欄位多於編譯後合約所容許的數目（{limit} 個）",
    "build.too-many-fields": "合約的欄位多於編譯後合約所容許的數目（{limit} 個）",
    "build.too-many-inputs": "{action} 的輸入項多於編譯後動作所容許的數目（{limit} 個）",
    "build.too-many-events": "{action} 轉變狀態的次數多於一次調用可報告的數目（{limit} 個事件）",
    "build.too-many-charges": "合約的費用多於編譯後合約所容許的數目（{limit} 個）",
    "build.too-large": "編譯後的合約會過大：某動作的程式碼，或其包含的文字、名稱及原因，超出合約的上限",
    "build.reject-text": "{text}：拒絕的文字不可以 bo: 開首，此標記屬編譯器本身的原因",
    "build.late-party": "{field} 以 {party} 開始，但 {party} 要待之後的動作才確定：請為 {field} 指定於建立時已確定的訂約方",
    "build.fuel": "{function} 一次調用最多可用 {bound} 燃料，多於一次調用所有的 {limit}：請為其清單設定較小的上限（最多 N 項），或在一個動作內少做一些",
    "build.output": "{function} 一次調用最多可寫出 {bound} 字節，多於編譯後合約為輸出預留的 {limit}：這樣的調用會被拒絕（bo:output）。部分會重複其母實例的欄位，因此狀態龐大的實例不能拆分為多個部分",
    "build.comments": "原始碼會連同其註釋（{count} 行）一併部署：各訂約方及任何驗證此合約的人均可閱讀",
    "run.input": "調用的輸入並非合約可讀取的內容：須為上限以內的確定性 CBOR",
    "run.overflow": "數值超出 Bo 可保存的範圍：以最小單位計的整數，64 位元",
    "run.division-by-zero": "除以零",
    "run.date": "日期不在公元 1 至 9999 年之內",
    "run.output": "結果過大：實例的狀態最多 64 KiB，調用的輸出最多 192 KiB",
    "run.consents": "此調用須取得超過 16 個賬本的同意",
    "run.function": "合約沒有此函數",
    "run.arguments": "參數並非由該函數輸入項組成的對照表",
    "run.argument": "參數 {name} 缺少，或類型不符",
    "run.state": "實例目前的狀態不容許 {action}",
    "run.requires": "{action} 的第 {number} 項要求未獲滿足",
    "run.in-person": "{action} 須由本人以通行密鑰或硬件密鑰證明親身在場",
    "run.party": "{party} 尚未確定賬本",
    "run.empty": "目前沒有 {party}",
    "run.pending": "實例已保留 16 項待批准的提議",
    "run.proposal": "沒有待批准的提議具有該函數及參數",
    "run.approve": "{action} 由 AI 代理提議：須由證明親身在場的真人批准",
    "run.when": "{rule} 尚未適用：其時間未到，或其條件不成立",
    "run.fired": "{rule} 已就此時間適用過",
    "run.depth": "{action} 會建立部分，但此實例已是深度 8 的部分，即賬本容許的最深層",
    "run.parts": "{action} 為每個接收方發出一個部分：部分的數目須與接收方相同，且至少一個",
    "fmt.unstable": "以 {language} 書寫時，此處原始碼的讀法會改變：合約自訂的名稱或某個字詞會與周圍的字詞連讀成 {language} 的另一個字詞；因此未有格式化任何內容：請把該名稱改名或改寫此行，或格式化為另一種語言",
    "fmt.internal": "按標準版面編排後，此處原始碼的讀法會改變，因此未有格式化任何內容；這是格式化工具的錯誤，請回報",
    "bo.truncated": "尚有其他問題；只顯示首 {limit} 個"
  },

  "sentences": {
    "contract": "合約 {name}",
    "fragment": "合約片段（沒有 合約 一行，因此不能部署）",
    "intro": "本文由 Bo 按合約的原始碼寫成（Bo 第 {edition} 版）。標有規則（例如〔R3〕）的條文，所述內容並非原始碼直接寫明，而是 Bo 按該規則推斷；最後一節逐一解釋各規則。",
    "packs-used": "除 Bo 的核心詞彙外，本合約使用{packs}。",
    "vocab-pack": "{pack}詞彙包（第 {version} 版）",
    "vocab-core": "核心",
    "mark": "〔{rules}〕",
    "rule-line": "〔{rule}〕{text}",
    "section-parties": "訂約方",
    "section-instance": "每個實例",
    "section-charges": "費用",
    "section-states": "狀態",
    "section-actions": "動作",
    "section-time": "時間規則",
    "section-rules": "Bo 所採用的規則",
    "party-creation": "{party}：於建立實例時確定賬本。",
    "party-action": "{party}：由首次{action}確定賬本，並須經{party}同意。",
    "party-each": "{party}：由每次{action}確定賬本，並須經{party}同意。",
    "instance-kind": "每個實例為一項{kind}，名為{name}。",
    "instance-none": "實例不存放任何欄位。",
    "field-default": "{field}：{type}；每個實例以{value}開始，除非建立實例時給出其他數值。",
    "field-given": "{field}：{type}，於建立實例時給出。",
    "field-party": "{field}：{type}；每個實例以{party}開始，動作可以更改。",
    "field-constant": "{field}：{value}，所有實例均相同。",
    "field-empty": "{field}：{type}；每個實例開始時為無，由動作設定。",
    "creation": "建立實例（函數 {function}）時，須指明於建立時確定的訂約方的賬本，並給出於建立時給出的欄位。建立實例毋須任何訂約方同意：各訂約方透過下列動作表示同意。",
    "state-first": "實例的首個狀態為{state}。",
    "states-all": "其狀態包括{states}。",
    "state-final": "{state}為最終狀態：沒有動作可由此狀態開始，因此處於此狀態的實例不再接受調用。",
    "states-no-final": "沒有最終狀態：任何狀態下均有動作可以開始。",
    "events": "每次狀態轉變（包括首個狀態）均記錄為事件。",
    "actions-note": "調用如未符合動作的任何一項要求，即被拒絕，實例維持不變。欠缺同意並非拒絕：調用會等待該同意。",
    "action-function": "{action}（函數 {function}）",
    "action-standard": "Bo 的內置動作：其標準條款（由誰發起、須經誰同意、所需及所轉變的狀態）將隨日後版本的標準庫提供，因此本文只列出合約所寫的條文。",
    "action-terms": "Bo 的內置動作，按 Bo 標準庫的標準條款（cexchain bo stdlib show {function}）：標示 R19 的條文列出這些條款，列於合約本身的條文之後。",
    "action-terms-pack": "{pack}詞彙包的內置動作，按該詞彙包訂立的標準條款（cexchain bo stdlib show {function}）：標示 R19 的條文列出這些條款，列於合約本身的條文之後。",
    "action-home": "由所屬賬本自行發起：毋須任何訂約方同意。",
    "action-home-start": "由所屬賬本自行發起。",
    "action-rule-only": "只有合約的時間規則會執行此動作：沒有調用可直接發起。",
