# Bo language pack: Traditional Chinese, Hong Kong usage (official).
#
# Hong Kong terms and character forms (zh-Hant-HK), not Taiwan's: 賬 not 帳,
# 紀錄, 合約, 訂約方, 予, 須, 及, 今日, 清單. A native Hong Kong reviewer signs
# off the words before the first release. Spellings with "…" mark where the
# argument goes; the digest covers the canonical CBOR, not this layout.

{
  "format": 1,
  "id": "zh-Hant-HK",
  "version": 1,
  "language": "zh-Hant-HK",
  "name": "繁體中文（香港）",
  "official": true,
  "edition": 1,

  "reading": {
    "separation": "none",
    # 可質押, 須親身確認, 當逾期, 如逾期: these keywords may attach to the
    # word after them, when that word is in the vocabulary or declared in
    # the contract (可用率 stays one word).
    "prefixes": ["kw.can", "kw.requires", "kw.when", "kw.if"],
    "attach": [
      # 每GB, 每港元
      {"word": "price.per", "before": ["unit", "currency"]},
      # 按發票, 按客戶所在地
      {"word": "charge.by", "before": ["document", "field"]},
      # 30日內
      {"word": "cond.within", "after": ["time", "unit"]}
    ],
    "punctuation": {
      "，": ",", "、": ",", "：": ":", "（": "(", "）": ")", "％": "%",
      "\u3000": " ",
      "０": "0", "１": "1", "２": "2", "３": "3", "４": "4",
      "５": "5", "６": "6", "７": "7", "８": "8", "９": "9"
    },
    "multipliers": {"萬": 10000, "億": 100000000},
    "dates": {"read": ["{Y}年{M}月{D}日"], "write": "{Y}年{M}月{D}日"}
  },

  "keywords": {
    "kw.contract": "合約",
    "kw.parties": "訂約方",
    "kw.can": "可",
    "kw.by": "由",
    "kw.to": "予",
    "kw.with": "連同",
    "kw.requires": "須",
    "kw.when": "當",
    "kw.if": "如",
    "kw.otherwise": "否則",
    "kw.and": "及",
    "kw.or": "或",
    "kw.not": "非",
    "kw.each": "逐一",
    "kw.in": "於",
    "kw.reject": "拒絕",
    "kw.test": "測試",
    "kw.use": "使用"
  },

  "vocabulary": {
    "kind.asset": "資產",
    "kind.service": "服務",
    "kind.resource": "資源",
    "kind.record": "紀錄",

    "act.issue": "發出",
    "act.transfer": "轉讓",
    "act.pledge": "質押",
    "act.release": "解除質押",
    "act.enforce": "執行質權",
    "act.redeem": "贖回",
    "act.split": "拆分",
    "act.merge": "合併",
    "act.cancel": "註銷",
    "act.pay": "支付",
    "act.confirm_payment": "確認收款",
    "act.dispute": "提出爭議",
    "act.refund": "退款",
    "act.credit": "抵扣",
    "act.subscribe": "訂購",
    "act.renew": "續期",
    "act.upgrade": "升級",
    "act.downgrade": "降級",
    "act.suspend": "暫停",
    "act.resume": "恢復",
    "act.terminate": "終止",
    "act.allocate": "分配",
    "act.reclaim": "收回",
    "act.freeze": "凍結",
    "act.unfreeze": "解凍",
    "act.approve": "批准",
    "act.propose": "提議",
    "act.notify": "通知",

    "cond.over": "超過 …",
    "cond.in_person": "親身確認",
    "cond.consent_of": "經 … 同意",
    "cond.overdue": "逾期",
    "cond.before_due": "到期前 …",
    "cond.within": "… 內",

    "price.price": "價格",
    "price.usage": "用量",
    "price.traffic": "流量",
    "price.overage": "超出",
    "price.per": "每",
    "price.setup_fee": "開通費",
    "price.proration": "按日折算",

    "charge.charge": "費用",
    "charge.tax": "稅",
    "charge.rate": ["稅率", "費率"],
    "charge.applies_to": "適用 …",
    "charge.from": "從 … 起",
    "charge.included": "內含",
    "charge.added": "另計",
    "charge.per_line": "逐行",
    "charge.per_document": "按單據",
    "charge.by": "按",

    "time.day": "日",
    "time.week": "週",
    "time.month": "個月",
    "time.year": "年",
    "time.daily": "每日",
    "time.weekly": "每週",
    "time.monthly": "每月",
    "time.yearly": "每年",
    "time.now": "現時",
    "time.today": "今日",

    "unit.MB": "MB",
    "unit.GB": "GB",
    "unit.TB": "TB",
    "unit.MiB": "MiB",
    "unit.GiB": "GiB",
    "unit.TiB": "TiB",
    "unit.Mbps": "Mbps",
    "unit.Gbps": "Gbps",
    "unit.item": "個",
    "unit.kg": "公斤",
    "unit.tonne": "噸",

    "cur.HKD": "港元",
    "cur.CNY": "人民幣",
    "cur.USD": "美元",
    "cur.SGD": "新加坡元",
    "cur.EUR": "歐元",

    "round.half_up": "四捨五入",
    "round.half_even": "四捨六入五成雙",
    "round.down": "捨去",

    "doc.invoice": "發票",
    "doc.credit_note": "貸項通知單",
    "doc.receipt": "收據",

    "type.date": "日期",
    "type.text": "文字",
    "type.number": "數值",
    "type.yes_no": "是否",
    "type.list": "清單",
    "val.yes": "是",
    "val.no": "否",

    "field.holder": "持有人",
    "field.amount": "金額",
    "field.due": "到期日",
    "field.quantity": "數量",
    "field.tier": "層級",
    "field.pledgee": "質權人",
    "field.parts": "各部分",
    "field.customer_location": "客戶所在地",
    "field.cooling_period": "冷卻期",

    "state.active": "正常",
    "state.proposed": "已提議",
    "state.pledged": "已質押",
    "state.paid": "已支付",
    "state.settled": "已結清",
    "state.frozen": "已凍結",
    "state.suspended": "已暫停",
    "state.terminated": "已終止",
    "state.cancelled": "已註銷",

    "actor.person": "真人",
    "actor.ai_agent": ["AI 代理", "AI代理"],
    "actor.device": "裝置",

    "role.we": "本公司",
    "role.customer": "客戶",
    "role.supplier": "供應商",
    "role.bank": "銀行",
    "role.issuer": "發行人",

    "expr.sum_of": "… 總和",
    "expr.count_of": "… 數目",
    "expr.at_most": "最多 …"
  },

  "messages": {
    "pack.syntax": "語言包不是有效的 CBOR 診斷記法：{detail}",
    "pack.too-large": "語言包有 {size} 位元組，上限為 {limit}",
    "pack.expected-map": "{path} 須為映射（map）",
    "pack.expected-text": "{path} 須為文字字串",
    "pack.expected-list": "{path} 須為清單",
    "pack.expected-integer": "{path} 須為非負整數",
    "pack.expected-boolean": "{path} 須為 true 或 false",
    "pack.unknown-key": "{path} 有未知的鍵 {key}",
    "pack.missing-key": "{path} 須有鍵 {key}",
    "pack.format": "不支援語言包格式 {value}；此編譯器讀取格式 1",
    "pack.edition": "不支援 Bo 第 {value} 版；此編譯器只認識第 1 版",
    "pack.bad-id": "{value} 不是有效的語言包代號：須以字母開頭，只可含字母、數字及單個連字號，最長 64 個字元",
    "pack.bad-language": "{value} 不是有效的語言標籤（BCP 47，例如 zh-Hant-HK）",
    "pack.bad-version": "版本須為 1 或以上，不可為 {value}",
    "pack.bad-text": "{path} 須為 1 至 200 位元組（月份名稱為 64，訊息及句子為 1,000），且不可含控制字元",
    "pack.bad-value": "{path} 不可為 {value}",
    "pack.too-many": "{path} 的項目多於 {limit} 個",
    "pack.unknown-concept": "{path}：{concept} 不是 Bo 第 1 版的概念",
    "pack.wrong-category": "{path}：{concept} 屬於 {category} 類別，不應放在此處",
    "pack.missing-keyword": "語言包 {pack} 未拼寫關鍵字 {concept}；每個語言包均須拼寫所有關鍵字",
    "pack.partial": "語言包 {pack} 未拼寫 {total} 個詞語中的 {missing} 個；這些詞語以英文讀取及顯示",
    "pack.bad-spelling": "{path}：{spelling} 不是有效的拼寫：須為一至四個以單個空格分隔的詞，每個詞不可長於 64 位元組，亦不可以數字開頭",
    "pack.bad-character": "{path}：{spelling} 含有 {character}，任何詞語均不可包含此字元",
    "pack.needs-hole": "{path}：{spelling} 須以 … 標示 {concept} 的參數位置（一次）",
    "pack.unexpected-hole": "{path}：{spelling} 不可含 …：{concept} 不接受參數",
    "pack.bad-form": "{path}：{form} 不是有效的詞形名稱（小寫英文字母，最多 16 個）",
    "pack.duplicate-spelling": "語言包 {pack} 給予 {spelling} 兩個意思：{concept} 及 {other}",
    "pack.conflict": "{spelling} 在語言包 {pack} 中解作 {meaning}，在語言包 {other_pack} 中卻解作 {other}；同一拼寫不可有兩個意思",
    "pack.ambiguous-attachment": "{spelling}（{meaning}）亦可讀作 {first} + {second}；請更改拼寫或收窄連寫規則",
    "pack.bad-attach": "{path}：{concept} 不可連寫：此語言包須把它拼寫為一個詞，… 只可在遠離相鄰詞的一側",
    "pack.unknown-category": "{path}：{category} 不是可連寫的類別",
    "pack.bad-punctuation": "{path}：{character} 不可作標點別名：須為任何詞語均不含的一個字元，代表 , : ( ) % \" = < > + - * / . _、數字或空格之一",
    "pack.bad-multiplier": "{path}：{value} 不是 10 至 10^18 之間的十的冪",
    "pack.bad-date": "{path}：{pattern} 不是有效的日期格式：欄位 Y、M（書寫時可用 MONTH 並提供十二個月份名稱）及 D 須各以大括號標示一次，欄位之間須有文字",
    "pack.unknown-message": "{path}：{code} 不是訊息代碼",
    "pack.unknown-sentence": "{path}：{id} 不是句子代號",
    "pack.bad-placeholder": "{path}：{placeholder} 不是此文字可用的佔位符",
    "pack.false-official": "語言包 {pack} 自稱官方，但並非此編譯器所附帶的官方語言包",
    "pack.duplicate-id": "有兩個語言包的代號同為 {pack}",
    "bo.truncated": "尚有其他問題；只顯示首 {limit} 個"
  },

  "sentences": {
    "contract": "合約：{name}",
    "parties": "訂約方：{parties}。",
    "can": "{party}可{action}。",
    "can-to": "{party}可{action}予{counterparty}。",
    "consent": "須經{party}同意。",
    "in-person": "{party}須以通行密鑰或硬件密鑰親身確認。",
    "agents-propose": "AI 代理可提議此項；須經真人批准方會生效。",
    "when": "當{event}時：{action}。",
    "reject": "否則拒絕：{message}",
    "recognized": "（按規則 {rule} 自動識別）"
  }
}
