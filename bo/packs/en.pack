# Bo language pack: English (official).
#
# CBOR diagnostic notation; the pack's digest covers its canonical CBOR, so
# comments and layout do not change it. Released versions never change: a
# change is a new version. Spellings with "…" mark where the argument goes.

{
  "format": 1,
  "id": "en",
  "version": 5,
  "language": "en",
  "name": "English",
  "official": true,
  "edition": 1,

  "reading": {
    "separation": "spaces",
    "dates": {
      "write": "{D} {MONTH} {Y}",
      "months": ["January", "February", "March", "April", "May", "June", "July",
                 "August", "September", "October", "November", "December"]
    }
  },

  "keywords": {
    "kw.contract": "contract",
    "kw.parties": "parties",
    "kw.can": "can",
    "kw.by": "by",
    "kw.to": "to",
    "kw.with": "with",
    "kw.requires": "requires",
    "kw.when": "when",
    "kw.if": "if",
    "kw.otherwise": "otherwise",
    "kw.and": "and",
    "kw.or": "or",
    "kw.not": "not",
    "kw.each": "each",
    "kw.in": "in",
    "kw.reject": "reject",
    "kw.test": "test",
    "kw.use": "use",
    "kw.request": "request",
    "kw.done": "done",
    "kw.fails": "fails",
    "kw.expires": "expires"
  },

  "vocabulary": {
    # What a block declares.
    "kind.thing": {"word": "thing", "forms": {"plural": "things", "indefinite": "a thing"}},

    # Business actions: the base form, and the forms sentences use.
    "act.issue": {"word": "issue", "forms": {"third": "issues", "gerund": "issuing"}},
    "act.transfer": {"word": "transfer", "forms": {"third": "transfers", "gerund": "transferring"}},
    "act.cancel": {"word": "cancel", "forms": {"third": "cancels", "gerund": "cancelling"}},
    "act.suspend": {"word": "suspend", "forms": {"third": "suspends", "gerund": "suspending"}},
    "act.resume": {"word": "resume", "forms": {"third": "resumes", "gerund": "resuming"}},
    "act.terminate": {"word": "terminate", "forms": {"third": "terminates", "gerund": "terminating"}},
    "act.approve": {"word": "approve", "forms": {"third": "approves", "gerund": "approving"}},
    "act.propose": {"word": "propose", "forms": {"third": "proposes", "gerund": "proposing"}},
    "act.notify": {"word": "notify", "forms": {"third": "notifies", "gerund": "notifying"}},
    "act.create": {"word": "create", "forms": {"third": "creates", "gerund": "creating"}},

    # Conditions.
    "cond.over": "over …",
    "cond.in_person": "in person",
    "cond.consent_of": "consent of …",
    "cond.overdue": "overdue",
    "cond.before_due": "… before due",
    "cond.within": "within …",

    # Time.
    "time.day": {"word": "day", "forms": {"plural": "days"}},
    "time.week": {"word": "week", "forms": {"plural": "weeks"}},
    "time.month": {"word": "month", "forms": {"plural": "months"}},
    "time.year": {"word": "year", "forms": {"plural": "years"}},
    "time.daily": "daily",
    "time.weekly": "weekly",
    "time.monthly": "monthly",
    "time.yearly": "yearly",
    "time.now": "now",
    "time.today": "today",
    "time.at": "at …",

    # Units.
    "unit.MB": "MB",
    "unit.GB": "GB",
    "unit.TB": "TB",
    "unit.MiB": "MiB",
    "unit.GiB": "GiB",
    "unit.TiB": "TiB",
    "unit.Mbps": "Mbps",
    "unit.Gbps": "Gbps",
    "unit.item": {"word": "item", "forms": {"plural": "items"}},
    "unit.kg": "kg",
    "unit.tonne": {"word": "tonne", "forms": {"plural": "tonnes"}},
    "unit.celsius": {"word": "degree Celsius", "forms": {"plural": "degrees Celsius"}},

    # Currencies.
    "cur.HKD": "HKD",
    "cur.CNY": "CNY",
    "cur.USD": "USD",
    "cur.SGD": "SGD",
    "cur.EUR": "EUR",

    # Rounding modes.
    "round.half_up": "half up",
    "round.half_even": "half even",
    "round.down": "down",

    # Types and values.
    "type.date": "date",
    "type.text": "text",
    "type.number": "number",
    "type.yes_no": "yes or no",
    "type.list": "list",
    "val.yes": "yes",
    "val.no": "no",
    "val.refused": "refused",
    "val.none": "none",
    "val.pending_approval": "pending approval",

    # Fields. Their forms are how the contract text refers to them.
    "field.holder": {"word": "holder", "forms": {"subject": "the holder", "object": "the holder"}},
    "field.amount": {"word": "amount", "forms": {"object": "the amount"}},
    "field.due": {"word": "due", "forms": {"object": "the due date"}},
    "field.quantity": {"word": "quantity", "forms": {"object": "the quantity"}},
    "field.parts": {"word": "parts", "forms": {"object": "the parts"}},
    "field.utc_offset": {"word": "UTC offset", "forms": {"object": "the UTC offset"}},
    "field.recipients": {"word": "recipients",
                         "forms": {"subject": "the recipients", "object": "the recipients"}},

    # States.
    "state.active": "active",
    "state.proposed": "proposed",
    "state.suspended": "suspended",
    "state.terminated": "terminated",
    "state.cancelled": "cancelled",
    "state.divided": "divided",

    # Who acts.
    "actor.person": {"word": "person", "forms": {"plural": "people"}},
    "actor.ai_agent": {"word": "AI agent", "forms": {"plural": "AI agents"}},
    "actor.device": {"word": "device", "forms": {"plural": "devices"}},
    "actor.keeper": {"word": "keeper", "forms": {"plural": "keepers"}},
    "actor.executor": {"word": "executor", "forms": {"plural": "executors"}},

    # Common roles. The contract text says "the counterparty must ...", "started by us".
    "role.we": {"word": "we", "forms": {"object": "us"}},
    "role.counterparty": {"word": "counterparty", "forms": {"subject": "the counterparty", "object": "the counterparty"}},

    # Built-in expressions.
    "expr.sum_of": "sum of …",
    "expr.count_of": "count of …",
    "expr.at_most": "at most …",
    "expr.previous_state": "previous state",
    "expr.result": "result",
    "expr.reason": "reason"
  },

  "messages": {
    "pack.syntax": "the pack is not valid CBOR diagnostic notation: {detail}",
    "pack.too-large": "the pack is {size} bytes; the limit is {limit}",
    "pack.expected-map": "{path} must be a map",
    "pack.expected-text": "{path} must be a text string",
    "pack.expected-list": "{path} must be a list",
    "pack.expected-integer": "{path} must be an unsigned integer",
    "pack.expected-boolean": "{path} must be true or false",
    "pack.unknown-key": "{path} has an unknown key {key}",
    "pack.missing-key": "{path} needs the key {key}",
    "pack.format": "pack format {value} is not supported; this compiler reads format 1",
    "pack.edition": "Bo edition {value} is not supported; this compiler knows edition 1",
    "pack.bad-id": "{value} is not a valid pack id: letters, digits, and single hyphens, starting with a letter, at most 64",
    "pack.bad-language": "{value} is not a valid language tag (BCP 47, such as zh-Hant-HK)",
    "pack.bad-version": "the version must be 1 or more, not {value}",
    "pack.bad-text": "{path} must be 1 to 200 bytes (64 for month names, 1,000 for messages and sentences), without control characters",
    "pack.bad-value": "{path} cannot be {value}",
    "pack.too-many": "{path} has more than {limit} entries",
    "pack.unknown-concept": "{path}: {concept} is not a concept of Bo edition 1",
    "pack.wrong-category": "{path}: {concept} is in the category {category}, which does not belong here",
    "pack.missing-keyword": "pack {pack} does not spell the keyword {concept}; every pack spells every keyword",
    "pack.partial": "pack {pack} does not spell {missing} of the {total} words; those are read and shown in English",
    "pack.bad-spelling": "{path}: {spelling} is not a valid spelling: one to four words separated by single spaces, none longer than 64 bytes or starting with a digit",
    "pack.bad-character": "{path}: {spelling} contains {character}, which no word may contain",
    "pack.needs-hole": "{path}: {spelling} must mark the place of {concept}'s argument with … (once)",
    "pack.unexpected-hole": "{path}: {spelling} may not contain …: {concept} takes no argument",
    "pack.bad-form": "{path}: {form} is not a valid form name (lowercase letters, at most 16)",
    "pack.duplicate-spelling": "pack {pack} gives {spelling} two meanings: {concept} and {other}",
    "pack.conflict": "{spelling} means {meaning} in pack {pack} but {other} in pack {other_pack}; one spelling cannot have two meanings",
    "pack.ambiguous-attachment": "{spelling} ({meaning}) could also be read as {first} + {second}; change a spelling or narrow the attaching rule",
    "pack.bad-attach": "{path}: {concept} cannot attach: it must be spelled in this pack as one word, with … only on the side away from its neighbour",
    "pack.unknown-category": "{path}: {category} is not a category a word may attach to",
    "pack.bad-punctuation": "{path}: {character} cannot be a punctuation alias: one character that no word contains, for one of , : ( ) % \" = < > + - * / . _ a digit or a space",
    "pack.bad-multiplier": "{path}: {value} is not a power of ten from 10 to 10^18",
    "pack.bad-date": "{path}: {pattern} is not a valid date pattern: the fields Y, M (or MONTH, to write, with twelve month names), and D, each once and in braces, with text between them",
    "pack.unknown-message": "{path}: {code} is not a message code",
    "pack.unknown-sentence": "{path}: {id} is not a sentence id",
    "pack.bad-placeholder": "{path}: {placeholder} is not a placeholder this text may use",
    "pack.false-official": "pack {pack} says it is official, but it is not one of the official packs this compiler carries",
    "pack.duplicate-id": "two packs have the id {pack}",
    "vocab.syntax": "the vocabulary pack is not valid CBOR diagnostic notation: {detail}",
    "vocab.too-large": "the vocabulary pack has {size} bytes; the limit is {limit}",
    "vocab.format": "vocabulary pack format {value} is not supported; this compiler reads format 1",
    "vocab.bad-id": "{value} is not a valid vocabulary pack id: lowercase ASCII letters, digits, and _, starting with a letter, at most 32",
    "vocab.official-id": "{value} is the id of Bo's core or of an official vocabulary pack (commerce, finance, services): give the pack an id of its own",
    "vocab.bad-language": "{value} is not a language pack's id (en, zh-Hant-HK, zh-Hans-CN, or a pack of your own)",
    "vocab.bad-requires": "{path}: {value} cannot be required: name another vocabulary pack, once",
    "vocab.bad-concept": "{path}: {concept} is not a concept id: a category's prefix (act, field, state, role, unit), a dot, and a name of ASCII letters, digits, and _",
    "vocab.category": "{path}: a vocabulary pack of your own cannot define a word of the category {category}, which only the compiler's mechanisms have: it defines actions, fields, states, roles, and units",
    "vocab.shadows": "{path}: {concept} would have the name of {other}, a word of Bo's core or of an official pack: give it a name of its own",
    "vocab.argument": "{path}: a vocabulary pack of your own cannot define a word that takes an argument",
    "vocab.type": "{path}: {value} is not a type a field may have: party, date, number, text, duration, parties, quantity, list, or amount",
    "vocab.flag": "{path}: only a field of type party is added or taking",
    "vocab.unit": "{path}: a unit has a dimension (data, bandwidth, count, mass, or temperature) and a scale, from 1 to 10^15 times its dimension's smallest unit",
    "vocab.bad-terms": "{path}: the terms are a Bo source: a text, or its lines (none with a line break), at most 64 KiB",
    "vocab.unspelled": "the language {language} does not spell {concept}: each language spells every word of the pack",
    "vocab.not-own": "{path}: {concept} is not a concept of this pack",
    "vocab.duplicate-spelling": "vocabulary pack {pack} gives {spelling} two meanings: {concept} and {other}",
    "vocab.bad-attach": "{path}: {concept} cannot attach: spell it as one word, with … only on the side away from the word it attaches to",
    "vocab.conflict": "{spelling}, a word of the vocabulary pack {pack}, already means {meaning}: spell it otherwise",
    "vocab.duplicate-id": "two vocabulary packs have the id {pack}",
    "vocab.unknown-requires": "the vocabulary pack {pack} requires {other}, which is neither official nor given (give it with --vocab)",
    "vocab.cycle": "the vocabulary pack {pack} requires itself, through the packs it requires",
    "vocab.no-language": "the vocabulary pack {pack} spells its words in {language}, but no language pack read here has that id: those spellings are not read",
    "vocab.terms": "the terms of the vocabulary pack {pack} do not read: line {line}, {code} (bo vocab check shows why)",
    "vocab.terms-clause": "line {line} of the terms of the vocabulary pack {pack} is not the terms of one of its actions: each clause there is can ACTION, an action the pack defines",
    "lex.too-large": "the source is {size} bytes; the limit is {limit}",
    "lex.utf8": "the source is not valid UTF-8 here",
    "lex.invisible": "the invisible character {character} is not allowed: the source must read as it looks",
    "lex.tab": "a tab is not allowed; indent and separate words with spaces",
    "lex.indent-character": "indent with spaces only, not {character}",
    "lex.dedent": "this line's indentation matches no enclosing block",
    "lex.too-deep": "blocks nest more than {limit} deep",
    "lex.bad-character": "{character} cannot appear here: it is not part of a word, a number, or an operator",
    "lex.bad-number": "{text} is not a number: digits, with _ only between digits and at most one decimal point between digits (5_000, 0.10)",
    "lex.digit-comma": "{text}: a comma never groups digits; write {suggestion}",
    "lex.number-too-large": "{text} has more digits than Bo keeps: at most 18446744073709551615 without the decimal point, and 18 decimal places",
    "lex.number-suffix": "{suffix} cannot follow the number in {text}: a number may be followed directly by a multiplier (萬), then a unit, a time unit, or a currency (2TB, 30日, 500萬港元), then a word such as 內",
    "lex.multiplier": "{word} multiplies the number just before it: 500萬 or 500 萬",
    "lex.percent": "% must follow its number directly: 5%",
    "lex.bad-date": "{text} is not a date: write YYYY-MM-DD with a year from 1 to 9999, a month from 01 to 12, and a day the month has (2027-01-06)",
    "lex.unterminated-text": "the text has no closing quote on this line",
    "lex.text-too-long": "the text is longer than {limit} bytes",
    "lex.edition": "Bo edition {value} is not supported; this compiler reads edition 1",
    "lex.bad-edition": "the first line names the edition: bo followed by its number alone (bo 1)",
    "lex.ambiguous": "{text} can be read as {first} or as {second}; Bo never guesses: add a space where the words divide",
    "lex.ambiguous-money": "in {text}, a currency stands between two numbers, or a number between two currencies, so which belongs to which is unclear: keep each amount with its currency, and separate the amounts",
    "lex.needs-space": "{text}: write {first} and {second} apart, with a space",
    "lex.bad-name": "{name} is not a name: a name starts with a letter, followed by letters, marks, digits, or _",
    "lex.name-too-long": "{name} is longer than {limit} bytes",
    "lex.not-normalized": "{character} would change under Unicode normalization: write the composed character instead, so that names that look alike are the same name",
    "lex.mixed-script": "{name} mixes Latin, Greek, or Cyrillic letters, which look alike: write a name in one of these scripts",
    "lex.confusable": "{name} looks like {other} but is not the same: write it one way, or choose a name that looks different",
    "parse.top-level": "{found} cannot start a line here: outside any block, a line starts with use, contract, parties, a kind (thing; asset, service, or resource with their packs), charge or tax, can, when, or test",
    "parse.statement": "{found} cannot start a line in an action's block: write requires, if, otherwise, each, reject, a field set (holder = bank), a state change (active -> suspended), an action (notify customer), or who may propose (AI agent can propose)",
    "parse.field": "{found} cannot appear in a field: a block's line names a field, then its type or value (amount HKD, IP 1 item), with commas between parts",
    "parse.step": "{found} cannot start a step: a test's lines are steps, the party first (supplier pledge to bank, optionally at DATE, in person, by AI agent), and expectations (-> pledged, -> refused)",
    "parse.trailing": "the line is complete before {found}: remove it, or start a new line",
    "parse.unexpected-block": "these lines are indented, but the line before them opens no block",
    "parse.empty-block": "{word} needs what it governs: an indented block under it, or for when, if, and otherwise, a statement on the same line",
    "parse.otherwise": "{word} must follow an if block at the same indentation",
    "parse.duplicate": "{word} is given twice; give it once",
    "parse.reserved": "{word} declares a vocabulary pack on a line of its own, outside any block: use finance",
    "parse.too-deep": "this line nests more than {limit} levels deep (parentheses, operators, or otherwise if)",
    "parse.expected-name": "a name of your own must follow {after}: keywords and words of the vocabulary cannot be names",
    "parse.expected-action": "an action must follow {after}: a word of the vocabulary (pledge, transfer) or a name of your own",
    "parse.expected-party": "a party must follow {after}: a role (issuer, bank, customer) or a name of your own",
    "parse.expected-value": "a value must follow {after}",
    "parse.expected-text": "a text in double quotes must follow {after}",
    "parse.expected-state": "a state must follow {after}: a word such as pledged, a name of your own, or refused in a test",
    "parse.expected-set": "a field and its value must follow {after}: amount = HKD 100, with commas between them",
    "parse.can": "{found} cannot follow the action here: write by PARTY, to PARTY, or with INPUTS, each at most once",
    "parse.when": "when needs an event before its action: when overdue 3 days suspend, when 7 days before due notify customer",
    "parse.request": "a request is written request KIND [to PARTY] [with NAME = VALUE, ...] within DURATION, its kind a name or an action's word; found {found}",
    "parse.each": "each is written each NAME in LIST, with the lines to repeat in a block under it",
    "parse.bare-condition": "a condition alone does nothing: write requires or if before it; to set a field, write FIELD = VALUE",
    "parse.unclosed": "this ( is not closed on its line",
    "parse.missing-head": "{text} ends {concept}, but the word that begins it is missing",
    "parse.missing-tail": "{text} begins {concept}, but the word that ends it is missing after the value",
    "parse.missing-argument": "{text} ({concept}) needs its value before it, as in 7 days before due",
    "parse.chained-comparison": "comparisons do not chain: write a < b and b < c, not a < b < c (at {operator})",
    "parse.phrase-operator": "words side by side cannot be combined with {operator}: put them in parentheses",
    "parse.ambiguous-name": "{name} could be the name {name} or {prefix} followed by {rest}, since both are declared; Bo never guesses: write {prefix} {rest} with a space, or rename one of them",
    "parse.undeclared-split": "{name} is one name here, since nothing declares {rest}; to begin the line with {prefix}, write {prefix} {rest} with a space",
    "check.fragment": "there is no contract line, so this file is checked as a fragment; bo build will need contract NAME",
    "check.no-parties": "the contract has actions but no parties line: write parties, then its roles (parties issuer, supplier, bank)",
    "check.unknown-pack": "use {pack}: no vocabulary pack has this id; the official ones are commerce, finance, and services, and a pack of your own is given with --vocab FILE",
    "check.pack-not-used": "{word} is a word of the {pack} vocabulary pack, which the source does not use: write use {pack} at its top",
    "check.pack-requires": "use {pack} needs use {other} too: the pack requires it",
    "check.duplicate": "{name} is declared twice; a name has one meaning in a contract",
    "check.one-kind": "a contract describes one kind of instance; {name} would be a second: write another contract for it",
    "check.unknown-name": "{name} is not declared: it is not a party, a field, an input, a state, or a name each gives",
    "check.unknown-party": "{party} is not one of the contract's parties: add it to the parties line",
    "check.unknown-field": "the instance has no field {field}: declare it in the kind's block (amount HKD, due date)",
    "check.unknown-input": "{action} has no input {name}",
    "check.field-head": "{text} cannot name a field: use a name of your own, or a field or price word (amount, due, holder, price)",
    "check.default-field": "{field} cannot have a default: only an instance field given at creation has one; a constant has its value, a party field starts with its party, and a bill is made from its lines",
    "check.default-value": "{text} is no default: a default is a value written out, of the field's type: 0, HKD 0, no, \"none yet\", 2027-01-01, or a list of them",
    "check.field-needs-type": "{field} needs its type or its value: amount HKD, due date, IP 1 item",
    "check.field-type": "{field} holds {expected_type}, not {type}",
    "check.field-values": "{field} takes one type or value; further parts after commas must be labelled prices (overage per GB HKD 0.10)",
    "check.not-a-value": "{text} is not a value here: a value is a number, an amount, a date, a text, a party, a field, an input, or a condition where one may stand",
    "check.phrase": "Bo reads no value in {text}: words side by side form a recurring amount (monthly HKD 120), a unit price (per GB HKD 0.10), a labelled price (overage per GB HKD 0.10), overdue N, or according to a field",
    "check.type": "{text} is {type}, but {expected_type} is needed here",
    "check.operands": "{operator} cannot combine {left_type} with {right_type}",
    "check.mixed-currencies": "{left_type} and {right_type} are in different currencies; Bo never converts one into the other",
    "check.mixed-units": "{left_type} and {right_type} measure different things, which never mix",
    "check.calendar": "{text} mixes months or years with days or weeks: a month has no fixed number of days, so Bo neither compares nor adds them",
    "check.precision": "{text} is finer than Bo keeps: money to the currency's cent, unit prices to six decimal places, rates to 0.0001%, quantities to whole bytes, bits per second, items, or grams, temperatures to hundredths of a degree",
    "check.whole-number": "{text} must be a whole number here (for a share, write a rate: 150%)",
    "check.overflow": "{text} is too large: Bo keeps every value as a whole number of its smallest unit, in 64 bits",
    "check.zero-division": "{text} divides by zero",
    "check.list-items": "the items of {text} are not all of one type",
    "check.list-bound": "{text}: a list holds from 1 to {limit} items",
    "check.each-body": "{text}: the block of each runs once for each item, so it cannot change the state, do an action, or make a request; move it out of each",
    "check.set-constant": "{field} is a constant (the block gives its value), so no action can change it; to let actions change it, declare its type instead (tier number)",
    "check.set-target": "{text} cannot be set: only a field of the instance can",
    "check.initial-state": "an instance could start in any of {states}, since no state change leads to them; Bo never guesses: an instance starts in the one state nothing leads to, otherwise in active",
    "check.unreachable-state": "no state change leads to {state} from the state an instance starts in, so no instance can ever reach it",
    "check.needs-by": "who starts {action}? An action of your own needs by PARTY",
    "check.recursion": "{action} leads back to itself through the actions it does; a contract never recurses",
    "check.permit": "{text}: the only line of this kind in edition 1 is AI agent can propose",
    "check.subject": "{text}: inside an action only the contract acts; a party's duty belongs in a when rule (when due issuer pays)",
    "check.threshold-amount": "{text} compares the amount of {action}, which has no one amount: give it one input of money (with amount HKD) or the instance an amount field, or compare a field instead (requires amount > HKD 100)",
    "check.standard-by": "{action} is a built-in action, started by {party} under its standard terms; to have another party start it, copy it under a name of your own (cexchain bo stdlib show {action})",
    "check.standard-to": "{action} has no counterparty under its standard terms, so it takes no to; to give it one, copy it under a name of your own (cexchain bo stdlib show {action})",
    "check.standard-change": "{text}: the state changes of {action}, and the fields its standard terms change, are the standard terms'; to change them, copy it under a name of your own (cexchain bo stdlib show {action})",
    "check.standard-field": "the standard terms of {action} use the field {field}, which each instance must hold and actions may change: declare it in the kind's block, with its type",
    "check.standard-unreachable": "{action} can never start: under its standard terms it starts only from {states}, which no instance of this contract ever reaches",
    "check.when-event": "{text} is not a time: a when rule fires at a date (when due, when due + 3 days), N before due, overdue or overdue N, or once the instance has been in a state for N (when suspended 30 days), with other conditions joined by and",
    "check.when-person": "{text} asks for a person, but a keeper (a device) calls a when rule: nobody confirms it in person or proposes it",
    "check.needs-due": "{text} counts from a due date, which the instance does not have: declare due date in the kind's block (a service with a recurring price is due at the end of each period)",
    "check.when-action": "{action} cannot be done by a when rule: the keeper's call gives no arguments, and {action} names a counterparty or takes inputs",
    "check.utc-offset": "{text} is not a UTC offset: write a text such as \"+08:00\" or \"-05:30\", from -14:00 to +14:00",
    "check.charge-field": "{text} is not a line a charge has: rate, amount, applies to, included or added, per line, per document, according to a document, a rounding mode, or from DATE on with a rate",
    "check.charge-rate": "the charge {name} needs a rate (rate 5%) or an amount (amount HKD 20), and not both",
    "check.charge-included": "say whether {name} is included in the price or added to it: write included or added, once",
    "check.document": "{field} holds the lines of a bill: declare one such field, in the kind's block, as a list of money in one currency (invoice list HKD)",
    "check.charge-document": "the charge {name} is computed on a bill, but no field holds one: declare a field named by a document, such as invoice list HKD",
    "check.charge-twice": "{text}: the charge {name} already says this; say it once",
    "check.charge-on": "{name} cannot be computed on {other}: a charge is computed on the price and on charges written before it (one on each line only on charges on each line), and an included charge or a fixed amount only on the price",
    "check.charge-rounding": "{name} is a fixed amount, which is never rounded: give it no rounding mode",
    "check.charge-bill": "{name} is rounded once per {document}, but the contract's bill is another document",
    "check.needs-executor": "{action} asks an executor to act outside the ledger, which comes in step 6b: bo check accepts it, and bo build will refuse it until then",
    "check.request-kind": "{text} is not a request kind: write a name of lowercase Latin letters, digits, ., _, and -, starting with a letter (at most 64 bytes), or an action's word",
    "check.request-value": "{name}: a request carries numbers, money, quantities, rates, dates, durations, texts, yes or no, parties, and lists of them, not {type}",
    "check.request-within": "{text}: a request names its deadline, within a duration written out, from 1 day to 366 days (12 months)",
    "check.request-count": "{function} can make {count} requests in one call; a call makes at most 16",
    "check.answer-twice": "a second rule for {text}: one rule for each kind and outcome",
    "check.answer-unasked": "the contract makes no request {kind}, so this rule never applies",
    "check.answer-line": "{text}: an answer is never refused and cites no consent, so a rule for answers does no action, refuses nothing, and sets no party; it sets fields, changes the state with -> STATE (or if STATE -> STATE), and makes requests",
    "check.test-start": "a test begins by creating its instance: PARTY {action} with FIELD = VALUE, ...; the party that creates it is the home, whose ledger runs the contract",
    "check.test-again": "a test creates its instance once, in its first step",
    "check.test-creation": "{text}: an instance of this contract is created with {action} (issue for an asset, create otherwise)",
    "check.test-home": "an instance is created by its home, {party}: the role {party} names the ledger that runs the contract",
    "check.test-action": "{action} is not an action of this contract: a step does one of the actions it declares (can ...), or creates the instance",
    "check.test-party": "{text} is not a party: a step names one of the contract's parties, or a ledger that only tests name (bank1)",
    "check.test-to": "{action} has no counterparty, so a step that does it names none: drop to",
    "check.test-counterparty": "the counterparty of {action} is {party}, bound to a ledger when the instance is created: write to {party}",
    "check.test-signer": "{text}: a step is by AI agent (an agent signs it) or in person (a person proves presence), not both, and by names nobody else",
    "check.test-step": "{text}: besides to and with, a step takes at DATE, in person, and by AI agent, each once",
    "check.test-time": "{text}: at takes a date after 1970-01-01 (at 2027-01-06)",
    "check.test-time-back": "{text} is earlier than a step before it: time never goes back in a test",
    "check.test-value": "{text}: a test gives each value as written: a number, an amount, a quantity, a date, a duration, a rate, a text, or yes or no",
    "check.test-missing": "{action} needs {name}: give it with {name} = VALUE",
    "check.test-expect": "{text} is not an outcome a step can expect: write a state of the contract (-> signed), refused (-> refused, or with its reason in quotes), or the consent the call waits for (-> consent of bank); values of fields follow a comma (-> signed, fee = HKD 5)",
    "check.test-field": "{name} is no field an instance holds: a step expects the values of instance fields after its call (-> delivered, fee = HKD 4_000), and a constant never changes",
    "check.test-fields": "{text}: values of fields are expected only of a call that is accepted (-> delivered, fee = HKD 4_000, or -> fee = HKD 0), not of one refused, waiting for consents, or kept as a proposal",
    "check.test-expect-step": "an expectation (->) follows the step it is about, once",
    "check.test-reason": "{text}: only refused takes a reason",
    "check.test-proposal": "-> pending approval: only a call by AI agent to an action an AI agent may only propose (AI agent can propose) is kept as a proposal, and {action} is not such an action",
    "check.test-needs-to": "{action} takes its counterparty from each call: write to PARTY (supplier transfer to factor1)",
    "check.test-rule": "no when rule does {action}: a keeper step names the action a when rule does (keeper suspend)",
    "check.test-part": "{text}: a step names the instance it acts on by the party that holds it (issuer pay smith1): one party, in a contract whose instances have a holder",
    "check.parts-place": "{text}: an action issues parts once, in its own block (not under if or each), and a when rule never does",
    "check.parts-shape": "{text}: issue PARTS to RECIPIENTS [with FIELD = VALUE, ...]: the parts a list of amounts in the unit of the instance's amount, the recipients a list of parties, and with sets fields of the instance other than the amount and the holder",
    "check.parts-instance": "{action} issues parts, so each instance needs an amount (money or a quantity) and a holder, and no bill",
    "check.test-keeper": "{text}: the keeper calls a when rule with nothing else: no to, with, in person, or by AI agent",
    "check.test-answer": "{text}: a step answers a request the contract makes, as executor KIND done, fails, or expires, giving at most a result and a reason, both texts",
    "build.fragment": "this file has no contract line, so it is a fragment: only a contract (contract NAME) compiles",
    "build.standard-action": "{action} is a built-in action: its template comes with the standard library, in a later version of the compiler; for now, declare an action of your own (can NAME by PARTY)",
    "build.executor": "{action} asks an executor to act outside the ledger, which comes in step 6b: deployed code never changes, so it cannot be compiled before then",
    "build.time-rule": "{text}: this when rule cannot be compiled yet: a service is due at the end of each paid period, which its executors (step 6b) track",
    "build.unsupported": "{text} uses {feature}, which this version of the compiler does not compile yet",
    "build.name-taken": "two parts of the compiled contract would have the name {name} (functions, fields, parties, or inputs): rename one",
    "build.name-too-long": "{name} is too long for compiled code: at most {limit} bytes",
    "build.too-many-functions": "the contract has more actions than a compiled contract allows ({limit} functions)",
    "build.too-many-parties": "the contract has more parties and party fields than a compiled contract allows ({limit})",
    "build.too-many-fields": "the contract has more fields than a compiled contract allows ({limit})",
    "build.too-many-inputs": "{action} has more inputs than a compiled action allows ({limit})",
    "build.too-many-events": "{action} changes state more often than one call may report ({limit} events)",
    "build.too-many-charges": "the contract has more charges than a compiled contract may hold ({limit})",
    "build.too-large": "the compiled contract would be too large: an action's code, or the texts, names, and reasons it holds, exceed what a contract allows",
    "build.reject-text": "{text}: a refusal's text cannot start with bo:, which marks the compiler's own reasons",
    "build.late-party": "{field} starts with {party}, but an action binds {party} only later: give {field} a party bound at creation",
    "build.fuel": "{function} could use up to {bound} fuel in one call, more than the {limit} a call has: give its lists smaller bounds (at most N), or do less in one action",
    "build.output": "{function} could write up to {bound} bytes in one call, more than the {limit} compiled code has for its output: such a call is refused (bo:output). A part repeats its parent's fields, so an instance whose state is large cannot be split into many parts",
    "build.comments": "the source is deployed with its comments ({count} lines): every party, and anyone who verifies the contract, can read them",
    "run.input": "the call's input is not what a contract reads: deterministic CBOR within the limits",
    "run.overflow": "a value went beyond what Bo keeps: a whole number of its smallest unit, in 64 bits",
    "run.division-by-zero": "a division by zero",
    "run.date": "a date outside the years 1 to 9999",
    "run.output": "the result is too large: an instance's state holds at most 64 KiB, and a call's output 192 KiB",
    "run.consents": "the call would need the consents of more than 16 ledgers",
    "run.function": "the contract has no such function",
    "run.arguments": "the arguments are not the map of inputs the function takes",
    "run.argument": "the argument {name} is missing, or not of its type",
    "run.state": "{action} is not possible in the instance's current state",
    "run.requires": "requirement {number} of {action} is not met",
    "run.in-person": "{action} needs a person who proves presence (a passkey or a hardware key)",
    "run.party": "{party} is not bound to a ledger yet",
    "run.empty": "there is no {party} now",
    "run.pending": "the instance already keeps 16 proposals awaiting approval",
    "run.proposal": "no proposal awaiting approval has that function and those arguments",
    "run.approve": "{action} was proposed by an AI agent: a person who proves presence must approve it",
    "run.when": "{rule} does not apply yet: its time has not come, or its conditions do not hold",
    "run.fired": "{rule} has already applied for this time",
    "run.depth": "{action} creates parts, but this instance is a part at depth 8, the deepest the ledger allows",
    "run.parts": "{action} issues one part to each recipient: give as many parts as recipients, one at least",
    "run.request": "the request {kind} carries more than 4,096 bytes",
    "run.answer": "function result takes only the answers to the contract's requests",
    "fmt.unstable": "written in {language}, the source would read differently here: a name the contract gives, or a word, would read together with the words around it as another word of {language}; nothing was formatted: rename the name or reword the line, or format into another language",
    "fmt.internal": "laid out canonically, the source would read differently here, so nothing was formatted; this is a bug in the formatter: please report it",
    "bo.truncated": "more problems were found; only the first {limit} are shown"
  },

  "sentences": {
    "contract": "Contract {name}",
    "fragment": "A contract fragment (no contract line, so it cannot be deployed)",
    "intro": "Bo wrote this text from the contract's source (Bo edition {edition}). A clause marked with a rule, such as [R3], states what Bo inferred by that rule instead of reading it in the source; the last section explains each rule.",
    "packs-used": "Besides Bo's core words, the contract uses {packs}.",
    "vocab-pack": "the {pack} vocabulary pack (version {version})",
    "vocab-core": "core",
    "mark": " [{rules}]",
    "rule-line": "[{rule}] {text}",
    "section-parties": "Parties",
    "section-instance": "Each instance",
    "section-charges": "Charges",
    "section-states": "States",
    "section-actions": "Actions",
    "section-time": "Time rules",
    "section-rules": "Rules Bo applied",
    "section-answers": "Answers to requests",
    "party-creation": "{party}: bound to a ledger when an instance is created.",
    "party-action": "{party}: bound to a ledger by the first {action}, with the consent of {party.object}.",
    "party-each": "{party}: bound to a ledger by each {action}, with the consent of {party.object}.",
    "instance-kind": "Each instance is {kind.indefinite} named {name}.",
    "instance-none": "An instance holds no fields.",
    "field-default": "{field}: {type}; each instance starts with {value} unless its creation gives another.",
    "field-given": "{field}: {type}, given when an instance is created.",
    "field-party": "{field}: {type}; each instance starts with {party.object}, and actions may change it.",
    "field-constant": "{field}: {value}, the same for every instance.",
    "field-empty": "{field}: {type}; each instance starts with none, and actions set it.",
    "creation": "Creating an instance (function {function}) names the ledgers of the parties bound at creation and sets the fields given at creation. It needs no party's consent: the parties agree through the actions below.",
    "state-first": "An instance starts in the state {state}.",
    "states-all": "Its states are {states}.",
    "state-final": "The state {state} is final: no action can start from it, so an instance in it takes no more calls.",
    "states-no-final": "No state is final: some action can start from any state.",
    "events": "Each change of state, the first state included, is recorded as an event.",
    "actions-note": "A call that does not meet one of an action's requirements is refused, and the instance does not change. A missing consent is not a refusal: the call waits for it.",
    "action-function": "{action} (function {function})",
    "action-standard": "A built-in action of Bo: its standard terms (who starts it, who consents, the states it needs and changes) come with Bo's standard library in a later version, so this text states only the clauses the contract writes.",
    "action-terms": "A built-in action of Bo, with the standard terms of Bo's standard library (cexchain bo stdlib show {function}): the clauses marked R19 state them, after the contract's own clauses.",
    "action-terms-pack": "A built-in action of the {pack} vocabulary pack, with the standard terms the pack gives it (cexchain bo stdlib show {function}): the clauses marked R19 state them, after the contract's own clauses.",
    "action-home": "Started by the home ledger on its own word: no party's consent is needed.",
    "action-home-start": "Started by the home ledger on its own word.",
    "action-rule-only": "Only the contract's time rules do this action: no call starts it directly.",
    "action-by": "Started by {party.object}, whose agreement it needs.",
    "action-to": "Its counterparty is {party.object}.",
    "action-inputs": "The call gives {inputs}.",
    "input": "{input} ({type})",
    "consent-binds": "It needs the consent of {party.object}. The first such call names the ledger of {party.object} and binds {party.object} to it; later calls may leave it out or name the same ledger.",
    "consent-rebinds": "It needs the consent of {party.object}. Each such call names the ledger of {party.object} and binds {party.object} to it.",
    "consent-taken": "It needs the consent of whichever party is {field.object} before the call, since the action changes {field.object}.",
    "consent-call": "It needs the consent of {party.object}, whose ledger each call names (the argument {input}).",
    "consent-takes": "It needs the consent of {party.object} at every call, since the action makes {party.object} {field.object}.",
    "requirement": "Requirement {number}: {need}.",
    "requirement-if": "Requirement {number}: if {guard}, {need}.",
    "need-consent": "the consent of {party.object}",
    "need-in-person": "{party.subject} must prove presence in person, with a passkey or a hardware key",
    "starter": "the party that starts it",
    "if": "If {condition}:",
    "otherwise": "Otherwise:",
    "reject": "The call is refused, with the reason {message}.",
    "set": "It sets {field} to {value}.",
    "transition": "The instance becomes {state}.",
    "transition-from": "If the instance is {from}, it becomes {state}; otherwise the call is refused.",
    "transition-previous": "If the instance is {from}, it returns to the state it was in before it became {from}; otherwise the call is refused.",
    "each": "For each {item} in {list}:",
    "do": "It also does this: {action}.",
    "do-executor": "An executor must {action}, outside the ledger, and report the result.",
    "do-duty": "Duty: {party.subject} must {action}. It sets when an instance is due and overdue; nothing is called.",
    "do-rule": "It does {action}, under that action's clauses.",
    "do-parts": "Each of {parts.object} becomes an instance of this contract of its own, a part of this instance: its holder is the party in the same place in {recipients.object}, and its amount is the part. It has this instance's other fields as they are now, except those Bo adds (they start with none), and it starts in the state {state}. This instance then ends: it takes no more calls.",
    "parts-set": "On each part, {field} is set to {value}, computed on this instance.",
    "parts-depth": "A part may itself be split, down to depth 8, the deepest the ledger allows: on a part at depth 8 the call is refused (bo:depth {function}).",
    "parts-privacy": "Whoever holds or verifies a part sees the history of each instance it came from, up to the call that split it: the other parts of that call, their holders, and their amounts included.",
    "action-args": "{action} {args}",
    "action-to-party": "{action} to {party.object}",
    "action-by-party": "{action} by {party.object}",
    "action-with": "{action}, with {inputs}",
    "agents-delegation": "An AI agent may start it within its delegation.",
    "agents-propose": "An AI agent may only propose it: its call is kept as a proposal, which takes effect only when a person who proves presence approves it; every requirement is checked then.",
    "approve": "approve (function {function}): a person who proves presence approves a proposal an AI agent made, naming its function and arguments. The proposal then runs as its action does, started by that action's starter, with every requirement checked. An instance keeps at most 16 proposals.",
    "action-executor": "An executor carries it out outside the ledger and reports the result.",
    "due-field": "An instance is due on {field.object}.",
    "due-period": "An instance is due at the end of each paid period.",
    "when": "When {event}:",
    "when-date": "On {date}:",
    "when-keeper": "Function {function}: a keeper calls it once this time has come. An earlier call is refused; the rule applies once for each such time, and its event records how late the call came.",
    "utc-offset": "Dates and days are counted at UTC{offset} all year, with no daylight saving; a month after a day the next month lacks (31 January plus a month) ends on that month's last day.",
    "request": "It asks an executor for {kind}, outside the ledger, to be answered within {duration} of the call (its deadline).",
    "request-to": "It asks an executor for {kind} for {party.object}, outside the ledger, to be answered within {duration} of the call (its deadline).",
    "request-values": "The request carries {values}.",
    "request-failure": "If it fails, or expires, the rule for a failed {kind} applies (see the answers to requests).",
    "request-failure-expiry": "If it fails, the rule for a failed {kind} applies; if it expires, the rule for an expired one (see the answers to requests).",
    "request-expiry-only": "If it expires, the rule for an expired {kind} applies (see the answers to requests); if it fails, nothing more happens: the answer is recorded as an event.",
    "request-no-failure": "If it fails or expires, nothing more happens: the answer is recorded as an event.",
    "answers-note": "The function {function} takes every answer to the contract's requests: an executor's, a person's by hand, or a keeper's once a deadline has passed (expired). It records the answer as an event and applies the rule below for it, if there is one. An answer is never refused, so these rules ask no consent and refuse nothing; on an instance that has ended, they change no state and make no requests.",
    "answer-done": "When a request {kind} is done:",
    "answer-fails": "When a request {kind} fails:",
    "answer-fails-expired": "When a request {kind} fails, or expires:",
    "answer-expires": "When a request {kind} expires (no answer by its deadline):",
    "charge": "The {kind} {name}:",
    "charge-rate": "Its rate is {rate}.",
    "charge-amount": "Its amount is {value}.",
    "charge-applies": "It applies when {condition}.",
