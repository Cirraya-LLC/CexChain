# Bo vocabulary pack: finance, version 1 (official), carried.
#
# The first released version: the compiler's tables then, as canonical
# CBOR. It has no "languages": version 3 of the official language packs
# (bo/packs/history/*-3.pack) and version 2 spell its words. Released
# versions never change; deploys that name this one rebuild with it.

{
  "format": 1,
  "id": "finance",
  "version": 1,
  "edition": 1,
  "concepts": {
    "kind.asset": {"category": "kind"},
    "act.pledge": {"category": "action"},
    "act.release": {"category": "action"},
    "act.enforce": {"category": "action"},
    "act.redeem": {"category": "action"},
    "act.split": {"category": "action"},
    "act.pay": {"category": "action"},
    "act.confirm_payment": {"category": "action"},
    "act.dispute": {"category": "action"},
    "act.freeze": {"category": "action"},
    "act.unfreeze": {"category": "action"},
    "field.tier": {"category": "field", "type": "number"},
    "field.pledgee": {"category": "field", "type": "party", "added": true, "taking": true},
    "field.payee": {"category": "field", "type": "party", "added": true, "taking": true},
    "field.portion": {"category": "field", "type": "portion"},
    "state.pledged": {"category": "state"},
    "state.paid": {"category": "state"},
    "state.settled": {"category": "state"},
    "state.frozen": {"category": "state"},
    "state.disputed": {"category": "state"},
    "state.redeemed": {"category": "state"},
    "role.supplier": {"category": "role"},
    "role.bank": {"category": "role"},
    "role.issuer": {"category": "role"}
  },
  # bo/stdlib/finance.bo as that version compiled it in.
  "terms": "bo 1\nuse finance\n# The standard terms of the finance pack's built-in actions (D-054): pledges,\n# payments, freezes, and splits, with the semantics CexChain's native assets\n# had before they became Bo contracts. A contract that uses the pack\n# (`use finance`) and writes `can pledge to bank` gets the pledge below, with\n# the bank as its counterparty; its own lines under `can pledge` add to it\n# and are checked first. `cexchain bo stdlib show pledge` prints it.\n#\n# The fields these terms use: holder (a party), quantity (redeem), amount and\n# tier (split), and pledgee and payee, which Bo adds to each instance, holding\n# no party until an action sets them (R20).\n\n# The holder pledges the asset to the counterparty, which becomes its pledgee.\n# Both consent to every pledge. Only an active asset can be pledged: no second\n# pledge.\ncan pledge to counterparty by holder\n  requires not counterparty = holder\n  active -> pledged\n  pledgee = counterparty\n\n# The pledgee gives its pledge up.\ncan release by pledgee\n  pledged -> active\n  pledgee = none\n\n# The pledgee takes the asset: it becomes the holder. The holder agreed to\n# this when it pledged the asset, so only the pledgee consents.\ncan enforce by pledgee\n  pledged -> active\n  holder = pledgee\n  pledgee = none\n\n# The holder takes goods out (a warehouse receipt); the pledgee consents while\n# the receipt is pledged. When nothing remains, it is redeemed.\ncan redeem by holder with portion quantity\n  requires active or pledged\n  if pledged requires consent of pledgee\n  requires portion > 0\n  requires portion <= quantity\n  quantity = quantity - portion\n  if quantity = 0\n    pledgee = none\n    -> redeemed\n\n# The debtor says it paid (a receivable), on the home's own word: the payee is\n# the pledgee if there is one, else the holder, and stays the same when the\n# debtor pays again after a dispute.\ncan pay\n  active, pledged, disputed -> paid\n  if payee = none\n    if pledgee = none\n      payee = holder\n    otherwise\n      payee = pledgee\n\n# The payee confirms it was paid.\ncan confirm payment by payee\n  paid, disputed -> settled\n\n# The payee says it was not paid.\ncan dispute by payee\n  paid -> disputed\n\n# The home freezes the asset on its own word, such as under a court order.\ncan freeze\n  active, pledged, paid, disputed -> frozen\n\n# The home unfreezes it: it returns to the state it was frozen in.\ncan unfreeze\n  frozen -> previous state\n\n# The holder splits the asset into parts, one for each recipient, so that its\n# own suppliers can hold, pledge, and be paid each part (multi-tier transfer).\n# The parts add up to the amount, each at least the currency's smallest unit;\n# the holder may keep a part. The holder and every recipient consent: at most\n# 15 recipients besides the holder, as a call cites at most 16 consents. Each\n# part becomes an instance of its own, held by its recipient, one tier down\n# (R30); the asset ends, divided. Only an active asset splits, so not while\n# pledged; a part at depth 8 splits no further.\ncan split by holder with parts, recipients\n  requires count of recipients = count of parts\n  requires count of recipients <= 15 or holder in recipients\n  each part in parts\n    requires part > 0\n  requires sum of parts = amount\n  requires consent of recipients\n  active -> divided\n  issue parts to recipients with tier = tier + 1\n"
}
